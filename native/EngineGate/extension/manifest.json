{
  "manifest_version": 3,
  "name": "Orbit Engine Gate Synthetic MV3",
  "version": "1.0.0",
  "description": "Loopback-only, noninteractive CEF extension API gate.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["protocol.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
