@@ -0,0 +1,74 @@
+// Product toolbar services; included once by orbit_cef_api.mm.
+#include "chrome/browser/extensions/commands/command_service.h"
+#include "chrome/browser/extensions/extension_keybinding_registry.h"
+#include "chrome/browser/tab_list/tab_list_interface.h"
+#include "extensions/common/command.h"
+#include "ui/events/event_constants.h"
+
+namespace {
+class OrbitCommandDispatcher final : public extensions::ExtensionKeybindingRegistry {
+ public:
+  explicit OrbitCommandDispatcher(Browser* browser)
+      : ExtensionKeybindingRegistry(browser->GetProfile(), TabListInterface::From(browser), ALL_EXTENSIONS) {}
+  void Dispatch(const std::string& id, const std::string& name, const ui::Accelerator& accelerator) {
+    CommandExecuted(id, name, accelerator);
+  }
+ private:
+  bool PopulateCommands(const extensions::Extension*, ui::CommandMap*) override { return false; }
+  bool RegisterAccelerator(const ui::Accelerator&, const extensions::ExtensionId&,
+                           const std::string&) override { return false; }
+};
+}  // namespace
+
+extern "C" CEF_EXPORT int32_t orbit_cef_extension_set_pinned(const char* path, const char* id, int32_t pinned) {
+  Profile* profile = ExtensionProfile(path);
+  if (!profile || !id || (pinned != 0 && pinned != 1)) return 0;
+  auto* toolbar = ToolbarActionsModel::Get(profile);
+  if (!toolbar || !toolbar->HasAction(id) || toolbar->IsActionForcePinned(id)) return 0;
+  toolbar->SetActionVisibility(id, pinned == 1);
+  return toolbar->IsActionPinned(id) == (pinned == 1) ? 1 : 0;
+}
+
+// 1: named command dispatched through Chrome's registry; 2: native action ID
+// returned to the bridge, which owns the shell anchor and invocation lifetime.
+extern "C" CEF_EXPORT int32_t orbit_cef_extension_shortcut(int32_t browser_id,
+    int32_t key_code, uint32_t flags, char* action_id, uint32_t capacity) {
+  if (!OnValidUIThread() || !action_id || capacity < 33) return 0;
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->browser() || !host->GetWebContents()) return 0;
+  Browser* browser = host->browser();
+  Profile* profile = browser->GetProfile();
+  if (profile->IsOffTheRecord() || browser->tab_strip_model()->GetActiveWebContents() != host->GetWebContents()) return 0;
+  auto* commands = extensions::CommandService::Get(profile);
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* actions = extensions::ExtensionActionManager::Get(profile);
+  if (!commands || !registry || !actions) return 0;
+  int modifiers = 0;
+  if (flags & EVENTFLAG_SHIFT_DOWN) modifiers |= ui::EF_SHIFT_DOWN;
+  if (flags & EVENTFLAG_CONTROL_DOWN) modifiers |= ui::EF_CONTROL_DOWN;
+  if (flags & EVENTFLAG_ALT_DOWN) modifiers |= ui::EF_ALT_DOWN;
+  if (flags & EVENTFLAG_COMMAND_DOWN) modifiers |= ui::EF_COMMAND_DOWN;
+  if (!modifiers) return 0;
+  const ui::Accelerator accelerator(static_cast<ui::KeyboardCode>(key_code), modifiers);
+  for (const auto& extension : registry->enabled_extensions()) {
+    auto* action = actions->GetExtensionAction(*extension);
+    extensions::Command command;
+    if (action && commands->GetExtensionActionCommand(extension->id(), action->action_type(),
+          extensions::CommandService::ACTIVE, &command, nullptr) && command.accelerator() == accelerator) {
+      std::memcpy(action_id, extension->id().c_str(), 33);
+      return 2;
+    }
+    ui::CommandMap named;
+    if (!commands->GetNamedCommands(extension->id(), extensions::CommandService::ACTIVE,
+          extensions::CommandService::REGULAR, &named)) continue;
+    for (const auto& [name, entry] : named) {
+      if (entry.accelerator() != accelerator) continue;
+      // Retain the extension until synchronous callbacks have finished.
+      scoped_refptr<const extensions::Extension> retained = extension;
+      OrbitCommandDispatcher dispatcher(browser);
+      dispatcher.Dispatch(retained->id(), name, accelerator);
+      return 1;
+    }
+  }
+  return 0;
+}
