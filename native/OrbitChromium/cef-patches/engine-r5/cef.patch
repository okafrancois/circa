+
+NSWindow* OrbitNSWindow(uint64_t window_token) {
+  const gfx::NativeWindow window = GetNativeWindow(window_token);
+  return window ? window.GetNativeNSWindow() : nil;
+}
+
+// Keep the AppKit parent alive until every dialog observer has been notified.
+// The registry can lose its window before the logical Browser's final tab
+// closes.
+class OrbitNativeModalDialogHost final : public OrbitModalDialogHost {
+ public:
+  explicit OrbitNativeModalDialogHost(NSWindow* window)
+      : OrbitModalDialogHost(base::BindRepeating(
+            [](NSWindow* window,
+               std::shared_ptr<remote_cocoa::ScopedAppKitModalParent>) {
+              NSView* view = [window contentView];
+              const NSSize size = [view bounds].size;
+              return Geometry{gfx::NativeView(view),
+                              gfx::Size(size.width, size.height),
+                              static_cast<bool>([window isVisible] &&
+                                                [window isKeyWindow])};
+            },
+            window,
+            std::make_shared<remote_cocoa::ScopedAppKitModalParent>(
+                gfx::NativeWindow(window)))) {
+    CHECK(window);
+    // Delivery is synchronous on AppKit's UI thread. Remove the block before
+    // destruction so it cannot access a destroyed C++ host.
+    for (NSNotificationName name in
+         @[ NSWindowDidResizeNotification, NSWindowDidMoveNotification ]) {
+      bounds_observers_.push_back([[NSNotificationCenter defaultCenter]
+          addObserverForName:name
+                      object:window
+                       queue:nil
+                  usingBlock:^(NSNotification*) {
+                    NotifyPositionRequiresUpdate();
+                  }]);
+    }
+  }
+  ~OrbitNativeModalDialogHost() override {
+    for (id observer : bounds_observers_) {
+      [[NSNotificationCenter defaultCenter] removeObserver:observer];
+    }
+  }
+
+ private:
+  std::vector<id> bounds_observers_;
+};
+
+}  // namespace
