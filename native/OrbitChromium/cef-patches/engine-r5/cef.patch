+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+// Included inside orbit_cef_api.mm before its anonymous namespace.
+#include <cstring>
+#include "base/base64.h"
+#include "chrome/browser/ui/toolbar/toolbar_actions_model.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_icon_factory.h"
+#include "extensions/browser/extension_icon_image.h"
+#include "extensions/common/manifest_handlers/icons_handler.h"
+#include "ui/gfx/image/image.h"
+#include <limits>
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+#include "base/no_destructor.h"
+#include "base/json/json_writer.h"
+#include "base/callback_list.h"
+#include "base/functional/bind.h"
+#include "base/values.h"
+#include "base/scoped_observation.h"
+#include "chrome/browser/profiles/profile.h"
+#include "extensions/browser/disable_reason.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registrar.h"
+#include "extensions/browser/extension_prefs.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extension_registry_observer.h"
+#include "extensions/common/extension.h"
+
+namespace {
+bool OnValidUIThread();
+CefRefPtr<ChromeBrowserHostImpl> GetChromeHost(int32_t browser_id);
+Profile* ExtensionProfile(const char* path) {
+  if (!OnValidUIThread() || !path || path[0] != '/' || !g_browser_process ||
+      !g_browser_process->profile_manager()) return nullptr;
+  Profile* profile = g_browser_process->profile_manager()->GetProfileByPath(base::FilePath(path));
+  return profile && !profile->IsOffTheRecord() ? profile : nullptr;
+}
+
+std::string ExtensionIconPNG(Profile* profile, const extensions::Extension& extension,
+                             extensions::ExtensionAction* action);
+
+base::DictValue ActionValues(Profile* profile, const extensions::Extension& extension,
+                             extensions::ExtensionAction* action, int tab_id);
+int32_t ExtensionSnapshot(Profile* profile, int tab_id, bool per_tab, char* output, uint32_t capacity) {
+  if (!profile) return -1;
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* actions = extensions::ExtensionActionManager::Get(profile);
+  if (!registry || !actions) return -1;
+  base::ListValue rows;
+  for (const auto& extension : registry->GenerateInstalledExtensionsSet()) {
+    // Component extensions are not user-managed products.
+    if (extensions::Manifest::IsComponentLocation(extension->location())) continue;
+    base::DictValue row;
+    row.Set("id", extension->id());
+    row.Set("name", extension->name());
+    row.Set("version", extension->version().GetString());
+    row.Set("isEnabled", registry->enabled_extensions().Contains(extension->id()));
+    auto* action = actions->GetExtensionAction(*extension);
+    row.Set("hasAction", action != nullptr);
+    auto* toolbar = ToolbarActionsModel::Get(profile);
+    row.Set("isPinned", toolbar && toolbar->IsActionPinned(extension->id()));
+    if (action) {
+      row.Set("iconPNGBase64", ExtensionIconPNG(profile, *extension, action));
+      if (per_tab) {
+        row.Set("defaultActionState", ActionValues(profile, *extension, action, extensions::ExtensionAction::kDefaultTabId));
+        row.Set("actionState", ActionValues(profile, *extension, action, tab_id));
+      }
+    }
+    rows.Append(std::move(row));
+  }
+  const auto json = base::WriteJson(rows);
+  if (!json || json->size() > static_cast<size_t>(std::numeric_limits<int32_t>::max())) return -1;
+  if (output && capacity > json->size()) std::memcpy(output, json->c_str(), json->size() + 1);
+  return static_cast<int32_t>(json->size());
+}
+
+int32_t ExtensionsSnapshot(const char* path, char* output, uint32_t capacity) {
+  return ExtensionSnapshot(ExtensionProfile(path), 0, false, output, capacity);
+}
+int32_t ExtensionActionSnapshot(int32_t browser_id, char* output, uint32_t capacity) {
+  if (!OnValidUIThread()) return -1;
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->GetWebContents() || !host->browser()) return -1;
+  auto* profile = host->browser()->GetProfile();
+  if (!profile || profile->IsOffTheRecord()) return -1;
+  return ExtensionSnapshot(profile, extensions::ExtensionTabUtil::GetTabId(host->GetWebContents()), true, output, capacity);
+}
+
+int32_t ExtensionSetEnabled(const char* path, const char* id, int32_t enabled) {
+  Profile* profile = ExtensionProfile(path);
+  if (!profile || !id || (enabled != 0 && enabled != 1)) return 0;
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* registrar = extensions::ExtensionRegistrar::Get(profile);
+  const auto* extension = registry ? registry->GetInstalledExtension(id) : nullptr;
+  if (!extension || !registrar || extensions::Manifest::IsComponentLocation(extension->location())) return 0;
+  // Never grant additional permissions or clear security/policy disable reasons here.
+  if (enabled) {
+    if (registry->enabled_extensions().Contains(id)) return 1;
+    auto* prefs = extensions::ExtensionPrefs::Get(profile);
+    if (!prefs || !prefs->HasOnlyDisableReason(id, extensions::disable_reason::DISABLE_USER_ACTION)) return 0;
+    registrar->EnableExtension(id);
+  }
+  else registrar->DisableExtension(id, {extensions::disable_reason::DISABLE_USER_ACTION});
+  return registry->enabled_extensions().Contains(id) == (enabled == 1) ? 1 : 0;
+}
+
+int32_t ExtensionRemove(const char* path, const char* id) {
+  Profile* profile = ExtensionProfile(path);
+  if (!profile || !id) return 0;
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* registrar = extensions::ExtensionRegistrar::Get(profile);
+  const auto* extension = registry ? registry->GetInstalledExtension(id) : nullptr;
+  if (!extension || !registrar || extensions::Manifest::IsComponentLocation(extension->location())) return 0;
+  std::u16string error;
+  return registrar->UninstallExtension(id, extensions::UNINSTALL_REASON_USER_INITIATED, &error) ? 1 : 0;
+}
+
+class OrbitExtensionObservation final : public extensions::ExtensionRegistryObserver,
+                                       public ToolbarActionsModel::Observer,
+                                       public extensions::IconImage::Observer,
+                                       public extensions::ExtensionActionIconFactory::Observer,
+                                       public std::enable_shared_from_this<OrbitExtensionObservation> {
+ public:
+  OrbitExtensionObservation(Profile* profile, extensions::ExtensionRegistry* registry,
+                          void (*changed)(void*), void* context)
+       : changed_(changed), context_(context) {
+    observation_.Observe(registry);
+    if (auto* toolbar = ToolbarActionsModel::Get(profile)) toolbar_observation_.Observe(toolbar);
+  }
+  std::string Icon(Profile* profile, const extensions::Extension& extension) {
+    // Inventory is profile-scoped, so use the extension's native manifest icon.
+    // IconImage owns sandboxed decoding and notifies when its lazy reps arrive.
+    auto& icon = icons_[extension.id()];
+    if (!icon) icon = std::make_unique<extensions::IconImage>(
+        profile, &extension, extensions::IconsInfo::GetIcons(&extension),
+        16, gfx::ImageSkia(), this);
+    auto image = icon->image();
+    if (image.IsEmpty()) return {};
+    // PNG conversion caches its representation. Use fresh storage so a lazy
+    // IconImage update cannot leave the initial placeholder PNG cached.
+    gfx::Image png_image(image.AsImageSkia());
+    const auto png = png_image.As1xPNGBytes();
+    return png ? base::Base64Encode(base::span(*png)) : std::string();
+  }
+  gfx::Image ActionIcon(const extensions::Extension& extension, extensions::ExtensionAction* action, int tab_id) {
+    auto& factory = action_icons_[extension.id()];
+    if (!factory) factory = std::make_unique<extensions::ExtensionActionIconFactory>(&extension, action, this);
+    return factory->GetIcon(tab_id);
+  }
+  void OnIconUpdated() override { Notify(); }
+  void OnExtensionIconImageChanged(extensions::IconImage*) override { Notify(); }
+  void OnToolbarActionAdded(const std::string&) override { Notify(); }
+  void OnToolbarActionRemoved(const std::string& id) override { action_icons_.erase(id); icons_.erase(id); Notify(); }
+  void OnToolbarActionUpdated(const std::string&) override { Notify(); }
+  void OnToolbarModelInitialized() override { Notify(); }
+  void OnToolbarPinnedActionsChanged() override { Notify(); }
+  void OnToolbarActionsModelShutdown() override { toolbar_observation_.Reset(); action_icons_.clear(); icons_.clear(); }
+  void OnExtensionLoaded(content::BrowserContext*, const extensions::Extension*) override { Notify(); }
+  void OnExtensionReady(content::BrowserContext*, const extensions::Extension*) override { Notify(); }
+  void OnExtensionUnloaded(content::BrowserContext*, const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason) override { action_icons_.erase(extension->id()); icons_.erase(extension->id()); Notify(); }
+  void OnExtensionInstalled(content::BrowserContext*, const extensions::Extension*, bool) override { Notify(); }
+  void OnExtensionUninstalled(content::BrowserContext*, const extensions::Extension*,
+                              extensions::UninstallReason) override { Notify(); }
+  void OnShutdown(extensions::ExtensionRegistry*) override {
+    changed_ = nullptr;
+    toolbar_observation_.Reset();
+    action_icons_.clear(); icons_.clear();
+    observation_.Reset();
+  }
+ private:
+  void Notify() {
+    // A synchronous observer may unregister/remove its profile or shut down.
+    auto keep_alive = shared_from_this();
+    const auto callback = changed_;
+    void* context = context_;
+    if (callback) callback(context);
+  }
+  std::map<std::string, std::unique_ptr<extensions::ExtensionActionIconFactory>> action_icons_;
+  std::map<std::string, std::unique_ptr<extensions::IconImage>> icons_;
+  base::ScopedObservation<ToolbarActionsModel, ToolbarActionsModel::Observer> toolbar_observation_{this};
+  void (*changed_)(void*);
+  void* context_;
+  base::ScopedObservation<extensions::ExtensionRegistry, extensions::ExtensionRegistryObserver> observation_{this};
+};
+
+using ExtensionObservationMap =
+    std::map<std::string, std::shared_ptr<OrbitExtensionObservation>>;
+ExtensionObservationMap& GetExtensionObservations() {
+  static base::NoDestructor<ExtensionObservationMap> observations;
+  return *observations;
+}
+std::string ExtensionIconPNG(Profile* profile, const extensions::Extension& extension,
+                             extensions::ExtensionAction* action) {
+  const auto found = GetExtensionObservations().find(profile->GetPath().value());
+  if (found == GetExtensionObservations().end()) return {};
+  auto observer = found->second;
+  return observer->Icon(profile, extension);
+}
+base::DictValue ActionValues(Profile* profile, const extensions::Extension& extension,
+                             extensions::ExtensionAction* action, int tab_id) {
+  base::DictValue row;
+  row.Set("title", action->GetTitle(tab_id));
+  row.Set("badgeText", action->GetExplicitlySetBadgeText(tab_id));
+  row.Set("badgeBackgroundColor", static_cast<double>(action->GetBadgeBackgroundColor(tab_id)));
+  row.Set("isEnabled", action->GetIsVisible(tab_id));
+  const auto found = GetExtensionObservations().find(profile->GetPath().value());
+  if (found != GetExtensionObservations().end()) {
+    auto observer = found->second;
+    const auto image = observer->ActionIcon(extension, action, tab_id);
+    if (!image.IsEmpty()) {
+      gfx::Image png_image(image.AsImageSkia());
+      const auto png = png_image.As1xPNGBytes();
+      if (png) row.Set("iconPNGBase64", base::Base64Encode(base::span(*png)));
+    }
+  }
+  return row;
+}
+int32_t ExtensionsObserve(const char* path, void (*changed)(void*), void* context) {
+  if (!OnValidUIThread() || !path) return 0;
+  GetExtensionObservations().erase(path);
+  if (!changed) return 1;
+  Profile* profile = ExtensionProfile(path);
+  auto* registry = profile ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  if (!registry) return 0;
+  GetExtensionObservations()[path] = std::make_shared<OrbitExtensionObservation>(profile, registry, changed, context);
+  return 1;
+}
+}  // namespace
+
+#include "chrome/browser/extensions/extension_action_runner.h"
+#include "chrome/browser/extensions/extension_view_host_factory.h"
+#include "chrome/browser/extensions/extension_view_host.h"
+#include "chrome/browser/ui/views/extensions/extension_popup.h"
+#include "extensions/browser/extension_action.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+
+#include "cef/libcef/browser/orbit/orbit_extension_lease.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace {
+struct ExtensionSelection {
+  int32_t browser;
+  uint64_t surface, profile, epoch;
+};
+using ExtensionSelectionMap = std::map<uint64_t, ExtensionSelection>;
+ExtensionSelectionMap& GetExtensionSelections() {
+  static base::NoDestructor<ExtensionSelectionMap> selections;
+  return *selections;
+}
+class OrbitNativePopupLease;
+using ExtensionInvocationMap =
+    std::map<uint64_t, std::weak_ptr<OrbitNativePopupLease>>;
+ExtensionInvocationMap& GetExtensionInvocations() {
+  static base::NoDestructor<ExtensionInvocationMap> invocations;
+  return *invocations;
+}
+
+// No retained embedder callbacks or opaque Swift pointers. The popup owns this
+// native context; every engine object is observed and nulled before cancellation.
+class OrbitNativePopupLease final : public ExtensionPopup::NativeInvocation,
+                                  public content::WebContentsObserver,
+                                  public TabStripModelObserver,
+                                  public extensions::ExtensionRegistryObserver,
+                                  public std::enable_shared_from_this<OrbitNativePopupLease> {
+ public:
+  uint64_t window() const { return lease_.identity().window; }
+  OrbitNativePopupLease(orbit_extensions::InvocationIdentity identity, Browser* browser,
+                      content::WebContents* contents, NSView* anchor, const char* extension_id)
+      : content::WebContentsObserver(contents), lease_(identity), browser_(browser),
+        model_(browser->tab_strip_model()), profile_(browser->GetProfile()), anchor_(anchor), extension_id_(extension_id) {
+    model_->AddObserver(this);
+    registry_.Observe(extensions::ExtensionRegistry::Get(profile_));
+  }
+  ~OrbitNativePopupLease() override { Detach(); }
+  void ObserveBrowserClose() {
+    browser_close_ = browser_->RegisterBrowserDidClose(base::BindRepeating(
+        [](std::weak_ptr<OrbitNativePopupLease> weak, BrowserWindowInterface*) {
+          if (auto lease = weak.lock()) lease->Cancel();
+        }, weak_from_this()));
+  }
+  bool IsValid() override {
+    if (!browser_ || !model_ || !profile_ || !web_contents()) return false;
+    const auto& id = lease_.identity();
+    const auto generation = orbit::GetWindowGeneration(id.window);
+    const auto selection = GetExtensionSelections().find(id.window);
+    if (!generation || selection == GetExtensionSelections().end()) return false;
+    const auto& current = selection->second;
+    auto host = GetChromeHost(id.browser);
+    if (!host || host->browser() != browser_ || host->GetWebContents() != web_contents()) return false;
+    orbit_extensions::InvocationIdentity live{id.window, *generation, current.surface,
+        current.profile, current.epoch, current.browser,
+        reinterpret_cast<uintptr_t>(host->GetWebContents())};
+    if (!lease_.Authorizes(live) || browser_->IsDeleteScheduled() || browser_->GetProfile() != profile_ ||
+        model_->GetActiveWebContents() != web_contents()) return false;
+    NSView* anchor = anchor_.GetNativeNSView();
+    NSWindow* window = orbit::GetNativeWindow(id.window).GetNativeNSWindow();
+    NSView* source = web_contents()->GetNativeView().GetNativeNSView();
+    return anchor && window && window.isVisible && anchor.window == window &&
+        !anchor.isHiddenOrHasHiddenAncestor && !NSIsEmptyRect(anchor.visibleRect) &&
+        source && source.window == window && !source.isHiddenOrHasHiddenAncestor;
+  }
+  void SetCancellation(base::RepeatingClosure callback) override {
+    cancellation_ = std::move(callback);
+    if (!IsValid()) {
+      auto notification = std::move(cancellation_);
+      Cancel();
+      if (notification) notification.Run();
+    }
+  }
+  void Cancel() override {
+    auto keep_alive = shared_from_this();
+    if (!lease_.Revoke()) return;
+    // No Browser, Profile, source contents or model access is possible from a
+    // later callback, even if destroying a widget is deferred by AppKit.
+    Detach();
+    auto callback = std::move(cancellation_);
+    if (callback) callback.Run();
+  }
+  void WebContentsDestroyed() override { Cancel(); }
+  void OnTabStripModelChanged(TabStripModel*, const TabStripModelChange&,
+                              const TabStripSelectionChange&) override { Cancel(); }
+  void OnTabStripModelDestroyed(TabStripModel*) override {
+    model_ = nullptr;
+    browser_ = nullptr;
+    Cancel();
+  }
+  void OnShutdown(extensions::ExtensionRegistry*) override { registry_.Reset(); Cancel(); }
+  void OnExtensionUnloaded(content::BrowserContext*, const extensions::Extension* extension,
+                           extensions::UnloadedExtensionReason) override {
+    if (extension->id() == extension_id_) Cancel();
+  }
+  void OnExtensionUninstalled(content::BrowserContext*, const extensions::Extension* extension,
+                              extensions::UninstallReason) override {
+    if (extension->id() == extension_id_) Cancel();
+  }
+ private:
+  void Detach() {
+    browser_close_ = {};
+    browser_ = nullptr;
+    profile_ = nullptr;
+    if (model_) { model_->RemoveObserver(this); model_ = nullptr; }
+    Observe(nullptr);
+    registry_.Reset();
+  }
+  orbit_extensions::InvocationLease lease_;
+  raw_ptr<Browser> browser_;
+  raw_ptr<TabStripModel> model_;
+  raw_ptr<Profile> profile_;
+  gfx::NativeView anchor_;
+  const std::string extension_id_;
+  base::RepeatingClosure cancellation_;
+  base::CallbackListSubscription browser_close_;
+  base::ScopedObservation<extensions::ExtensionRegistry, extensions::ExtensionRegistryObserver> registry_{this};
+};
+
+void ExtensionCancel(uint64_t invocation) {
+  if (!OnValidUIThread()) return;
+  auto found = GetExtensionInvocations().find(invocation);
+  if (found == GetExtensionInvocations().end()) return;
+  auto lease = found->second.lock();
+  GetExtensionInvocations().erase(found);
+  if (lease) lease->Cancel();
+}
+int32_t ExtensionSelectionChanged(uint64_t window, int32_t browser, uint64_t surface,
+                                 uint64_t profile, uint64_t epoch) {
+  if (!OnValidUIThread()) return 0;
+  auto existing = GetExtensionSelections().find(window);
+  if (existing != GetExtensionSelections().end() && existing->second.epoch >= epoch) return 0;
+  GetExtensionSelections()[window] = {-1, 0, 0, epoch}; // Revoke before cancellation.
+  std::vector<std::shared_ptr<OrbitNativePopupLease>> cancelled;
+  for (auto it = GetExtensionInvocations().begin(); it != GetExtensionInvocations().end();) {
+    auto lease = it->second.lock();
+    if (!lease || lease->window() == window) {
+      if (lease) cancelled.push_back(std::move(lease));
+      it = GetExtensionInvocations().erase(it);
+    } else { ++it; }
+  }
+  for (auto& lease : cancelled) lease->Cancel();
+  const auto final = GetExtensionSelections().find(window);
+  if (final != GetExtensionSelections().end() && final->second.epoch == epoch) {
+    if (browser >= 0 && surface && profile && epoch && orbit::IsKnownWindow(window))
+      final->second = {browser, surface, profile, epoch};
+    else GetExtensionSelections().erase(final);
+  }
+  return 1;
+}
+int32_t ExtensionAction(int32_t browser_id, const char* id, void* anchor_nsview,
+                        uint64_t invocation, uint64_t surface, uint64_t profile, uint64_t epoch) {
+  if (!OnValidUIThread() || !id || !anchor_nsview || !invocation) return 0;
+  auto* delegate = CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id);
+  auto host = GetChromeHost(browser_id);
+  if (!delegate || !host || !host->browser() || !host->GetWebContents()) return 0;
+  Browser* browser = host->browser();
+  auto* contents = host->GetWebContents();
+  if (browser->GetProfile()->IsOffTheRecord() ||
+      browser->tab_strip_model()->GetActiveWebContents() != contents) return 0;
+  NSView* anchor = (__bridge NSView*)anchor_nsview;
+  if (![anchor isKindOfClass:[NSView class]]) return 0;
+  const uint64_t window = delegate->window_token();
+  const auto generation = orbit::GetWindowGeneration(window);
+  if (!generation) return 0;
+  auto lease = std::make_shared<OrbitNativePopupLease>(
+      orbit_extensions::InvocationIdentity{window, *generation, surface, profile, epoch,
+                                         browser_id, reinterpret_cast<uintptr_t>(contents)},
+      browser, contents, anchor, id);
+  lease->ObserveBrowserClose();
+  if (!lease->IsValid()) return 0;
+  GetExtensionInvocations()[invocation] = lease;
+  auto* registry = extensions::ExtensionRegistry::Get(browser->GetProfile());
+  auto* manager = extensions::ExtensionActionManager::Get(browser->GetProfile());
+  scoped_refptr<const extensions::Extension> extension = registry ? registry->enabled_extensions().GetByID(id) : nullptr;
+  auto* action = extension && manager ? manager->GetExtensionAction(*extension) : nullptr;
+  auto* runner = extensions::ExtensionActionRunner::GetForWebContents(contents);
+  const int tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  if (!action || !runner || !action->GetIsVisible(tab_id)) { ExtensionCancel(invocation); return 0; }
+  const auto result = runner->RunAction(extension.get(), /*grant_tab_permissions=*/true);
+  if (!lease->IsValid()) { ExtensionCancel(invocation); return 0; }
+  if (result != extensions::ExtensionAction::ShowAction::kShowPopup) {
+    ExtensionCancel(invocation);
+    return result == extensions::ExtensionAction::ShowAction::kToggleSidePanel ? -2 : 1;
+  }
+  if (registry->enabled_extensions().GetByID(id) != extension.get()) { ExtensionCancel(invocation); return 0; }
+  action = manager->GetExtensionAction(*extension);
+  if (!action || !action->HasPopup(tab_id)) { ExtensionCancel(invocation); return 0; }
+  auto popup = extensions::ExtensionViewHostFactory::CreatePopupHost(*extension, action->GetPopupUrl(tab_id), browser);
+  if (!popup || !lease->IsValid()) { ExtensionCancel(invocation); return 0; }
+  const NSRect screen_rect = [anchor.window convertRectToScreen:[anchor convertRect:anchor.bounds toView:nil]];
+  ExtensionPopup::ShowPopupWithNativeParent(browser, std::move(popup),
+      gfx::NativeView(anchor.window.contentView), gfx::ScreenRectFromNSRect(screen_rect), lease);
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_hosted.h b/libcef/browser/orbit/orbit_hosted.h
new file mode 100644
index 0000000..0730aab
--- /dev/null
+++ b/libcef/browser/orbit/orbit_hosted.h
@@ -0,0 +1,90 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_H_
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "cef/include/cef_browser.h"
+#include "cef/libcef/browser/orbit/orbit_hosted_intent.h"
+#include "ui/gfx/native_ui_types.h"
+
+class Browser;
+class Profile;
+struct CefBrowserCreateParams;
+
+// Orbit "hosted Chrome" mode (ENG-X2, variant D-chrome).
+//
+// Every Orbit window x profile owns one invisible logical Chrome Browser
+// (TYPE_NORMAL) whose BrowserWindow is an AppKit, Views-free
+// OrbitBrowserWindow. Orbit tabs are Chrome-style CEF browsers living in that
+// Browser's TabStripModel; Orbit keeps placing their content NSView. All state
+// is UI-thread only.
+namespace orbit {
+
+// Parent marks (see orbit_cef_api_t::prepare_hosted_tab).
+bool PrepareHostedTab(CefWindowHandle parent_view,
+                      uint64_t window_token,
+                      int index);
+bool CancelHostedTab(CefWindowHandle parent_view);
+// Consumes the mark for |parent_view|.
+std::optional<HostedTabRequest> TakeHostedTab(CefWindowHandle parent_view);
+
+// Orbit windows. WindowCreated(token, NSWindow*) is declared in
+// orbit_hosted_mac.h.
+int WindowDestroyed(uint64_t window_token);
+bool IsKnownWindow(uint64_t window_token);
+// Generation of a known (registered, not destroyed) window, for a moved tab.
+std::optional<uint64_t> GetWindowGeneration(uint64_t window_token);
+bool IsHostedRequestLive(const HostedTabRequest& request);
+gfx::NativeWindow GetNativeWindow(uint64_t window_token);
+
+// Transfer holds (side API v3). While a window is held, its emptied logical
+// Browsers stay alive; releasing the last hold closes those still empty.
+// Return the remaining hold count, or -1 for an unknown window.
+int HoldWindow(uint64_t window_token);
+int ReleaseWindow(uint64_t window_token);
+bool IsWindowHeld(uint64_t window_token);
+// Drops a logical Browser that Chrome is already destroying from its window
+// record, so that a new one can take its place (it unregisters itself later).
+void ForgetLogicalBrowser(uint64_t window_token, Browser* browser);
+
+// Logical Browsers, one per (window, profile).
+Browser* GetLogicalBrowser(uint64_t window_token, Profile* profile);
+void RegisterLogicalBrowser(uint64_t window_token,
+                            Profile* profile,
+                            Browser* browser);
+// Called by OrbitBrowserWindow when its Browser goes away.
+void LogicalBrowserDestroyed(uint64_t window_token, Browser* browser);
+std::vector<Browser*> GetLogicalBrowsers(uint64_t window_token);
+
+// Per-tab creation parameters. A logical Browser is shared by several Orbit
+// surfaces with different CefClients and parent views, while
+// ChromeBrowserDelegate keeps the parameters of the Browser's first tab. The
+// hosted creation path publishes the parameters of the tab being inserted;
+// ChromeBrowserDelegate::SetAsDelegate consumes them.
+class ScopedPendingTab {
+ public:
+  ScopedPendingTab(Browser* browser, const CefBrowserCreateParams& params);
+  ScopedPendingTab(const ScopedPendingTab&) = delete;
+  ScopedPendingTab& operator=(const ScopedPendingTab&) = delete;
+  ~ScopedPendingTab();
+
+ private:
+  Browser* const browser_;
+};
+
+// Returns true and fills |params| when |browser| has a pending Orbit tab.
+bool TakePendingTab(Browser* browser, CefBrowserCreateParams* params);
+
+// True when |browser| is a logical Browser owned by an Orbit window.
+bool IsLogicalBrowser(const Browser* browser);
+
+}  // namespace orbit
+
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_H_
diff --git a/libcef/browser/orbit/orbit_hosted.mm b/libcef/browser/orbit/orbit_hosted.mm
new file mode 100644
index 0000000..7e2f5ec
--- /dev/null
+++ b/libcef/browser/orbit/orbit_hosted.mm
@@ -0,0 +1,257 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_hosted.h"
+#include "cef/libcef/browser/orbit/orbit_hosted_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include <map>
+#include <vector>
+#include <utility>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "cef/libcef/browser/orbit/orbit_browser_window.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+
+namespace orbit {
+
+namespace {
+
+struct WindowRecord {
+  __weak NSWindow* window = nil;
+  std::map<Profile*, Browser*> browsers;
+  int holds = 0;
+};
+
+// Every logical Browser's BrowserWindow is an OrbitBrowserWindow.
+OrbitBrowserWindow* OrbitWindowOf(Browser* browser) {
+  return static_cast<OrbitBrowserWindow*>(static_cast<BrowserWindow*>(browser->GetWindow()));
+}
+
+void CloseDeferred(const std::map<Profile*, Browser*>& browsers) {
+  std::vector<Browser*> snapshot;
+  for (const auto& [profile, browser] : browsers) {
+    snapshot.push_back(browser);
+  }
+  for (Browser* browser : snapshot) {
+    OrbitWindowOf(browser)->CloseIfDeferred();
+  }
+}
+
+struct Registry {
+  std::map<uint64_t, WindowRecord> windows;
+  HostedCreationPolicy creation_policy;
+  std::map<Browser*, CefBrowserCreateParams> pending_tabs;
+  std::map<const Browser*, uint64_t> logical_browsers;
+};
+
+Registry& GetRegistry() {
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+
+}  // namespace
+
+bool PrepareHostedTab(CefWindowHandle parent_view,
+                      uint64_t window_token,
+                      int index) {
+  return GetRegistry().creation_policy.Prepare(parent_view, window_token, index);
+}
+
+bool CancelHostedTab(CefWindowHandle parent_view) {
+  return GetRegistry().creation_policy.Cancel(parent_view);
+}
+
+std::optional<HostedTabRequest> TakeHostedTab(CefWindowHandle parent_view) {
+  return GetRegistry().creation_policy.Take(parent_view);
+}
+
+bool IsHostedRequestLive(const HostedTabRequest& request) {
+  return GetRegistry().creation_policy.IsLive(request) &&
+         IsKnownWindow(request.window_token);
+}
+
+bool WindowCreated(uint64_t window_token, NSWindow* window) {
+  auto& windows = GetRegistry().windows;
+  if (!window_token || !window || windows.contains(window_token)) {
+    return false;
+  }
+  CHECK(GetRegistry().creation_policy.RegisterWindow(window_token));
+  windows[window_token].window = window;
+  return true;
+}
+
+int WindowDestroyed(uint64_t window_token) {
+  auto& registry = GetRegistry();
+  auto it = registry.windows.find(window_token);
+  if (it == registry.windows.end()) {
+    return -1;
+  }
+  const int live = static_cast<int>(it->second.browsers.size());
+  // Browsers that still own tabs keep their window token; they report a null
+  // native window from now on and close with their last tab. Emptied Browsers
+  // kept by a transfer hold close now.
+  it->second.window = nil;
+  it->second.holds = 0;
+  if (live == 0) {
+    registry.windows.erase(it);
+  } else {
+    CloseDeferred(std::map<Profile*, Browser*>(it->second.browsers));
+  }
+  // Do not erase an unconsumed mark: it still identifies a cancelled hosted
+  // request and must never be reinterpreted as an ordinary Alloy request.
+  registry.creation_policy.UnregisterWindow(window_token);
+  return live;
+}
+
+bool IsKnownWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  return it != windows.end() && it->second.window != nil;
+}
+
+std::optional<uint64_t> GetWindowGeneration(uint64_t window_token) {
+  if (!IsKnownWindow(window_token)) {
+    return std::nullopt;
+  }
+  return GetRegistry().creation_policy.Generation(window_token);
+}
+
+gfx::NativeWindow GetNativeWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end() || it->second.window == nil) {
+    return gfx::NativeWindow();
+  }
+  return gfx::NativeWindow(it->second.window);
+}
+
+int HoldWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end() || it->second.window == nil) {
+    return -1;
+  }
+  return ++it->second.holds;
+}
+
+int ReleaseWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end() || it->second.holds <= 0) {
+    return -1;
+  }
+  const int remaining = --it->second.holds;
+  if (remaining == 0) {
+    // May destroy Browsers later (UnloadController); the record stays valid.
+    CloseDeferred(std::map<Profile*, Browser*>(it->second.browsers));
+  }
+  return remaining;
+}
+
+bool IsWindowHeld(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  return it != windows.end() && it->second.holds > 0;
+}
+
+void ForgetLogicalBrowser(uint64_t window_token, Browser* browser) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end()) {
+    return;
+  }
+  for (auto entry = it->second.browsers.begin(); entry != it->second.browsers.end(); ++entry) {
+    if (entry->second == browser) {
+      it->second.browsers.erase(entry);
+      return;
+    }
+  }
+}
+
+Browser* GetLogicalBrowser(uint64_t window_token, Profile* profile) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end()) {
+    return nullptr;
+  }
+  auto browser = it->second.browsers.find(profile);
+  return browser == it->second.browsers.end() ? nullptr : browser->second;
+}
+
+void RegisterLogicalBrowser(uint64_t window_token,
+                            Profile* profile,
+                            Browser* browser) {
+  auto& registry = GetRegistry();
+  auto it = registry.windows.find(window_token);
+  CHECK(it != registry.windows.end());
+  CHECK(!it->second.browsers.contains(profile));
+  it->second.browsers[profile] = browser;
+  registry.logical_browsers[browser] = window_token;
+}
+
+void LogicalBrowserDestroyed(uint64_t window_token, Browser* browser) {
+  auto& registry = GetRegistry();
+  registry.logical_browsers.erase(browser);
+  registry.pending_tabs.erase(browser);
+  auto it = registry.windows.find(window_token);
+  if (it == registry.windows.end()) {
+    return;
+  }
+  for (auto entry = it->second.browsers.begin();
+       entry != it->second.browsers.end(); ++entry) {
+    if (entry->second == browser) {
+      it->second.browsers.erase(entry);
+      break;
+    }
+  }
+  if (it->second.window == nil && it->second.browsers.empty()) {
+    registry.windows.erase(it);
+  }
+}
+
+std::vector<Browser*> GetLogicalBrowsers(uint64_t window_token) {
+  std::vector<Browser*> result;
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it != windows.end()) {
+    for (const auto& [profile, browser] : it->second.browsers) {
+      result.push_back(browser);
+    }
+  }
+  return result;
+}
+
+ScopedPendingTab::ScopedPendingTab(Browser* browser,
+                                   const CefBrowserCreateParams& params)
+    : browser_(browser) {
+  auto& pending = GetRegistry().pending_tabs;
+  pending.erase(browser_);
+  pending.emplace(browser_, params);
+}
+
+ScopedPendingTab::~ScopedPendingTab() {
+  GetRegistry().pending_tabs.erase(browser_);
+}
+
+bool TakePendingTab(Browser* browser, CefBrowserCreateParams* params) {
+  auto& pending = GetRegistry().pending_tabs;
+  auto it = pending.find(browser);
+  if (it == pending.end()) {
+    return false;
+  }
+  *params = it->second;
+  pending.erase(it);
+  return true;
+}
+
+bool IsLogicalBrowser(const Browser* browser) {
+  return GetRegistry().logical_browsers.contains(browser);
+}
+
+}  // namespace orbit
diff --git a/libcef/browser/orbit/orbit_hosted_intent.h b/libcef/browser/orbit/orbit_hosted_intent.h
new file mode 100644
index 0000000..9132c4a
--- /dev/null
+++ b/libcef/browser/orbit/orbit_hosted_intent.h
@@ -0,0 +1,77 @@
+// Copyright 2026 Orbit. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_INTENT_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_INTENT_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+
+namespace orbit {
+
+// Value captured before any asynchronous creation. A recycled window token or
+// parent address cannot change an already accepted request's destination.
+struct HostedTabRequest {
+  uint64_t window_token = 0;
+  int index = -1;
+  uint64_t window_generation = 0;
+};
+
+// UI-thread-only policy, independent of AppKit and CEF for deterministic tests.
+class HostedCreationPolicy {
+ public:
+  bool RegisterWindow(uint64_t token) {
+    if (!token || windows_.contains(token)) {
+      return false;
+    }
+    windows_[token] = next_generation_++;
+    return true;
+  }
+
+  void UnregisterWindow(uint64_t token) { windows_.erase(token); }
+
+  bool Prepare(void* parent, uint64_t token, int index) {
+    auto found = windows_.find(token);
+    if (!parent || found == windows_.end() || marks_.contains(parent)) {
+      return false;
+    }
+    marks_.emplace(parent, HostedTabRequest{token, index < 0 ? -1 : index,
+                                          found->second});
+    return true;
+  }
+
+  bool Cancel(void* parent) { return marks_.erase(parent) > 0; }
+
+  std::optional<HostedTabRequest> Take(void* parent) {
+    auto found = marks_.find(parent);
+    if (found == marks_.end()) {
+      return std::nullopt;
+    }
+    const auto request = found->second;
+    marks_.erase(found);
+    return request;
+  }
+
+  // Generation of a registered window, used to re-target a moved tab.
+  std::optional<uint64_t> Generation(uint64_t token) const {
+    auto found = windows_.find(token);
+    if (found == windows_.end()) {
+      return std::nullopt;
+    }
+    return found->second;
+  }
+
+  bool IsLive(const HostedTabRequest& request) const {
+    auto found = windows_.find(request.window_token);
+    return found != windows_.end() &&
+           found->second == request.window_generation;
+  }
+
+ private:
+  uint64_t next_generation_ = 1;
+  std::map<uint64_t, uint64_t> windows_;
+  std::map<void*, HostedTabRequest> marks_;
+};
+
+}  // namespace orbit
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_INTENT_H_
