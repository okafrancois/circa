@@ -0,0 +1,161 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/browser_platform_delegate_chrome_hosted.h"
+
+#import <AppKit/AppKit.h>
+
+#include <map>
+
+#include "base/no_destructor.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/orbit/orbit_hosted.h"
+#include "content/public/browser/web_contents.h"
+
+namespace {
+
+using DelegateMap = std::map<int, CefBrowserPlatformDelegateChromeHosted*>;
+
+DelegateMap& GetDelegates() {
+  static base::NoDestructor<DelegateMap> delegates;
+  return *delegates;
+}
+
+}  // namespace
+
+CefBrowserPlatformDelegateChromeHosted::CefBrowserPlatformDelegateChromeHosted(
+    std::unique_ptr<CefBrowserPlatformDelegateNative> native_delegate,
+    CefWindowHandle parent_view,
+    uint64_t window_token,
+    uint64_t window_generation)
+    : CefBrowserPlatformDelegateChrome(std::move(native_delegate)),
+      parent_view_(parent_view),
+      window_token_(window_token),
+      window_generation_(window_generation) {}
+
+CefBrowserPlatformDelegateChromeHosted::
+    ~CefBrowserPlatformDelegateChromeHosted() {
+  if (browser_id_) {
+    GetDelegates().erase(browser_id_);
+  }
+}
+
+// static
+CefBrowserPlatformDelegateChromeHosted*
+CefBrowserPlatformDelegateChromeHosted::FromBrowserId(int browser_id) {
+  auto& delegates = GetDelegates();
+  auto it = delegates.find(browser_id);
+  return it == delegates.end() ? nullptr : it->second;
+}
+
+void CefBrowserPlatformDelegateChromeHosted::WebContentsDestroyed(
+    content::WebContents* web_contents) {
+  // Leave no WebContents view behind in the Orbit hierarchy.
+  NSView* content = web_contents->GetNativeView().GetNativeNSView();
+  [content removeFromSuperview];
+  CefBrowserPlatformDelegateChrome::WebContentsDestroyed(web_contents);
+}
+
+void CefBrowserPlatformDelegateChromeHosted::BrowserCreated(
+    CefBrowserHostBase* browser) {
+  CefBrowserPlatformDelegateChrome::BrowserCreated(browser);
+  browser_id_ = browser->GetIdentifier();
+  GetDelegates()[browser_id_] = this;
+  // Place the content view before OnAfterCreated() so that
+  // CefBrowserHost::GetWindowHandle() is valid in client callbacks.
+  PlaceContentView();
+}
+
+void CefBrowserPlatformDelegateChromeHosted::BrowserDestroyed(
+    CefBrowserHostBase* browser) {
+  if (browser_id_) {
+    GetDelegates().erase(browser_id_);
+    browser_id_ = 0;
+  }
+  CefBrowserPlatformDelegateChrome::BrowserDestroyed(browser);
+}
+
+CefWindowHandle CefBrowserPlatformDelegateChromeHosted::GetHostWindowHandle()
+    const {
+  // The content NSView itself: it is what Orbit sizes, focuses and moves.
+  if (!web_contents_) {
+    return kNullWindowHandle;
+  }
+  return CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+      web_contents_->GetNativeView().GetNativeNSView());
+}
+
+void CefBrowserPlatformDelegateChromeHosted::SetFocus(bool setFocus) {
+  native_delegate_->SetFocus(setFocus);
+}
+
+gfx::Point CefBrowserPlatformDelegateChromeHosted::GetScreenPoint(
+    const gfx::Point& view,
+    bool want_dip_coords) const {
+  if (!IsRequestLive()) {
+    return gfx::Point();
+  }
+  // Relative to the Orbit parent view, as for Alloy native browsers; macOS
+  // always operates in DIP coordinates.
+  NSView* parent = CAST_CEF_WINDOW_HANDLE_TO_NSVIEW(parent_view_);
+  if (!parent || ![parent window]) {
+    return gfx::Point();
+  }
+  const NSRect bounds = [parent bounds];
+  const NSPoint view_point = {static_cast<CGFloat>(view.x()),
+                              bounds.size.height - static_cast<CGFloat>(view.y())};
+  const NSPoint window_point = [parent convertPoint:view_point toView:nil];
+  const NSPoint screen_point =
+      [[parent window] convertPointToScreen:window_point];
+  return gfx::Point(screen_point.x, screen_point.y);
+}
+
+bool CefBrowserPlatformDelegateChromeHosted::AttachToParent(
+    CefWindowHandle parent_view) {
+  if (!IsRequestLive()) {
+    return false;
+  }
+  parent_view_ = parent_view;
+  if (!web_contents_) {
+    return false;
+  }
+  if (!parent_view_) {
+    [web_contents_->GetNativeView().GetNativeNSView() removeFromSuperview];
+    return true;
+  }
+  PlaceContentView();
+  return true;
+}
+
+void CefBrowserPlatformDelegateChromeHosted::SetWindow(
+    uint64_t window_token,
+    uint64_t window_generation) {
+  window_token_ = window_token;
+  window_generation_ = window_generation;
+}
+
+bool CefBrowserPlatformDelegateChromeHosted::IsRequestLive() const {
+  return orbit::IsHostedRequestLive({window_token_, -1, window_generation_});
+}
+
+void CefBrowserPlatformDelegateChromeHosted::PlaceContentView() {
+  if (!IsRequestLive()) {
+    return;
+  }
+  NSView* parent = CAST_CEF_WINDOW_HANDLE_TO_NSVIEW(parent_view_);
+  if (!parent || !web_contents_) {
+    return;
+  }
+  NSView* content = web_contents_->GetNativeView().GetNativeNSView();
+  if (!content) {
+    return;
+  }
+  if ([content superview] != parent) {
+    [content removeFromSuperview];
+    [parent addSubview:content];
+  }
+  [content setFrame:[parent bounds]];
+  [content setAutoresizingMask:(NSViewWidthSizable | NSViewHeightSizable)];
+  [content setNeedsDisplay:YES];
+}
