+    nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
+};
+
+const orbit_cef_api_t kApiV4 = {
+    sizeof(orbit_cef_api_t), 4u,
+    &WindowCreated, &WindowDestroyed, &WindowActivationChanged, &WindowBoundsChanged,
+    &PrepareHostedTab, &CancelHostedTab, &AttachView, &ActivateTab, &GetTabInfo,
+    &WindowBrowserCount, &MoveTab, &ProfileLoaded, &HoldWindow, &ReleaseWindow,
+    &ExtensionsSnapshot, &ExtensionSetEnabled, &ExtensionRemove, &ExtensionsObserve, &ExtensionAction, &ExtensionSelectionChanged, &ExtensionCancel,
+};
+
+const orbit_cef_api_t kApiV5 = [] {
+  auto api = kApiV4;
+  api.version = 5u;
+  api.extension_action_snapshot = &ExtensionActionSnapshot;
+  api.browser_state = &BrowserState;
+  api.browser_state_observe = &BrowserStateObserve;
+  return api;
+}();
