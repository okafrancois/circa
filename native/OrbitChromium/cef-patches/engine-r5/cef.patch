+// CH-ESSENTIALS (Orbit docs/native-port/ch-essentials-2026-10-25.md): level of the
+// essential-surface fixes, independent of the side API version. 1: element
+// fullscreen reported by OrbitBrowserWindow, no sad-tab crash without a
+// BrowserView, embedder-confirmed folder upload only for Orbit hosted tabs.
+extern "C" CEF_EXPORT uint32_t orbit_cef_essentials_level(void);
+extern "C" CEF_EXPORT uint32_t orbit_cef_essentials_level(void) {
+  return 1u;
+}
