+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_PASSWORD_PROMPT_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_PASSWORD_PROMPT_H_
+#include "cef/libcef/browser/orbit/orbit_cef_api.h"
+namespace content { class WebContents; }
+namespace orbit {
+bool UpdatePasswordPrompt(content::WebContents*, bool show);
+bool HidePasswordPrompt(content::WebContents*);
+void ResetPasswordPrompt(content::WebContents*);
+int32_t PasswordPromptObserve(int32_t, const char*, orbit_password_prompt_callback_t, void*);
+int32_t PasswordPromptSnapshot(int32_t, const char*, orbit_password_prompt_t*);
+int32_t PasswordPromptDecide(int32_t, const char*, uint64_t, int32_t);
+int32_t PasswordPromptReopen(int32_t, const char*, uint64_t);
+}
+#endif
diff --git a/libcef/browser/orbit/orbit_password_prompt.mm b/libcef/browser/orbit/orbit_password_prompt.mm
new file mode 100644
index 0000000..658aca4
--- /dev/null
+++ b/libcef/browser/orbit/orbit_password_prompt.mm
@@ -0,0 +1,186 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "cef/libcef/browser/orbit/orbit_password_prompt.h"
+#include <map>
+#include <memory>
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/orbit/browser_platform_delegate_chrome_hosted.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/passwords/manage_passwords_ui_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/origin.h"
+
+namespace orbit {
+namespace {
+uint64_t NextGeneration() { static uint64_t value = 0; return ++value; }
+class Prompt;
+using Prompts = std::map<content::WebContents*, std::shared_ptr<Prompt>>;
+Prompts& Entries() { static base::NoDestructor<Prompts> entries; return *entries; }
+auto* Controller(content::WebContents* contents) {
+  return ManagePasswordsUIController::FromWebContents(contents);
+}
+bool Hosted(content::WebContents* contents) {
+  auto host = CefBrowserHostBase::GetBrowserForContents(contents);
+  return host && CefBrowserPlatformDelegateChromeHosted::FromBrowserId(host->GetIdentifier());
+}
+class Prompt final : public content::WebContentsObserver,
+                     public std::enable_shared_from_this<Prompt> {
+ public:
+  explicit Prompt(content::WebContents* contents) : WebContentsObserver(contents) {
+    auto host = CefBrowserHostBase::GetBrowserForContents(contents);
+    id_ = host->GetIdentifier();
+    profile_ = Profile::FromBrowserContext(contents->GetBrowserContext());
+    path_ = profile_->GetPath().value();
+  }
+  orbit_password_prompt_t Snapshot() const {
+    return {sizeof(orbit_password_prompt_t), 1, id_, state_, generation_,
+            path_.c_str(), origin_.c_str(), username_.c_str(), 1,
+            (state_ == 1 || state_ == 2) && !consumed_ ? 1 : 0};
+  }
+  void Emit(int event) {
+    auto keep_alive = shared_from_this();
+    if (!callback_) return;
+    const auto snapshot = Snapshot();
+    callback_(context_, event, &snapshot);
+  }
+  uint64_t Hide() {
+    const auto generation = generation_ = NextGeneration();
+    held_ = false;
+    if (shown_) { shown_ = false; Emit(2); }
+    return generation;
+  }
+  void Reset() {
+    Hide(); state_ = 0; held_ = false; consumed_ = false;
+    origin_.clear(); username_.clear();
+  }
+  void Update(bool show) {
+    auto* controller = Controller(web_contents());
+    if (!controller) return;
+    using namespace password_manager::ui;
+    const auto native_state = controller->GetState();
+    int state = native_state == PENDING_PASSWORD_STATE ? 1 :
+                native_state == PENDING_PASSWORD_UPDATE_STATE ? 2 :
+                native_state == SAVE_CONFIRMATION_STATE ? 3 : 0;
+    std::string origin, username;
+    if (state) {
+      const auto& pending = controller->GetPendingPassword();
+      origin = url::Origin::Create(pending.url).Serialize();
+      username = base::UTF16ToUTF8(pending.username_value);
+    }
+    const bool changed = state != state_ || origin != origin_ || username != username_;
+    if (changed) {
+      Hide();
+      if (!web_contents()) return;
+      state_ = state; origin_ = std::move(origin); username_ = std::move(username);
+      consumed_ = false; held_ = false;
+      generation_ = NextGeneration();
+      Emit(3);
+    }
+    if (!web_contents() || !state_ || consumed_) return;
+    controller = Controller(web_contents());
+    if (!controller) return;
+    if (show) {
+      // Keep the existing model alive even with presentation disabled. No decision
+      // is inferred from an absent shell UI or observer.
+      held_ = true;
+      controller->OnBubbleShown();
+    }
+    if (held_ && callback_ && !shown_ && web_contents()->GetVisibility() == content::Visibility::VISIBLE) {
+      shown_ = true;
+      Emit(1);
+    }
+  }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility != content::Visibility::VISIBLE) Hide();
+  }
+  void WebContentsDestroyed() override {
+    auto keep_alive = shared_from_this();
+    Reset(); callback_ = nullptr;
+    Entries().erase(web_contents());
+  }
+  int id_ = 0, state_ = 0;
+  uint64_t generation_ = NextGeneration();
+  raw_ptr<Profile> profile_ = nullptr;
+  std::string path_, origin_, username_;
+  bool shown_ = false, held_ = false, consumed_ = false;
+  orbit_password_prompt_callback_t callback_ = nullptr;
+  void* context_ = nullptr;
+};
+std::shared_ptr<Prompt> Entry(content::WebContents* contents) {
+  auto& value = Entries()[contents];
+  if (!value) value = std::make_shared<Prompt>(contents);
+  return value;
+}
+std::shared_ptr<Prompt> Find(int id, const char* path) {
+  if (!CEF_CURRENTLY_ON_UIT() || !path) return nullptr;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  if (!host || !host->GetWebContents() || !Hosted(host->GetWebContents())) return nullptr;
+  auto* profile = Profile::FromBrowserContext(host->GetWebContents()->GetBrowserContext());
+  if (profile->IsOffTheRecord() || profile->GetPath().value() != path) return nullptr;
+  return Entry(host->GetWebContents());
+}
+}
+bool UpdatePasswordPrompt(content::WebContents* contents, bool show) {
+  if (!Hosted(contents)) return false;
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile->IsOffTheRecord()) Entry(contents)->Update(show);
+  return true;
+}
+bool HidePasswordPrompt(content::WebContents* contents) {
+  if (!Hosted(contents)) return false;
+  auto found = Entries().find(contents);
+  if (found != Entries().end()) found->second->Hide();
+  return true;
+}
+void ResetPasswordPrompt(content::WebContents* contents) {
+  auto found = Entries().find(contents);
+  if (found != Entries().end()) found->second->Reset();
+}
+int32_t PasswordPromptObserve(int32_t id, const char* path, orbit_password_prompt_callback_t cb, void* context) {
+  auto entry = Find(id, path); if (!entry) return 0;
+  entry->Hide(); entry->callback_ = cb; entry->context_ = context;
+  entry->Update(false);
+  return 1;
+}
+int32_t PasswordPromptSnapshot(int32_t id, const char* path, orbit_password_prompt_t* out) {
+  auto entry = Find(id, path);
+  if (!entry || !out || out->struct_size < sizeof(*out)) return 0;
+  *out = entry->Snapshot(); return 1;
+}
+int32_t PasswordPromptDecide(int32_t id, const char* path, uint64_t generation, int32_t decision) {
+  auto entry = Find(id, path);
+  if (!entry || generation != entry->generation_ || entry->consumed_ ||
+      (entry->state_ != 1 && entry->state_ != 2) || decision < 1 || decision > 3 ||
+      (decision == 2 && entry->state_ != 1)) return 0;
+  auto* controller = Controller(entry->web_contents());
+  if (!controller || (controller->GetState() != password_manager::ui::PENDING_PASSWORD_STATE &&
+                      controller->GetState() != password_manager::ui::PENDING_PASSWORD_UPDATE_STATE)) return 0;
+  const int state = entry->state_;
+  // Revoke before calling the model, but notify dismissal only after the
+  // decision has taken effect. A UI may unregister itself from its hide callback.
+  const bool was_shown = entry->shown_;
+  entry->consumed_ = true; entry->held_ = false; entry->shown_ = false;
+  entry->generation_ = NextGeneration();
+  if (decision == 1) {
+    const auto pending = controller->GetPendingPassword();
+    controller->SavePassword(pending.username_value, pending.password_value);
+  } else if (decision == 2) controller->NeverSavePassword();
+  else if (state == 2) controller->OnNopeUpdateClicked();
+  else controller->OnNotNowClicked();
+  if (was_shown) entry->Emit(2);
+  if (entry->web_contents()) {
+    if (auto* live = Controller(entry->web_contents())) live->OnBubbleHidden();
+    entry->Update(false);
+  }
+  return 1;
+}
+int32_t PasswordPromptReopen(int32_t id, const char* path, uint64_t generation) {
+  auto entry = Find(id, path);
+  if (!entry || entry->generation_ != generation || entry->consumed_ ||
+      (entry->state_ != 1 && entry->state_ != 2)) return 0;
+  entry->Update(true); return 1;
+}
+}
