+++ b/libcef/browser/orbit/orbit_freezing.inc
@@ -0,0 +1,79 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include <map>
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/no_destructor.h"
+#include "base/task/single_thread_task_runner.h"
+#include "components/performance_manager/public/freezing/freezing.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace {
+namespace pm = performance_manager;
+
+void ReleaseFreezeVote(int32_t browser_id);
+
+class FreezeVoteObserver final : public content::WebContentsObserver {
+ public:
+  FreezeVoteObserver(int32_t browser_id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), browser_id_(browser_id) {}
+  void WebContentsDestroyed() override {
+    const int32_t browser_id = browser_id_;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ReleaseFreezeVote, browser_id));
+  }
+ private:
+  const int32_t browser_id_;
+};
+
+struct FreezeVoteEntry {
+  std::unique_ptr<pm::freezing::FreezingVote> vote;
+  std::unique_ptr<FreezeVoteObserver> observer;
+};
+using OrbitFreezeVotes = std::map<int32_t, FreezeVoteEntry>;
+OrbitFreezeVotes& FreezeVotes() {
+  static base::NoDestructor<OrbitFreezeVotes> votes;
+  return *votes;
+}
+void ReleaseFreezeVote(int32_t browser_id) {
+  FreezeVotes().erase(browser_id);
+}
+
+uint64_t CannotFreezeMask(const pm::freezing::CanFreezeDetails& details) {
+  uint64_t mask = 0;
+  for (auto reason : details.cannot_freeze_reasons)
+    mask |= uint64_t{1} << static_cast<unsigned>(reason);
+  for (auto reason : details.cannot_freeze_reasons_connected_pages)
+    mask |= uint64_t{1} << static_cast<unsigned>(reason);
+  return mask;
+}
+
+int32_t FreezeTab(int32_t browser_id, int32_t freeze) {
+  if (!OnValidUIThread() || (freeze != 0 && freeze != 1) ||
+      !pm::PerformanceManager::IsAvailable())
+    return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  auto* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents)
+    return 0;
+  auto page = pm::PerformanceManager::GetPrimaryPageNodeForWebContents(contents);
+  if (!page)
+    return 0;
+  auto found = FreezeVotes().find(browser_id);
+  if (freeze == 0) {
+    if (found != FreezeVotes().end())
+      FreezeVotes().erase(found);
+    return 1;
+  }
+  if (found != FreezeVotes().end())
+    return 1;
+  FreezeVoteEntry entry;
+  entry.observer = std::make_unique<FreezeVoteObserver>(browser_id, contents);
+  entry.vote = std::make_unique<pm::freezing::FreezingVote>(contents);
+  FreezeVotes().emplace(browser_id, std::move(entry));
+  return 1;
+}
+}  // namespace
