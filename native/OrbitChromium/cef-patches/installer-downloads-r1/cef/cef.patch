@@ -0,0 +1,102 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_installer_downloads.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace orbit {
+namespace {
+
+InstallerTransferFacts Installer() {
+  InstallerTransferFacts facts;
+  facts.source = download::DownloadSource::EXTENSION_INSTALLER;
+  facts.user_data_dir = base::FilePath(FILE_PATH_LITERAL("/synthetic/root"));
+  facts.forced_target = facts.user_data_dir.Append(kWebstoreDownloadFolder)
+                            .Append(FILE_PATH_LITERAL(
+                                "abcdefghijklmnopabcdefghijklmnop_42.crx"));
+  facts.webstore_update_url =
+      GURL("https://clients2.google.com/service/update2/crx");
+  facts.original_url = GURL(
+      "https://clients2.google.com/service/update2/crx?response=redirect&x=id%"
+      "3Dabcdefghijklmnopabcdefghijklmnop%26installsource%3Dondemand%26uc");
+  facts.chrome_style = true;
+  facts.same_browser_context = true;
+  facts.off_the_record = false;
+  return facts;
+}
+
+TEST(OrbitInstallerDownloadsTest, InstallerOwnTransferIsRecognized) {
+  EXPECT_TRUE(IsWebstoreInstallerTransfer(Installer()));
+}
+
+// The review's counterexample: identical public URL/MIME/document facts but an
+// ordinary download source stays the embedder's ordinary download.
+TEST(OrbitInstallerDownloadsTest, OrdinarySourceWithStoreShapeIsNotOwned) {
+  for (auto source : {download::DownloadSource::UNKNOWN,
+                      download::DownloadSource::NAVIGATION,
+                      download::DownloadSource::DRAG_AND_DROP,
+                      download::DownloadSource::FROM_RENDERER,
+                      download::DownloadSource::EXTENSION_API,
+                      download::DownloadSource::CONTEXT_MENU,
+                      download::DownloadSource::WEB_CONTENTS_API,
+                      download::DownloadSource::INTERNAL_API,
+                      download::DownloadSource::RETRY}) {
+    InstallerTransferFacts facts = Installer();
+    facts.source = source;
+    EXPECT_FALSE(IsWebstoreInstallerTransfer(facts));
+  }
+}
+
+TEST(OrbitInstallerDownloadsTest, ForcedInternalTargetIsRequired) {
+  const base::FilePath::CharType* targets[] = {
+      FILE_PATH_LITERAL(""),
+      FILE_PATH_LITERAL("/synthetic/root/Downloads/x.crx"),
+      FILE_PATH_LITERAL("/synthetic/root/Webstore Downloads/x.zip"),
+      FILE_PATH_LITERAL("/synthetic/root/Webstore Downloads/sub/x.crx"),
+      FILE_PATH_LITERAL("/synthetic/root/Webstore Downloads/../x.crx"),
+      FILE_PATH_LITERAL("/synthetic/other/Webstore Downloads/x.crx"),
+      FILE_PATH_LITERAL("Webstore Downloads/x.crx"),
+  };
+  for (const auto* target : targets) {
+    InstallerTransferFacts facts = Installer();
+    facts.forced_target = base::FilePath(target);
+    EXPECT_FALSE(IsWebstoreInstallerTransfer(facts)) << target;
+  }
+  InstallerTransferFacts facts = Installer();
+  facts.user_data_dir = base::FilePath();
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(facts));
+}
+
+TEST(OrbitInstallerDownloadsTest, ContextStyleAndProfileAreRequired) {
+  InstallerTransferFacts alloy = Installer();
+  alloy.chrome_style = false;  // Unhandled would cancel on Alloy.
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(alloy));
+  InstallerTransferFacts foreign = Installer();
+  foreign.same_browser_context = false;
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(foreign));
+  InstallerTransferFacts incognito = Installer();
+  incognito.off_the_record = true;
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(incognito));
+}
+
+TEST(OrbitInstallerDownloadsTest, UpdateUrlIsASecondaryNativeCheck) {
+  for (const char* url :
+       {"http://clients2.google.com/service/update2/crx?x=1",
+        "https://clients2.google.com.example/service/update2/crx",
+        "https://clients2.google.com/service/update2/crxx",
+        "https://user@clients2.google.com/service/update2/crx",
+        "https://clients2.google.com/service/update2/crx#fragment",
+        "https://example.invalid/extension.crx", "not a url"}) {
+    InstallerTransferFacts facts = Installer();
+    facts.original_url = GURL(url);
+    EXPECT_FALSE(IsWebstoreInstallerTransfer(facts)) << url;
+  }
+  InstallerTransferFacts facts = Installer();
+  facts.webstore_update_url = GURL();
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(facts));
+}
+
+}  // namespace
+}  // namespace orbit
