+bool CefDownloadManagerDelegateImpl::ClassifyInstallerTransfer(
+    DownloadItem* item,
+    CefBrowserHostBase* browser) {
+  content::BrowserContext* item_context =
+      content::DownloadItemUtils::GetBrowserContext(item);
+  content::WebContents* contents =
+      browser ? browser->GetWebContents() : nullptr;
+  auto* extensions_client = extensions::ExtensionsBrowserClient::Get();
+  orbit::InstallerTransferFacts facts;
+  facts.source = item->GetDownloadSource();
+  facts.forced_target = item->GetForcedFilePath();
+  facts.original_url = item->GetOriginalUrl();
+  facts.webstore_update_url = extension_urls::GetWebstoreUpdateUrl();
+  facts.user_data_dir =
+      extensions_client ? extensions_client->GetUserDataDir() : base::FilePath();
+  facts.chrome_style = browser && browser->IsChromeStyle();
+  facts.same_browser_context =
+      item_context && contents && contents->GetBrowserContext() == item_context;
+  facts.off_the_record = !item_context || item_context->IsOffTheRecord();
+  if (!orbit::IsWebstoreInstallerTransfer(facts)) {
+    return false;
+  }
+  installer_items_.insert(item);
+  return true;
+}
+
+bool CefDownloadManagerDelegateImpl::IsInstallerTransfer(
+    DownloadItem* item) const {
+  return installer_items_.contains(item);
+}
+
 CefRefPtr<CefBrowserHostBase> CefDownloadManagerDelegateImpl::GetBrowser(
     DownloadItem* item) {
   ItemBrowserMap::const_iterator it = item_browser_map_.find(item);
