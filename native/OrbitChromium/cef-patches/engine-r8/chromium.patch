 void VideoOverlayWindowViews::ShowInactive() {
+  browser_initiated_automatic_pip_ =
+      controller_->IsBrowserInitiatedAutomaticPictureInPicture();
+  if (browser_initiated_automatic_pip_) {
+    initial_title_hide_timer_.Stop();
+    // Hide before the first visible frame; hover keeps the native animations.
+    UpdateControlsVisibility(false, false);
+  }
 // Fade in animation is disabled for Document and Video Picture-in-Picture on
