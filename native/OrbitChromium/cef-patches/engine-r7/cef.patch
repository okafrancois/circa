diff --git a/libcef/renderer/orbit_boost_renderer.cc b/libcef/renderer/orbit_boost_renderer.cc
new file mode 100644
index 0000000..4f5cdd0
--- /dev/null
+++ b/libcef/renderer/orbit_boost_renderer.cc
@@ -0,0 +1,93 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "cef/libcef/renderer/orbit_boosts.h"
+#include "cef/libcef/common/orbit_boosts.h"
+#include "cef/libcef/renderer/render_manager.h"
+#include "content/public/renderer/render_frame.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "extensions/renderer/isolated_world_manager.h"
+#include "third_party/blink/public/platform/web_isolated_world_info.h"
+#include "third_party/blink/public/platform/web_security_origin.h"
+#include "third_party/blink/public/web/web_document.h"
+#include "third_party/blink/public/web/web_local_frame.h"
+#include "third_party/blink/public/web/web_script_source.h"
+#include <map>
+#include "base/no_destructor.h"
+#include "base/memory/weak_ptr.h"
+namespace orbit {
+namespace {
+class Frame;
+std::map<content::RenderFrame*, Frame*>& Frames() { static base::NoDestructor<std::map<content::RenderFrame*, Frame*>> frames; return *frames; }
+int World(const std::string& id) {
+  static base::NoDestructor<std::map<std::string, int>> worlds;
+  auto [it, fresh] = worlds->try_emplace(id, 0);
+  if (fresh) it->second = extensions::IsolatedWorldManager::AllocateWorldId();
+  return it->second;
+}
+class Frame final : public content::RenderFrameObserver {
+ public:
+  explicit Frame(content::RenderFrame* frame) : RenderFrameObserver(frame) { Frames()[frame] = this; }
+  void OnDestruct() override { Frames().erase(render_frame()); delete this; }
+  void DidCreateNewDocument() override { keys_.clear(); started_ = false; revision_ = 0; ++document_; }
+  void StartWithoutRegistry() { started_ = true; }
+  void Apply(const base::DictValue& snapshot, bool start) {
+    if (start && started_) return;
+    if (!start && !started_) return;
+    uint64_t revision; BoostRevision(snapshot, revision);
+    if (!start && revision < revision_) return;
+    revision_ = revision;
+    started_ = true;
+    auto weak = weak_factory_.GetWeakPtr();
+    const auto document_id = document_;
+    auto* frame = render_frame()->GetWebFrame(); auto document = frame->GetDocument();
+    // A single renderer task replaces the ordered sheet set without a paint between revisions.
+    for (const auto& key : keys_) document.RemoveInsertedStyleSheet(key, blink::WebCssOrigin::kUser);
+    keys_.clear();
+    const GURL url(document.Url());
+    if (document.GetSecurityOrigin().IsOpaque() || !url.SchemeIsHTTPOrHTTPS()) return;
+    std::vector<const base::DictValue*> scripts;
+    for (const auto& value : *snapshot.FindList("boosts")) {
+      const auto& boost = value.GetDict();
+      if (!BoostMatches(boost, url)) continue;
+      const auto& css = *boost.FindString("css");
+      if (!css.empty()) keys_.push_back(document.InsertStyleSheet(blink::WebString::FromUtf8(css), nullptr, blink::WebCssOrigin::kUser));
+      scripts.push_back(&boost);
+    }
+    for (const auto* b : scripts) {
+      if (!weak || document_ != document_id) return;
+      const auto& boost = *b;
+      const auto& js = *boost.FindString("js");
+      // Editing JS never re-executes it in an existing document.
+      if (!start || js.empty()) continue;
+      const int world = World(*boost.FindString("id"));
+      blink::WebIsolatedWorldInfo info;
+      info.security_origin = document.GetSecurityOrigin();
+      info.human_readable_name = blink::WebString::FromUtf8("Orbit Boost");
+      info.content_security_policy = blink::WebString::FromUtf8("default-src 'none'; script-src 'unsafe-eval'; connect-src 'none'; object-src 'none'");
+      blink::SetIsolatedWorldInfo(world, info);
+      frame->ExecuteScriptInIsolatedWorld(world, blink::WebScriptSource(blink::WebString::FromUtf8(js)), blink::BackForwardCacheAware::kPossiblyDisallow);
+    }
+  }
+ private:
+  uint64_t document_ = 0;
+  uint64_t revision_ = 0;
+  bool started_ = false;
+  std::vector<blink::WebStyleSheetKey> keys_;
+  base::WeakPtrFactory<Frame> weak_factory_{this};
+};
+}
+void BoostFrameCreated(content::RenderFrame* frame) { new Frame(frame); }
+void BoostDocumentStart(content::RenderFrame* frame) {
+  auto it = Frames().find(frame); if (it == Frames().end()) return;
+  // Native in-memory snapshot barrier; never calls the shell, disk or network.
+  // This also closes navigation/update races on existing renderer processes.
+  std::string json;
+  CefRenderManager::Get()->GetBrowserManager()->GetBoosts(&json);
+  auto snapshot = ParseBoosts(json);
+  if (snapshot) it->second->Apply(*snapshot, true);
+  else it->second->StartWithoutRegistry();
+}
+void BoostUpdate(const std::string& json) {
+  auto snapshot = ParseBoosts(json); if (!snapshot) return;
+  for (auto& [frame, observer] : Frames()) observer->Apply(*snapshot, false);
+}
+}  // namespace orbit
