diff --git a/libcef/common/orbit_boosts.h b/libcef/common/orbit_boosts.h
new file mode 100644
index 0000000..5031521
--- /dev/null
+++ b/libcef/common/orbit_boosts.h
@@ -0,0 +1,64 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#ifndef CEF_LIBCEF_COMMON_ORBIT_BOOSTS_H_
+#define CEF_LIBCEF_COMMON_ORBIT_BOOSTS_H_
+#include <set>
+#include <string>
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/strings/string_split.h"
+#include "base/uuid.h"
+#include "base/values.h"
+#include "url/gurl.h"
+namespace orbit {
+inline bool BoostRevision(const base::DictValue& row, uint64_t& revision) {
+  auto* value = row.FindString("revision");
+  return value && base::StringToUint64(*value, &revision) && revision > 0;
+}
+inline std::optional<base::DictValue> ParseBoosts(const std::string& json) {
+  if (json.size() > 4 * 1024 * 1024) return std::nullopt;
+  auto row = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  uint64_t generation;
+  if (!row || !BoostRevision(*row, generation)) return std::nullopt;
+  auto* boosts = row->FindList("boosts");
+  if (!boosts || boosts->size() > 256) return std::nullopt;
+  size_t bytes = 0;
+  std::set<std::string> ids;
+  for (const auto& value : *boosts) {
+    auto* b = value.GetIfDict();
+    if (!b) return std::nullopt;
+    auto* id = b->FindString("id"); auto* host = b->FindString("host");
+    auto* css = b->FindString("css"); auto* js = b->FindString("js");
+    auto* schemes = b->FindList("schemes"); auto port = b->FindInt("port");
+    uint64_t revision;
+    if (!id || !base::Uuid::ParseLowercase(*id).is_valid() || !ids.insert(*id).second ||
+        !BoostRevision(*b, revision) || !host || host->empty() || host->size() > 253 ||
+        !base::ContainsOnlyChars(*host, "abcdefghijklmnopqrstuvwxyz0123456789.-") ||
+        GURL("https://" + *host).host() != *host || !css || !js ||
+        js->size() > 65536 || !schemes || schemes->empty() || schemes->size() > 2 ||
+        !b->FindBool("subdomains") || !port || *port < 0 || *port > 65535) return std::nullopt;
+    size_t label = 0;
+    for (const auto& part : base::SplitStringPiece(*host, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL)) {
+      if (part.empty() || part.size() > 63 || part.front() == '-' || part.back() == '-') return std::nullopt;
+      ++label;
+    }
+    if (!label || (*b->FindBool("subdomains") && base::ContainsOnlyChars(*host, "0123456789."))) return std::nullopt;
+    for (const auto& scheme : *schemes)
+      if (!scheme.is_string() || (scheme.GetString() != "http" && scheme.GetString() != "https")) return std::nullopt;
+    bytes += css->size() + js->size();
+    if (bytes > 2 * 1024 * 1024) return std::nullopt;
+  }
+  return row;
+}
+inline bool BoostMatches(const base::DictValue& b, const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.has_username() || url.has_password()) return false;
+  const auto& host = *b.FindString("host");
+  if (url.host() != host && (!*b.FindBool("subdomains") ||
+      !base::EndsWith(url.host(), "." + host))) return false;
+  bool scheme = false;
+  for (const auto& s : *b.FindList("schemes")) scheme |= s.GetString() == url.scheme();
+  int port = *b.FindInt("port");
+  return scheme && url.EffectiveIntPort() == (port ? port : url.SchemeIs("https") ? 443 : 80);
+}
+}  // namespace orbit
+#endif
