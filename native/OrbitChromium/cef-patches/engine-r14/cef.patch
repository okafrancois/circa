+      : expected_(std::move(expected)), cb_(cb), ctx_(ctx) {}
+  void OnEndTracingComplete(const CefString& file) override {
+    trace_phase = TracePhase::idle;
+    TraceProfile().clear();
+    const std::string path = file.ToString();
+    const bool ok = path == expected_ && base::PathExists(base::FilePath(path));
+    cb_(ctx_, ok ? 1 : 0, path.c_str());
+  }
+ private:
+  std::string expected_; orbit_trace_callback_t cb_; void* ctx_;
+  IMPLEMENT_REFCOUNTING(TraceEnded);
+};
+int32_t TraceBegin(const char* profile, const char* categories, orbit_trace_callback_t cb, void* ctx) {
+  if (!ExtensionProfile(profile) || !categories || !cb || trace_phase != TracePhase::idle) return 0;
+  TraceProfile() = profile;
+  trace_phase = TracePhase::starting;
+  if (CefBeginTracing(categories, new TraceStarted(cb, ctx))) return 1;
+  TraceProfile().clear(); trace_phase = TracePhase::idle;
+  return 0;
+}
+int32_t TraceEnd(const char* profile, const char* file, orbit_trace_callback_t cb, void* ctx) {
+  if (!OnValidUIThread() || !profile || TraceProfile() != profile || !file || !cb ||
+      trace_phase != TracePhase::recording) return 0;
+  const base::FilePath target(file);
+  // Resolve the parent and profile to reject traversal and symlink escapes. Do not
+  // overwrite an existing destination, including a dangling symbolic link.
+  const auto root = base::MakeAbsoluteFilePath(base::FilePath(profile));
+  const auto parent = base::MakeAbsoluteFilePath(target.DirName());
+  if (!target.IsAbsolute() || target.ReferencesParent() || root.empty() || parent.empty() ||
+      (root != parent && !root.IsParent(parent)) || base::PathExists(target) || base::IsLink(target)) return 0;
+  trace_phase = TracePhase::stopping;
+  if (CefEndTracing(file, new TraceEnded(file, cb, ctx))) return 1;
+  trace_phase = TracePhase::recording;
+  return 0;
