+// Orbit: a local output volume per audio group (one per WebContents). Every
+// stream handed to a renderer goes through a proxy that scales the renderer's
+// own volume by its group's. IO thread only.
+class GroupVolumeStream;
+struct GroupVolumes {
+  std::map<base::UnguessableToken, double> volumes;
+  std::multimap<base::UnguessableToken, base::WeakPtr<GroupVolumeStream>> streams;
+};
+GroupVolumes& GetGroupVolumes() {
+  static base::NoDestructor<GroupVolumes> volumes;
+  return *volumes;
+}
+
+// Owned by its renderer binding; destroyed when either side disconnects.
+class GroupVolumeStream final : public media::mojom::AudioOutputStream {
+ public:
+  static mojo::PendingRemote<media::mojom::AudioOutputStream> Wrap(
+      const base::UnguessableToken& group,
+      mojo::PendingRemote<media::mojom::AudioOutputStream> stream) {
+    return (new GroupVolumeStream(group, std::move(stream)))->Bind();
+  }
+
+  GroupVolumeStream(const GroupVolumeStream&) = delete;
+  GroupVolumeStream& operator=(const GroupVolumeStream&) = delete;
+
+  void SetScale(double scale) {
+    scale_ = scale;
+    target_->SetVolume(volume_ * scale_);
+  }
+
+  // media::mojom::AudioOutputStream:
+  void Play() override { target_->Play(); }
+  void Pause() override { target_->Pause(); }
+  void Flush() override { target_->Flush(); }
+  void SetVolume(double volume) override {
+    volume_ = volume;
+    target_->SetVolume(volume_ * scale_);
+  }
+
+ private:
+  GroupVolumeStream(const base::UnguessableToken& group,
+                    mojo::PendingRemote<media::mojom::AudioOutputStream> stream)
+      : group_(group), target_(std::move(stream)) {
+    auto& volumes = GetGroupVolumes();
+    const auto found = volumes.volumes.find(group_);
+    if (found != volumes.volumes.end()) {
+      scale_ = found->second;
+      target_->SetVolume(scale_);  // The renderer's volume starts at 1.
+    }
+    volumes.streams.emplace(group_, weak_factory_.GetWeakPtr());
+    target_.set_disconnect_with_reason_handler(base::BindOnce(
+        &GroupVolumeStream::OnTargetDisconnected, base::Unretained(this)));
+  }
+
+  ~GroupVolumeStream() override {
+    auto& streams = GetGroupVolumes().streams;
+    auto [begin, end] = streams.equal_range(group_);
+    for (auto it = begin; it != end; ++it) {
+      if (it->second.get() == this) {
+        streams.erase(it);
+        break;
+      }
+    }
+  }
+
+  mojo::PendingRemote<media::mojom::AudioOutputStream> Bind() {
+    auto remote = receiver_.BindNewPipeAndPassRemote();
+    receiver_.set_disconnect_handler(base::BindOnce(
+        &GroupVolumeStream::Destroy, base::Unretained(this)));
+    return remote;
+  }
+
+  void OnTargetDisconnected(uint32_t reason, const std::string& description) {
+    receiver_.ResetWithReason(reason, description);
+    Destroy();
+  }
+
+  void Destroy() { delete this; }
+
+  const base::UnguessableToken group_;
+  mojo::Remote<media::mojom::AudioOutputStream> target_;
+  mojo::Receiver<media::mojom::AudioOutputStream> receiver_{this};
+  double volume_ = 1.0;
+  double scale_ = 1.0;
+  base::WeakPtrFactory<GroupVolumeStream> weak_factory_{this};
+};
+
 }  // namespace
 
+// Orbit: sets the local output volume of an audio group in [0, 1] (1 restores
+// it), as heard and as captured from the tab. Any thread. Declared by the
+// embedder, which owns the only caller.
+CONTENT_EXPORT void OrbitSetAudioGroupVolume(const base::UnguessableToken& group,
+                                             double volume);
+CONTENT_EXPORT void OrbitSetAudioGroupVolume(const base::UnguessableToken& group,
+                                             double volume) {
+  if (!BrowserThread::CurrentlyOn(BrowserThread::IO)) {
+    GetIOThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&OrbitSetAudioGroupVolume, group, volume));
+    return;
+  }
+  if (!(volume >= 0.0 && volume <= 1.0)) {
+    return;
+  }
+  auto& volumes = GetGroupVolumes();
+  if (volume == 1.0) {
+    volumes.volumes.erase(group);
+  } else {
+    volumes.volumes[group] = volume;
+  }
+  auto [begin, end] = volumes.streams.equal_range(group);
+  for (auto it = begin; it != end; ++it) {
+    if (it->second) {
+      it->second->SetScale(volume);
+    }
+  }
+}
