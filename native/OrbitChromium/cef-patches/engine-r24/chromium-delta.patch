+void AddEmbedderComponentExtension(ComponentLoader* loader) {
+  // An embedder's built-in extension, unpacked in a directory the browser
+  // process names on its own command line. Loaded as a component of every
+  // regular profile: not user-manageable, hidden from the extensions page and
+  // allowed in that profile's off-the-record contexts.
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kEmbedderComponentExtensionSwitch)) {
+    return;
+  }
+  const base::FilePath path =
+      command_line->GetSwitchValuePath(kEmbedderComponentExtensionSwitch);
+  if (path.empty() || !path.IsAbsolute()) {
+    return;
