+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+// Included inside orbit_cef_api.mm before its anonymous namespace.
+// Per-tab local output volume (side API v19). The browser's audio stream broker
+// scales every output stream of the tab's audio group (the renderer's own
+// volume times the group's), tab capture included.
+#include <cmath>
+#include "content/browser/media/forwarding_audio_stream_factory.h"
+#include "content/browser/web_contents/web_contents_impl.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace content {
+// Defined with the audio output stream broker (Chromium delta of this engine).
+void OrbitSetAudioGroupVolume(const base::UnguessableToken& group, double volume);
+}  // namespace content
+
+namespace {
+CefRefPtr<ChromeBrowserHostImpl> GetChromeHost(int32_t browser_id);
+bool OnValidUIThread();
+
+class TabVolumes final {
+ public:
+  static TabVolumes& Get() {
+    static base::NoDestructor<TabVolumes> volumes;
+    return *volumes;
+  }
+
+  double VolumeOf(content::WebContents* contents) const {
+    const auto found = entries_.find(contents);
+    return found == entries_.end() ? 1.0 : found->second->volume;
+  }
+
+  void Set(content::WebContents* contents, double volume) {
+    auto found = entries_.find(contents);
+    if (volume == 1.0) {
+      if (found == entries_.end()) return;
+      const auto group = found->second->group;
+      entries_.erase(found);
+      content::OrbitSetAudioGroupVolume(group, 1.0);
+      return;
+    }
+    if (found == entries_.end()) {
+      auto* impl = static_cast<content::WebContentsImpl*>(contents);
+      found = entries_.emplace(contents, std::make_unique<Entry>(
+          contents, impl->GetAudioStreamFactory()->group_id())).first;
+    }
+    found->second->volume = volume;
+    content::OrbitSetAudioGroupVolume(found->second->group, volume);
+  }
+
+ private:
+  friend class base::NoDestructor<TabVolumes>;
+  struct Entry final : content::WebContentsObserver {
+    Entry(content::WebContents* contents, const base::UnguessableToken& group_id)
+        : content::WebContentsObserver(contents), group(group_id) {}
+    void WebContentsDestroyed() override {
+      // The group ends with its contents; forget its volume.
+      TabVolumes::Get().Set(web_contents(), 1.0);
+    }
+    const base::UnguessableToken group;
+    double volume = 1.0;
+  };
+
+  TabVolumes() = default;
+
+  std::map<content::WebContents*, std::unique_ptr<Entry>> entries_;
+};
+
+int32_t TabVolumeSet(int32_t browser_id, double volume) {
+  if (!OnValidUIThread() || !std::isfinite(volume) || volume < 0.0 || volume > 1.0) return 0;
+  auto host = GetChromeHost(browser_id);
+  auto* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents) return 0;
+  TabVolumes::Get().Set(contents, volume);
+  return 1;
+}
+
+int32_t TabVolumeGet(int32_t browser_id, double* volume) {
+  if (!OnValidUIThread() || !volume) return 0;
+  auto host = GetChromeHost(browser_id);
+  auto* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents) return 0;
+  *volume = TabVolumes::Get().VolumeOf(contents);
+  return 1;
+}
+}  // namespace
