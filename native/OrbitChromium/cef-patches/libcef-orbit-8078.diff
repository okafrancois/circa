+const ui::ThemeProvider* OrbitBrowserWindow::GetThemeProvider() const {
+  return &ThemeService::GetThemeProviderForProfile(profile_);
+}
+
+const ui::ColorProvider* OrbitBrowserWindow::GetColorProvider() const {
+  return ui::ColorProviderManager::Get().GetColorProviderFor(
+      ui::ColorProviderKey());
+}
+
+int OrbitBrowserWindow::GetTopControlsHeight() const {
+  return 0;
+}
+
+std::vector<StatusBubble*> OrbitBrowserWindow::GetStatusBubbles() {
+  return {};
+}
+
+gfx::Rect OrbitBrowserWindow::GetRestoredBounds() const {
+  return GetBounds();
+}
+
+ui::mojom::WindowShowState OrbitBrowserWindow::GetRestoredState() const {
+  return ui::mojom::WindowShowState::kNormal;
+}
+
+gfx::Rect OrbitBrowserWindow::GetBounds() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window ? gfx::ScreenRectFromNSRect([window frame]) : gfx::Rect();
+}
+
+gfx::Size OrbitBrowserWindow::GetContentsSize() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  if (!window) {
+    return gfx::Size();
+  }
+  const NSSize size = [[window contentView] bounds].size;
+  return gfx::Size(size.width, size.height);
+}
+
+bool OrbitBrowserWindow::IsMaximized() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && [window isZoomed];
+}
+
+bool OrbitBrowserWindow::IsMinimized() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && [window isMiniaturized];
+}
+
+bool OrbitBrowserWindow::GetCanResize() {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && ([window styleMask] & NSWindowStyleMaskResizable);
+}
+
+ui::mojom::WindowShowState OrbitBrowserWindow::GetWindowShowState() const {
+  if (IsFullscreen()) {
+    return ui::mojom::WindowShowState::kFullscreen;
+  }
+  if (IsMinimized()) {
+    return ui::mojom::WindowShowState::kMinimized;
+  }
+  if (IsMaximized()) {
+    return ui::mojom::WindowShowState::kMaximized;
+  }
+  return ui::mojom::WindowShowState::kNormal;
+}
+
+bool OrbitBrowserWindow::IsFullscreen() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && ([window styleMask] & NSWindowStyleMaskFullScreen);
+}
+
+LocationBar* OrbitBrowserWindow::GetLocationBar() const {
+  return const_cast<StubLocationBar*>(&location_bar_);
+}
