+content::KeyboardEventProcessingResult
+OrbitBrowserWindow::PreHandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  return content::KeyboardEventProcessingResult::NOT_HANDLED;
+}
+
+bool OrbitBrowserWindow::HandleKeyboardEvent(
+    const input::NativeWebKeyboardEvent& event) {
+  // Unhandled page keys go to the Orbit menu bar, as Alloy-style CEF does
+  // (CefBrowserPlatformDelegateNativeMac::HandleKeyboardEvent).
+  NSEvent* ns_event = event.os_event.Get();
+  if (ns_event && ns_event.type == NSEventTypeKeyDown) {
+    return [[NSApp mainMenu] performKeyEquivalent:ns_event];
+  }
+  return false;
+}
+
+bool OrbitBrowserWindow::IsTabStripEditable() const {
+  return true;
+}
+
+bool OrbitBrowserWindow::IsToolbarVisible() const {
+  // X2.6 will return true with an Orbit ExtensionsContainer
+  // (action.openPopup requires it).
+  return false;
+}
+
+bool OrbitBrowserWindow::IsLocationBarVisible() const {
+  return false;
+}
+
+bool OrbitBrowserWindow::IsToolbarShowing() const {
+  return false;
+}
+
+bool OrbitBrowserWindow::IsUnframedModeEnabled() const {
+  return false;
+}
+
+BrowserView* OrbitBrowserWindow::AsBrowserView() {
+  return nullptr;
+}
+
+void OrbitBrowserWindow::ShowIntentPickerBubble(
+    std::vector<apps::IntentPickerAppInfo> app_info,
+    bool show_stay_in_chrome,
+    bool show_remember_selection,
+    apps::IntentPickerBubbleType bubble_type,
+    const std::optional<url::Origin>& initiating_origin,
+    IntentPickerResponse callback) {}
+
+ShowTranslateBubbleResult OrbitBrowserWindow::ShowTranslateBubble(
