+  // Owned by the Browser (BrowserWindow::DeleteBrowserWindow).
+  auto* window = new orbit::OrbitBrowserWindow(params.orbit_window_token, profile);
+  chrome_params.initial_bounds = window->GetBounds();
+  chrome_params.window = window;
