+++ b/libcef/browser/orbit/orbit_hosted_intent.h
@@ -0,0 +1,77 @@
+// Copyright 2026 Orbit. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_INTENT_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_INTENT_H_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+
+namespace orbit {
+
+// Value captured before any asynchronous creation. A recycled window token or
+// parent address cannot change an already accepted request's destination.
+struct HostedTabRequest {
+  uint64_t window_token = 0;
+  int index = -1;
+  uint64_t window_generation = 0;
+};
+
+// UI-thread-only policy, independent of AppKit and CEF for deterministic tests.
+class HostedCreationPolicy {
+ public:
+  bool RegisterWindow(uint64_t token) {
+    if (!token || windows_.contains(token)) {
+      return false;
+    }
+    windows_[token] = next_generation_++;
+    return true;
+  }
+
+  void UnregisterWindow(uint64_t token) { windows_.erase(token); }
+
+  bool Prepare(void* parent, uint64_t token, int index) {
+    auto found = windows_.find(token);
+    if (!parent || found == windows_.end() || marks_.contains(parent)) {
+      return false;
+    }
+    marks_.emplace(parent, HostedTabRequest{token, index < 0 ? -1 : index,
+                                          found->second});
+    return true;
+  }
+
+  bool Cancel(void* parent) { return marks_.erase(parent) > 0; }
+
+  std::optional<HostedTabRequest> Take(void* parent) {
+    auto found = marks_.find(parent);
+    if (found == marks_.end()) {
+      return std::nullopt;
+    }
+    const auto request = found->second;
+    marks_.erase(found);
+    return request;
+  }
+
+  // Generation of a registered window, used to re-target a moved tab.
+  std::optional<uint64_t> Generation(uint64_t token) const {
+    auto found = windows_.find(token);
+    if (found == windows_.end()) {
+      return std::nullopt;
+    }
+    return found->second;
+  }
+
+  bool IsLive(const HostedTabRequest& request) const {
+    auto found = windows_.find(request.window_token);
+    return found != windows_.end() &&
+           found->second == request.window_generation;
+  }
+
+ private:
+  uint64_t next_generation_ = 1;
+  std::map<uint64_t, uint64_t> windows_;
+  std::map<void*, HostedTabRequest> marks_;
+};
+
+}  // namespace orbit
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_INTENT_H_
