+}
+
+void OrbitBrowserWindow::ConfirmBrowserCloseWithPendingDownloads(
+    int download_count,
+    UnloadController::DownloadCloseType dialog_type,
+    base::OnceCallback<void(bool)> callback) {
+  // Downloads belong to the Orbit profile, not to this logical Browser; the
+  // shell owns any confirmation. Proceed with the close.
+  std::move(callback).Run(true);
+}
+
+std::unique_ptr<FindBar> OrbitBrowserWindow::CreateFindBar() {
