+// OrbitBrowserWindow -----------------------------------------------------------
+
+OrbitBrowserWindow::OrbitBrowserWindow(uint64_t window_token, Profile* profile)
+    : window_token_(window_token), profile_(profile) {
+  CHECK(profile_);
+}
+
+OrbitBrowserWindow::~OrbitBrowserWindow() {
+  if (browser_) {
+    // BrowserWindow implementations tear down the window features before
+    // destruction (as TestBrowserWindow and WebUIBrowserWindow do).
+    browser_->GetFeatures().TearDownPreBrowserWindowDestruction();
+    LogicalBrowserDestroyed(window_token_, browser_);
+    location_bar_.browser_ = nullptr;
+    browser_ = nullptr;
+  }
+}
+
+void OrbitBrowserWindow::SetBrowser(Browser* browser) {
+  CHECK(!browser_);
+  browser_ = browser;
+  location_bar_.browser_ = browser;
+}
+
+bool OrbitBrowserWindow::IsVisible() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && [window isVisible];
+}
+
+void OrbitBrowserWindow::Close() {
+  // Never closes the Orbit NSWindow. Called by Browser::TabStripEmpty() when
+  // the last tab left, or by Chrome (windows.remove, shutdown) to close every
+  // tab of this logical Browser. As in WebUIBrowserWindow, unload handlers may
+  // cancel; once the tab strip is empty UnloadController schedules the
+  // Browser destruction, which deletes this object.
+  if (!browser_) {
+    return;
+  }
+  // A transfer in progress keeps the emptied Browser (side API v3).
+  if (browser_->tab_strip_model()->empty() && IsWindowHeld(window_token_)) {
+    close_deferred_ = true;
+    return;
+  }
+  close_deferred_ = false;
+  UnloadController::From(browser_)->OnWindowClosing();
+}
+
+void OrbitBrowserWindow::CloseIfDeferred() {
+  const bool deferred = close_deferred_;
+  close_deferred_ = false;
+  if (deferred && browser_ && browser_->tab_strip_model()->empty()) {
+    UnloadController::From(browser_)->OnWindowClosing();
+  }
+}
+
+bool OrbitBrowserWindow::IsActive() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && [window isKeyWindow];
+}
+
+ui::ZOrderLevel OrbitBrowserWindow::GetZOrderLevel() const {
+  return ui::ZOrderLevel::kNormal;
+}
+
+gfx::NativeWindow OrbitBrowserWindow::GetNativeWindow() const {
+  return orbit::GetNativeWindow(window_token_);
+}
+
+bool OrbitBrowserWindow::IsOnCurrentWorkspace() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && [window isOnActiveSpace];
+}
+
+bool OrbitBrowserWindow::IsVisibleOnScreen() const {
+  NSWindow* window = OrbitNSWindow(window_token_);
+  return window && [window isVisible] &&
+         ([window occlusionState] & NSWindowOcclusionStateVisible);
+}
+
+bool OrbitBrowserWindow::DoBrowserControlsShrinkRendererSize(
+    const content::WebContents* contents) const {
