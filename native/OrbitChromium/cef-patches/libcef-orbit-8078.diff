diff --git a/libcef/browser/orbit/orbit_cef_api.h b/libcef/browser/orbit/orbit_cef_api.h
new file mode 100644
index 0000000..16887a6
--- /dev/null
+++ b/libcef/browser/orbit/orbit_cef_api.h
@@ -0,0 +1,131 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+//
+// Orbit side API of the patched CEF (branch orbit/8078). This header is plain C
+// and is copied verbatim into the Orbit bridge; it is not part of the public
+// CEF API (cef/include is unchanged, so no translator.py and no API hash).
+//
+// The bridge resolves the single exported symbol `orbit_cef_get_api` with
+// dlsym() on the loaded framework. A stock CEF build does not export it, which
+// is how the bridge tells the two apart (ACRPatchLevel() == 0).
+//
+// Threading: every function must be called on the CEF UI thread (the main
+// thread on macOS) after CefInitialize() and before CefShutdown().
+
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_CEF_API_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_CEF_API_H_
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Version 1 (ENG-X2.1): one logical Chrome Browser per (Orbit window, profile),
+// Chrome-style tabs whose content NSView is placed by Orbit.
+// Version 2 (CHROMIUM-APP-R2): additive, move_tab. A table requested as version
+// 1 reports version 1 and keeps the version 1 layout as its prefix.
+// Version 3 (CHROMIUM-APP-R3): additive, hold_window/release_window. Earlier
+// versions keep their layout as the prefix of the table.
+#define ORBIT_CEF_API_VERSION 3u
+
+typedef struct {
+  uint32_t struct_size;
+  // Extension tab id (SessionTabHelper), -1 when the tab has none.
+  int32_t tab_id;
+  // Extension window id (SessionID of the logical Browser), -1 when the tab is
+  // not in a Browser.
+  int32_t window_id;
+  // Index in the Browser's TabStripModel, -1 when absent.
+  int32_t index;
+  // 1 when the tab is the active tab of its Browser.
+  int32_t active;
+  // 1 when the browser is an Orbit hosted Chrome-style tab.
+  int32_t hosted;
+  // Orbit window token of the Browser, 0 when none.
+  uint64_t window_token;
+} orbit_tab_info_t;
+
+typedef struct {
+  uint32_t struct_size;
+  uint32_t version;
+
+  // Registers an Orbit window. `nswindow` is a borrowed NSWindow* that must
+  // outlive the registration (call window_destroyed before releasing it).
+  // Returns 1 on success, 0 if the token is in use or invalid.
+  int32_t (*window_created)(uint64_t window_token, void* nswindow);
+  // Unregisters an Orbit window. Logical Browsers that still own tabs lose
+  // their native window and close when their last tab closes. Returns the
+  // number of logical Browsers that were still alive, or -1 if unknown.
+  int32_t (*window_destroyed)(uint64_t window_token);
+  // Key-window state: DidBecomeActive/DidBecomeInactive on every logical
+  // Browser of the window (windows.onFocusChanged). Returns 1 if known.
+  int32_t (*window_activation_changed)(uint64_t window_token, int32_t active);
+  // Notifies extension listeners of new window bounds
+  // (windows.onBoundsChanged). Returns 1 if known.
+  int32_t (*window_bounds_changed)(uint64_t window_token);
+
+  // Marks `parent_nsview` so that the next CefBrowserHost::CreateBrowser[Sync]
+  // or OnBeforePopup whose CefWindowInfo.parent_view equals it creates a
+  // Chrome-style tab at `index` (-1 appends) in the logical Browser of
+  // (window_token, request context profile). The mark is consumed by that
+  // creation. Returns 1 when registered.
+  int32_t (*prepare_hosted_tab)(void* parent_nsview,
+                                uint64_t window_token,
+                                int32_t index);
+  // Removes a mark that was not consumed. Returns 1 if a mark was removed.
+  int32_t (*cancel_hosted_tab)(void* parent_nsview);
+
+  // Moves the content NSView of a hosted tab under `parent_nsview` (same
+  // logical Browser). Returns 1 on success.
+  int32_t (*attach_view)(int32_t browser_id, void* parent_nsview);
+  // Activates a hosted tab in its TabStripModel (tabs.onActivated).
+  int32_t (*activate_tab)(int32_t browser_id);
+  // Fills `info` for any CEF browser id. Returns 1 when the browser exists.
+  int32_t (*get_tab_info)(int32_t browser_id, orbit_tab_info_t* info);
+
+  // Diagnostics: live logical Browsers of a window (all profiles), or -1.
+  int32_t (*window_browser_count)(uint64_t window_token);
+
+  // Version 2. Moves a hosted tab to `index` (-1 or past the end appends) of
+  // the logical Browser of (window_token, the tab's profile), created when
+  // needed, through TabStripModel::DetachTabAtForInsertion and
+  // InsertDetachedTabAt (the path of tabs.move and of Chrome's tab dragging).
+  // The WebContents, CEF browser and browser id, extension tab id, opener,
+  // history, form and script state are kept; extensions see tabs.onDetached
+  // and tabs.onAttached. The source logical Browser closes with its last tab.
+  // When the tab already is in that Browser, it is reordered to `index`
+  // instead (tabs.onMoved). Then, when `parent_nsview` is not NULL, the
+  // content NSView is placed under it. Never activates the tab. Returns 1 on
+  // success; 0, with nothing changed, when the browser is not a hosted tab of
+  // a logical Browser, is closing, or the window is unknown.
+  int32_t (*move_tab)(int32_t browser_id,
+                      uint64_t window_token,
+                      int32_t index,
+                      void* parent_nsview);
+  // Version 2. 1 while Chrome's ProfileManager still has a loaded Profile for
+  // the absolute profile directory `path` (it unloads it after the last
+  // CefRequestContext and browser of the profile are gone), 0 when none is
+  // loaded, -1 when unknown. Never loads a profile. Lets a profile directory be
+  // removed only once Chrome no longer writes to it.
+  int32_t (*profile_loaded)(const char* path);
+
+  // Version 3. Holds the logical Browsers of an Orbit window for a tab transfer:
+  // while held, a Browser whose last tab moved away stays alive (same window
+  // id) so that a rollback can return the tab to it; releasing the last hold
+  // closes those still empty. Returns the hold count after the call, -1 for an
+  // unknown (or, for release, unheld) window. Destroying the window releases
+  // every hold.
+  int32_t (*hold_window)(uint64_t window_token);
+  int32_t (*release_window)(uint64_t window_token);
+} orbit_cef_api_t;
+
+// Returns the API table for `version`, or NULL when unsupported.
+typedef const orbit_cef_api_t* (*orbit_cef_get_api_t)(uint32_t version);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_CEF_API_H_
diff --git a/libcef/browser/orbit/orbit_cef_api.mm b/libcef/browser/orbit/orbit_cef_api.mm
new file mode 100644
index 0000000..c92848a
--- /dev/null
+++ b/libcef/browser/orbit/orbit_cef_api.mm
@@ -0,0 +1,314 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_cef_api.h"
+
+#import <AppKit/AppKit.h>
+
+#include "cef/include/internal/cef_export.h"
+#include "cef/libcef/browser/orbit/orbit_hosted.h"
+#include "cef/libcef/browser/orbit/orbit_hosted_mac.h"
+#include "cef/libcef/browser/orbit/browser_platform_delegate_chrome_hosted.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/chrome/chrome_browser_host_impl.h"
+#include "cef/libcef/browser/context.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "base/files/file_path.h"
+#include "chrome/browser/browser_process.h"
+#include "chrome/browser/extensions/browser_extension_window_controller.h"
+#include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/browser_active_state_manager/browser_active_state_manager.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+
+namespace {
+
+bool OnValidUIThread() {
+  return CONTEXT_STATE_VALID() && CEF_CURRENTLY_ON_UIT();
+}
+
+int32_t WindowCreated(uint64_t window_token, void* nswindow) {
+  if (!OnValidUIThread() || !nswindow) {
+    return 0;
+  }
+  NSWindow* window = (__bridge NSWindow*)nswindow;
+  if (![window isKindOfClass:[NSWindow class]]) {
+    return 0;
+  }
+  return orbit::WindowCreated(window_token, window) ? 1 : 0;
+}
+
+int32_t WindowDestroyed(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return orbit::WindowDestroyed(window_token);
+}
+
+int32_t WindowActivationChanged(uint64_t window_token, int32_t active) {
+  if (!OnValidUIThread() || !orbit::IsKnownWindow(window_token)) {
+    return 0;
+  }
+  for (Browser* browser : orbit::GetLogicalBrowsers(window_token)) {
+    auto* manager = BrowserActiveStateManager::From(browser);
+    if (!manager) {
+      continue;
+    }
+    if (active) {
+      manager->DidBecomeActive();
+    } else {
+      manager->DidBecomeInactive();
+    }
+  }
+  return 1;
+}
+
+int32_t WindowBoundsChanged(uint64_t window_token) {
+  if (!OnValidUIThread() || !orbit::IsKnownWindow(window_token)) {
+    return 0;
+  }
+  for (Browser* browser : orbit::GetLogicalBrowsers(window_token)) {
+    // Same notification as BrowserView::TryNotifyWindowBoundsChanged().
+    if (auto* controller =
+            extensions::BrowserExtensionWindowController::From(browser)) {
+      controller->NotifyWindowBoundsChanged();
+    }
+  }
+  return 1;
+}
+
+int32_t PrepareHostedTab(void* parent_nsview,
+                         uint64_t window_token,
+                         int32_t index) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  return orbit::PrepareHostedTab(
+             CAST_NSVIEW_TO_CEF_WINDOW_HANDLE((__bridge NSView*)parent_nsview),
+             window_token, index)
+             ? 1
+             : 0;
+}
+
+int32_t CancelHostedTab(void* parent_nsview) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  return orbit::CancelHostedTab(CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+             (__bridge NSView*)parent_nsview))
+             ? 1
+             : 0;
+}
+
+int32_t AttachView(int32_t browser_id, void* parent_nsview) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  auto* delegate =
+      CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id);
+  if (!delegate) {
+    return 0;
+  }
+  return delegate->AttachToParent(CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+             (__bridge NSView*)parent_nsview))
+             ? 1
+             : 0;
+}
+
+CefRefPtr<ChromeBrowserHostImpl> GetChromeHost(int32_t browser_id) {
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!host || !host->IsChromeStyle()) {
+    return nullptr;
+  }
+  return ChromeBrowserHostImpl::FromBaseChecked(host);
+}
+
+int32_t ActivateTab(int32_t browser_id) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->browser() ||
+      !CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id)) {
+    return 0;
+  }
+  auto* model = host->browser()->tab_strip_model();
+  const int index = model->GetIndexOfWebContents(host->GetWebContents());
+  if (index == TabStripModel::kNoTab) {
+    return 0;
+  }
+  model->ActivateTabAt(index);
+  return 1;
+}
+
+int32_t GetTabInfo(int32_t browser_id, orbit_tab_info_t* info) {
+  if (!OnValidUIThread() || !info ||
+      info->struct_size < sizeof(orbit_tab_info_t)) {
+    return 0;
+  }
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!host) {
+    return 0;
+  }
+  info->tab_id = -1;
+  info->window_id = -1;
+  info->index = -1;
+  info->active = 0;
+  info->hosted = 0;
+  info->window_token = 0;
+  auto* contents = host->GetWebContents();
+  if (!contents) {
+    return 1;
+  }
+  info->tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  info->window_id = extensions::ExtensionTabUtil::GetWindowIdOfTab(contents);
+  if (auto* delegate =
+          CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id)) {
+    info->hosted = 1;
+    info->window_token = delegate->window_token();
+  }
+  if (host->IsChromeStyle()) {
+    auto chrome_host = ChromeBrowserHostImpl::FromBaseChecked(host);
+    if (Browser* browser = chrome_host->browser()) {
+      auto* model = browser->tab_strip_model();
+      info->index = model->GetIndexOfWebContents(contents);
+      info->active = info->index != TabStripModel::kNoTab &&
+                             info->index == model->active_index()
+                         ? 1
+                         : 0;
+    }
+  }
+  return 1;
+}
+
+int32_t WindowBrowserCount(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return static_cast<int32_t>(orbit::GetLogicalBrowsers(window_token).size());
+}
+
+int32_t MoveTab(int32_t browser_id,
+                uint64_t window_token,
+                int32_t index,
+                void* parent_nsview) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->OrbitMoveToWindow(window_token, index)) {
+    return 0;
+  }
+  if (parent_nsview) {
+    if (auto* delegate =
+            CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id)) {
+      delegate->AttachToParent(CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+          (__bridge NSView*)parent_nsview));
+    }
+  }
+  return 1;
+}
+
+int32_t ProfileLoaded(const char* path) {
+  if (!OnValidUIThread() || !path || path[0] != '/' || !g_browser_process) {
+    return -1;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return -1;
+  }
+  return manager->GetProfileByPath(base::FilePath(path)) ? 1 : 0;
+}
+
+int32_t HoldWindow(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return orbit::HoldWindow(window_token);
+}
+
+int32_t ReleaseWindow(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return orbit::ReleaseWindow(window_token);
+}
+
+// Version 1 callers check `version == 1` and a size of at least their layout;
+// later versions keep the earlier layouts as their prefix.
+const orbit_cef_api_t kApiV1 = {
+    sizeof(orbit_cef_api_t),
+    1u,
+    &WindowCreated,
+    &WindowDestroyed,
+    &WindowActivationChanged,
+    &WindowBoundsChanged,
+    &PrepareHostedTab,
+    &CancelHostedTab,
+    &AttachView,
+    &ActivateTab,
+    &GetTabInfo,
+    &WindowBrowserCount,
+    &MoveTab,
+    &ProfileLoaded,
+    &HoldWindow,
+    &ReleaseWindow,
+};
+
+const orbit_cef_api_t kApiV2 = {
+    sizeof(orbit_cef_api_t),
+    2u,
+    &WindowCreated,
+    &WindowDestroyed,
+    &WindowActivationChanged,
+    &WindowBoundsChanged,
+    &PrepareHostedTab,
+    &CancelHostedTab,
+    &AttachView,
+    &ActivateTab,
+    &GetTabInfo,
+    &WindowBrowserCount,
+    &MoveTab,
+    &ProfileLoaded,
+    &HoldWindow,
+    &ReleaseWindow,
+};
+
+const orbit_cef_api_t kApiV3 = {
+    sizeof(orbit_cef_api_t),
+    3u,
+    &WindowCreated,
+    &WindowDestroyed,
+    &WindowActivationChanged,
+    &WindowBoundsChanged,
+    &PrepareHostedTab,
+    &CancelHostedTab,
+    &AttachView,
+    &ActivateTab,
+    &GetTabInfo,
+    &WindowBrowserCount,
+    &MoveTab,
+    &ProfileLoaded,
+    &HoldWindow,
+    &ReleaseWindow,
+};
+
+}  // namespace
+
+extern "C" CEF_EXPORT const orbit_cef_api_t* orbit_cef_get_api(uint32_t version);
+
+extern "C" CEF_EXPORT const orbit_cef_api_t* orbit_cef_get_api(
+    uint32_t version) {
+  switch (version) {
+    case 1u:
+      return &kApiV1;
+    case 2u:
+      return &kApiV2;
+    case 3u:
+      return &kApiV3;
+    default:
+      return nullptr;
+  }
+}
diff --git a/libcef/browser/orbit/orbit_hosted.h b/libcef/browser/orbit/orbit_hosted.h
new file mode 100644
index 0000000..403e59d
--- /dev/null
+++ b/libcef/browser/orbit/orbit_hosted.h
@@ -0,0 +1,90 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_H_
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+#include "cef/include/cef_browser.h"
+#include "cef/libcef/browser/orbit/orbit_hosted_intent.h"
+#include "ui/gfx/native_ui_types.h"
+
+class Browser;
+class Profile;
+struct CefBrowserCreateParams;
+
+// Orbit "hosted Chrome" mode (ENG-X2, variant D-chrome).
+//
+// Every Orbit window x profile owns one invisible logical Chrome Browser
+// (TYPE_NORMAL) whose BrowserWindow is an AppKit, Views-free
+// OrbitBrowserWindow. Orbit tabs are Chrome-style CEF browsers living in that
+// Browser's TabStripModel; Orbit keeps placing their content NSView. All state
+// is UI-thread only.
+namespace orbit {
+
+// Parent marks (see orbit_cef_api_t::prepare_hosted_tab).
+bool PrepareHostedTab(CefWindowHandle parent_view,
+                      uint64_t window_token,
+                      int index);
+bool CancelHostedTab(CefWindowHandle parent_view);
+// Consumes the mark for |parent_view|.
+std::optional<HostedTabRequest> TakeHostedTab(CefWindowHandle parent_view);
+
+// Orbit windows. WindowCreated(token, NSWindow*) is declared in
+// orbit_hosted_mac.h.
+int WindowDestroyed(uint64_t window_token);
+bool IsKnownWindow(uint64_t window_token);
+// Generation of a known (registered, not destroyed) window, for a moved tab.
+std::optional<uint64_t> GetWindowGeneration(uint64_t window_token);
+bool IsHostedRequestLive(const HostedTabRequest& request);
+gfx::NativeWindow GetNativeWindow(uint64_t window_token);
+
+// Transfer holds (side API v3). While a window is held, its emptied logical
+// Browsers stay alive; releasing the last hold closes those still empty.
+// Return the remaining hold count, or -1 for an unknown window.
+int HoldWindow(uint64_t window_token);
+int ReleaseWindow(uint64_t window_token);
+bool IsWindowHeld(uint64_t window_token);
+// Drops a logical Browser that Chrome is already destroying from its window
+// record, so that a new one can take its place (it unregisters itself later).
+void ForgetLogicalBrowser(uint64_t window_token, Browser* browser);
+
+// Logical Browsers, one per (window, profile).
+Browser* GetLogicalBrowser(uint64_t window_token, Profile* profile);
+void RegisterLogicalBrowser(uint64_t window_token,
+                            Profile* profile,
+                            Browser* browser);
+// Called by OrbitBrowserWindow when its Browser goes away.
+void LogicalBrowserDestroyed(uint64_t window_token, Browser* browser);
+std::vector<Browser*> GetLogicalBrowsers(uint64_t window_token);
+
+// Per-tab creation parameters. A logical Browser is shared by several Orbit
+// surfaces with different CefClients and parent views, while
+// ChromeBrowserDelegate keeps the parameters of the Browser's first tab. The
+// hosted creation path publishes the parameters of the tab being inserted;
+// ChromeBrowserDelegate::SetAsDelegate consumes them.
+class ScopedPendingTab {
+ public:
+  ScopedPendingTab(Browser* browser, const CefBrowserCreateParams& params);
+  ScopedPendingTab(const ScopedPendingTab&) = delete;
+  ScopedPendingTab& operator=(const ScopedPendingTab&) = delete;
+  ~ScopedPendingTab();
+
+ private:
+  Browser* const browser_;
+};
+
+// Returns true and fills |params| when |browser| has a pending Orbit tab.
+bool TakePendingTab(Browser* browser, CefBrowserCreateParams* params);
+
+// True when |browser| is a logical Browser owned by an Orbit window.
+bool IsLogicalBrowser(const Browser* browser);
+
+}  // namespace orbit
+
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_HOSTED_H_
diff --git a/libcef/browser/orbit/orbit_hosted.mm b/libcef/browser/orbit/orbit_hosted.mm
new file mode 100644
index 0000000..b6f62b7
--- /dev/null
+++ b/libcef/browser/orbit/orbit_hosted.mm
@@ -0,0 +1,257 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_hosted.h"
+#include "cef/libcef/browser/orbit/orbit_hosted_mac.h"
+
+#import <AppKit/AppKit.h>
+
+#include <map>
+#include <vector>
+#include <utility>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "cef/libcef/browser/orbit/orbit_browser_window.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+
+namespace orbit {
+
+namespace {
+
+struct WindowRecord {
+  __weak NSWindow* window = nil;
+  std::map<Profile*, Browser*> browsers;
+  int holds = 0;
+};
+
+// Every logical Browser's BrowserWindow is an OrbitBrowserWindow.
+OrbitBrowserWindow* OrbitWindowOf(Browser* browser) {
+  return static_cast<OrbitBrowserWindow*>(static_cast<BrowserWindow*>(browser->GetWindow()));
+}
+
+void CloseDeferred(const std::map<Profile*, Browser*>& browsers) {
+  std::vector<Browser*> snapshot;
+  for (const auto& [profile, browser] : browsers) {
+    snapshot.push_back(browser);
+  }
+  for (Browser* browser : snapshot) {
+    OrbitWindowOf(browser)->CloseIfDeferred();
+  }
+}
+
+struct Registry {
+  std::map<uint64_t, WindowRecord> windows;
+  HostedCreationPolicy creation_policy;
+  std::map<Browser*, CefBrowserCreateParams> pending_tabs;
+  std::map<const Browser*, uint64_t> logical_browsers;
+};
+
+Registry& GetRegistry() {
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+
+}  // namespace
+
+bool PrepareHostedTab(CefWindowHandle parent_view,
+                      uint64_t window_token,
+                      int index) {
+  return GetRegistry().creation_policy.Prepare(parent_view, window_token, index);
+}
+
+bool CancelHostedTab(CefWindowHandle parent_view) {
+  return GetRegistry().creation_policy.Cancel(parent_view);
+}
+
+std::optional<HostedTabRequest> TakeHostedTab(CefWindowHandle parent_view) {
+  return GetRegistry().creation_policy.Take(parent_view);
+}
+
+bool IsHostedRequestLive(const HostedTabRequest& request) {
+  return GetRegistry().creation_policy.IsLive(request) &&
+         IsKnownWindow(request.window_token);
+}
+
+bool WindowCreated(uint64_t window_token, NSWindow* window) {
+  auto& windows = GetRegistry().windows;
+  if (!window_token || !window || windows.contains(window_token)) {
+    return false;
+  }
+  CHECK(GetRegistry().creation_policy.RegisterWindow(window_token));
+  windows[window_token].window = window;
+  return true;
+}
+
+int WindowDestroyed(uint64_t window_token) {
+  auto& registry = GetRegistry();
+  auto it = registry.windows.find(window_token);
+  if (it == registry.windows.end()) {
+    return -1;
+  }
+  const int live = static_cast<int>(it->second.browsers.size());
+  // Browsers that still own tabs keep their window token; they report a null
+  // native window from now on and close with their last tab. Emptied Browsers
+  // kept by a transfer hold close now.
+  it->second.window = nil;
+  it->second.holds = 0;
+  if (live == 0) {
+    registry.windows.erase(it);
+  } else {
+    CloseDeferred(std::map<Profile*, Browser*>(it->second.browsers));
+  }
+  // Do not erase an unconsumed mark: it still identifies a cancelled hosted
+  // request and must never be reinterpreted as an ordinary Alloy request.
+  registry.creation_policy.UnregisterWindow(window_token);
+  return live;
+}
+
+bool IsKnownWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  return it != windows.end() && it->second.window != nil;
+}
+
+std::optional<uint64_t> GetWindowGeneration(uint64_t window_token) {
+  if (!IsKnownWindow(window_token)) {
+    return std::nullopt;
+  }
+  return GetRegistry().creation_policy.Generation(window_token);
+}
+
+gfx::NativeWindow GetNativeWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end() || it->second.window == nil) {
+    return gfx::NativeWindow();
+  }
+  return gfx::NativeWindow(it->second.window);
+}
+
+int HoldWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end() || it->second.window == nil) {
+    return -1;
+  }
+  return ++it->second.holds;
+}
+
+int ReleaseWindow(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end() || it->second.holds <= 0) {
+    return -1;
+  }
+  const int remaining = --it->second.holds;
+  if (remaining == 0) {
+    // May destroy Browsers later (UnloadController); the record stays valid.
+    CloseDeferred(std::map<Profile*, Browser*>(it->second.browsers));
+  }
+  return remaining;
+}
+
+bool IsWindowHeld(uint64_t window_token) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  return it != windows.end() && it->second.holds > 0;
+}
+
+void ForgetLogicalBrowser(uint64_t window_token, Browser* browser) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end()) {
+    return;
+  }
+  for (auto entry = it->second.browsers.begin(); entry != it->second.browsers.end(); ++entry) {
+    if (entry->second == browser) {
+      it->second.browsers.erase(entry);
+      return;
+    }
+  }
+}
+
+Browser* GetLogicalBrowser(uint64_t window_token, Profile* profile) {
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it == windows.end()) {
+    return nullptr;
+  }
+  auto browser = it->second.browsers.find(profile);
+  return browser == it->second.browsers.end() ? nullptr : browser->second;
+}
+
+void RegisterLogicalBrowser(uint64_t window_token,
+                            Profile* profile,
+                            Browser* browser) {
+  auto& registry = GetRegistry();
+  auto it = registry.windows.find(window_token);
+  CHECK(it != registry.windows.end());
+  CHECK(!it->second.browsers.contains(profile));
+  it->second.browsers[profile] = browser;
+  registry.logical_browsers[browser] = window_token;
+}
+
+void LogicalBrowserDestroyed(uint64_t window_token, Browser* browser) {
+  auto& registry = GetRegistry();
+  registry.logical_browsers.erase(browser);
+  registry.pending_tabs.erase(browser);
+  auto it = registry.windows.find(window_token);
+  if (it == registry.windows.end()) {
+    return;
+  }
+  for (auto entry = it->second.browsers.begin();
+       entry != it->second.browsers.end(); ++entry) {
+    if (entry->second == browser) {
+      it->second.browsers.erase(entry);
+      break;
+    }
+  }
+  if (it->second.window == nil && it->second.browsers.empty()) {
+    registry.windows.erase(it);
+  }
+}
+
+std::vector<Browser*> GetLogicalBrowsers(uint64_t window_token) {
+  std::vector<Browser*> result;
+  auto& windows = GetRegistry().windows;
+  auto it = windows.find(window_token);
+  if (it != windows.end()) {
+    for (const auto& [profile, browser] : it->second.browsers) {
+      result.push_back(browser);
+    }
+  }
+  return result;
+}
+
+ScopedPendingTab::ScopedPendingTab(Browser* browser,
+                                   const CefBrowserCreateParams& params)
+    : browser_(browser) {
+  auto& pending = GetRegistry().pending_tabs;
+  pending.erase(browser_);
+  pending.emplace(browser_, params);
+}
+
+ScopedPendingTab::~ScopedPendingTab() {
+  GetRegistry().pending_tabs.erase(browser_);
+}
+
+bool TakePendingTab(Browser* browser, CefBrowserCreateParams* params) {
+  auto& pending = GetRegistry().pending_tabs;
+  auto it = pending.find(browser);
+  if (it == pending.end()) {
+    return false;
+  }
+  *params = it->second;
+  pending.erase(it);
+  return true;
+}
+
+bool IsLogicalBrowser(const Browser* browser) {
+  return GetRegistry().logical_browsers.contains(browser);
+}
+
+}  // namespace orbit
diff --git a/libcef/browser/orbit/orbit_hosted_intent.h b/libcef/browser/orbit/orbit_hosted_intent.h
