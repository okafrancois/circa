+Browser* ChromeBrowserHostImpl::GetOrCreateOrbitBrowser(
+    const CefBrowserCreateParams& params) {
+  if (!orbit::IsHostedRequestLive({params.orbit_window_token,
+                                  params.orbit_tab_index,
+                                  params.orbit_window_generation})) {
+    return nullptr;
+  }
+  auto* profile = CefRequestContextImpl::GetProfile(params.request_context);
+  if (auto* existing =
+          orbit::GetLogicalBrowser(params.orbit_window_token, profile)) {
+    if (!existing->IsDeleteScheduled()) {
+      return existing;
+    }
+    // CHROMIUM-APP-R3: the window's previous Browser emptied and is being
+    // destroyed (a transfer without hold). A tab coming back gets a new one.
+    orbit::ForgetLogicalBrowser(params.orbit_window_token, existing);
+  }
+  if (!orbit::IsKnownWindow(params.orbit_window_token)) {
+    return nullptr;
+  }
+
+  BrowserWindowCreateParams chrome_params(profile,
+                                          /*from_user_gesture=*/false);
+  // A real TYPE_NORMAL Browser (tabs, windows and extension APIs see it), but
+  // never restored by Chrome: the session belongs to Orbit.
+  chrome_params.omit_from_session_restore = true;
+  chrome_params.should_trigger_session_restore = false;
+  chrome_params.cef_params = base::MakeRefCounted<DelegateCreateParams>(params);
