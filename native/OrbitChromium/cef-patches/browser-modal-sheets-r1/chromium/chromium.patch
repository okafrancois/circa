+  [parent setFrameOrigin:NSMakePoint(parent.frame.origin.x + 30,
+                                     parent.frame.origin.y + 20)];
+  EXPECT_EQ(before.x + 30, popup.frame.origin.x);
+  EXPECT_EQ(before.y + 20, popup.frame.origin.y);
+  [parent close];
+  EXPECT_TRUE(widget->IsClosed());
