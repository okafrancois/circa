+
+TEST_F(ConstrainedWindowAppKitParentTest,
+       ParentCloseClosesItsBrowserModalSheetOnly) {
+  NSWindow* parent = MakeParent();
+  NSWindow* other = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  remote_cocoa::ScopedAppKitModalParent other_registration{
+      gfx::NativeWindow(other)};
+  [parent orderFront:nil];
+  [other orderFront:nil];
+  Dialog dialog(parent, ui::mojom::ModalType::kWindow);
+  Dialog other_dialog(other, ui::mojom::ModalType::kWindow);
+  dialog.widget->ShowInactive();
+  other_dialog.widget->ShowInactive();
