+// Browser-modal (kWindow) dialogs are presented as the parent's sheet: the
+// adapter never orders a child window and defers a show the hidden parent
+// cannot present. Every window stays hidden.
+TEST_F(AppKitModalParentTest, SheetPresentationDefersWhileParentCannotShow) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  int shows = 0;
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([]() {}),
+      AppKitModalDialogParent::Presentation::kSheet,
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&shows)));
+  ASSERT_TRUE(adapter);
+  EXPECT_TRUE(adapter->IsSheet());
+  adapter->SetWantsVisible(true);
+  EXPECT_FALSE(adapter->PrepareToShow());
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:NSWindowDidBecomeKeyNotification
+                    object:parent];
+  EXPECT_EQ(0, shows);
+  EXPECT_EQ(nil, child.parentWindow);
+  EXPECT_EQ(nil, parent.attachedSheet);
+  EXPECT_FALSE(child.visible);
+  adapter->SetWantsVisible(false);
+  EXPECT_EQ(nil, child.parentWindow);
+  adapter.reset();
+  [child close];
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest, ChildWindowPresentationRemainsTheDefault) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([]() {}));
+  ASSERT_TRUE(adapter);
+  EXPECT_FALSE(adapter->IsSheet());
+  adapter.reset();
+  [child close];
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest, SheetParentCloseClosesChildAndStaysTerminal) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  int closes = 0, shows = 0;
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&closes)),
+      AppKitModalDialogParent::Presentation::kSheet,
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&shows)));
+  adapter->SetWantsVisible(true);
+  EXPECT_FALSE(adapter->PrepareToShow());
+  [parent close];
+  EXPECT_EQ(1, closes);
+  EXPECT_TRUE(adapter->ParentIsClosed());
+  EXPECT_FALSE(adapter->PrepareToShow());
+  EXPECT_EQ(0, shows);
+  adapter.reset();
+  [child close];
+}
