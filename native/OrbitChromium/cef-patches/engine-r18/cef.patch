diff --git a/libcef/browser/orbit/orbit_devtools.inc b/libcef/browser/orbit/orbit_devtools.inc
new file mode 100644
--- /dev/null
+++ b/libcef/browser/orbit/orbit_devtools.inc
@@ -0,0 +1,335 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Authors and the
+// Chromium Embedded Framework Authors. All rights reserved. BSD-style license.
+// Included once by the private Objective-C++ side API translation unit.
+#include "cef/libcef/browser/orbit/orbit_devtools.h"
+#include "base/no_destructor.h"
+#include "base/auto_reset.h"
+#include <map>
+#include <memory>
+#include <string>
+#include "base/strings/utf_string_conversions.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/devtools/devtools_contents_resizing_strategy.h"
+#include "chrome/browser/devtools/devtools_ui_bindings.h"
+#include "chrome/browser/devtools/devtools_window.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace orbit {
+namespace {
+class HostedDevTools;
+using DevToolsHosts = std::map<int, std::unique_ptr<HostedDevTools>>;
+DevToolsHosts& GetDevToolsHosts() {
+  static base::NoDestructor<DevToolsHosts> hosts;
+  return *hosts;
+}
+
+int HostedBrowserID(content::WebContents* contents) {
+  auto host = CefBrowserHostBase::GetBrowserForContents(contents);
+  if (!host || !CefBrowserPlatformDelegateChromeHosted::FromBrowserId(host->GetIdentifier())) return 0;
+  return host->GetIdentifier();
+}
+
+class FrontendObservation final : public content::WebContentsObserver {
+ public:
+  FrontendObservation(content::WebContents* frontend, HostedDevTools* owner)
+      : content::WebContentsObserver(frontend), owner_(owner) {}
+  void WebContentsDestroyed() override;
+ private:
+  raw_ptr<HostedDevTools> owner_;
+};
+
+class HostedDevTools final : public content::WebContentsObserver {
+ public:
+  HostedDevTools(int id, content::WebContents* inspected, NSView* root, NSView* document,
+                 NSView* container, orbit_devtools_changed_t callback, void* context)
+      : content::WebContentsObserver(inspected), id_(id),
+        inspected_(inspected->GetWeakPtr()), root_(root), document_(document), container_(container),
+        callback_(callback), context_(context) {}
+  ~HostedDevTools() override {
+    callback_ = nullptr;
+    frontend_observation_.reset();
+    [frontend_view_ removeFromSuperview];
+    [toolbox_view_ removeFromSuperview];
+  }
+
+  bool live() const { return inspected_ && root_ && document_ && container_; }
+  int state() const { return state_; }
+  content::WebContents* frontend() const { return frontend_.get(); }
+  void Rebind(NSView* root, NSView* document, NSView* container, orbit_devtools_changed_t callback, void* context) {
+    root_ = root; document_ = document; container_ = container; callback_ = callback; context_ = context;
+    Layout();
+    Notify(false, true);
+  }
+  void SetFrontend(content::WebContents* frontend) {
+    if (frontend_.get() == frontend) return;
+    frontend_ = frontend->GetWeakPtr();
+    frontend_observation_ = std::make_unique<FrontendObservation>(frontend, this);
+    frontend_view_ = frontend->GetNativeView().GetNativeNSView();
+    container_.frame = root_.bounds;
+    [container_ addSubview:frontend_view_];
+    frontend_view_.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+    frontend_view_.frame = container_.bounds;
+    frontend->WasShown();
+    state_ = 5;
+    Notify(false);
+  }
+  void Present(content::WebContents* frontend, bool docked,
+               const DevToolsContentsResizingStrategy& strategy) {
+    if (!live()) return;
+    SetFrontend(frontend);
+    docked_ = docked;
+    strategy_.CopyFrom(strategy);
+    state_ = docked ? DockState(strategy) : 4;
+    Layout();
+    Notify(true);
+  }
+  bool Refresh() {
+    if (!live() || !frontend_) return false;
+    DevToolsContentsResizingStrategy strategy;
+    auto* in_tab = DevToolsWindow::GetInTabWebContents(inspected_.get(), &strategy);
+    if (in_tab) {
+      strategy_.CopyFrom(strategy);
+      if (docked_) state_ = DockState(strategy);
+    }
+    Layout();
+    Notify(false);
+    return true;
+  }
+  bool Layout() {
+    if (laying_out_ || !live() || !frontend_) return false;
+    base::AutoReset<bool> applying_layout(&laying_out_, true);
+    NSView* root = root_;
+    NSView* page = document_;
+    NSView* container = container_;
+    if (!container) return false;
+    if (frontend_view_.superview == container) frontend_view_.frame = container.bounds;
+    if (!page || page.superview != root) return true;
+    if (docked_ || state_ == 5) {
+      if (container.superview == root) container.frame = root.bounds;
+    }
+    if (frontend_view_.superview == container) frontend_view_.frame = container.bounds;
+    DevToolsContentsResizingStrategy current;
+    content::WebContents* in_tab = DevToolsWindow::GetInTabWebContents(inspected_.get(), &current);
+    // When device emulation remains in the page while the main frontend is
+    // undocked, Chromium owns a separate toolbox WebContents for that viewport.
+    NSView* toolbox = in_tab && in_tab != frontend_.get()
+        ? in_tab->GetNativeView().GetNativeNSView() : nil;
+    if (toolbox_view_ != toolbox) {
+      [toolbox_view_ removeFromSuperview];
+      toolbox_view_ = toolbox;
+    }
+    if (toolbox && toolbox.superview != root) [root addSubview:toolbox positioned:NSWindowBelow relativeTo:page];
+    if (toolbox) toolbox.frame = root.bounds;
+    if (in_tab) strategy_.CopyFrom(current);
+    gfx::Rect tools_bounds, page_bounds;
+    const NSRect bounds = root.bounds;
+    if (in_tab) {
+      ApplyDevToolsContentsResizingStrategy(strategy_, gfx::Rect(0, 0, bounds.size.width, bounds.size.height),
+                                            &tools_bounds, &page_bounds);
+    } else {
+      page_bounds = gfx::Rect(0, 0, bounds.size.width, bounds.size.height);
+    }
+    const CGFloat y = root.isFlipped ? page_bounds.y()
+        : bounds.size.height - page_bounds.bottom();
+    NSRect frame = NSMakeRect(bounds.origin.x + page_bounds.x(), bounds.origin.y + y,
+                             page_bounds.width(), page_bounds.height());
+    if (!NSEqualRects(page.frame, frame)) page.frame = frame;
+    return true;
+  }
+  void FrontendDestroyed() {
+    [frontend_view_ removeFromSuperview];
+    [toolbox_view_ removeFromSuperview];
+    frontend_view_ = nil; toolbox_view_ = nil; frontend_ = nullptr;
+    state_ = 0; docked_ = false;
+    RestorePage();
+    Notify(false);
+  }
+  void WebContentsDestroyed() override {
+    inspected_ = nullptr;
+    auto frontend = frontend_;
+    if (frontend) frontend->Close();
+    callback_ = nullptr; context_ = nullptr;
+    const int id = id_;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE, base::BindOnce([](int id) {
+      auto it = GetDevToolsHosts().find(id);
+      if (it != GetDevToolsHosts().end() && !it->second->live()) GetDevToolsHosts().erase(it);
+    }, id));
+  }
+  void Unregister() {
+    callback_ = nullptr; context_ = nullptr;
+    auto frontend = frontend_;
+    if (frontend) frontend->Close();
+    root_ = nil; document_ = nil; container_ = nil;
+  }
+  void RequestClose(bool force) {
+    if (!frontend_) return;
+    if (force || state_ == 5) { frontend_->Close(); return; }
+    auto* window = DevToolsWindow::GetInstanceForInspectedWebContents(inspected_.get());
+    if (window) static_cast<DevToolsUIBindings::Delegate*>(window)->CloseWindow();
+  }
+  void Focus() { Notify(true, true); }
+
+ private:
+  static int DockState(const DevToolsContentsResizingStrategy& strategy) {
+    switch (strategy.dock_side()) {
+      case devtools::DockSide::kLeft: return 1;
+      case devtools::DockSide::kBottom: return 2;
+      case devtools::DockSide::kRight: return 3;
+      case devtools::DockSide::kNone: return 3;
+    }
+  }
+  void RestorePage() {
+    if (inspected_ && root_) {
+      NSView* page = document_;
+      if (page.superview == root_ && !NSEqualRects(page.frame, root_.bounds)) page.frame = root_.bounds;
+    }
+  }
+  void Notify(bool focus, bool force = false) {
+    if (!callback_ || (!focus && !force && reported_state_ == state_)) return;
+    reported_state_ = state_;
+    auto callback = callback_;
+    void* context = context_;
+    callback(context, state_, focus ? 1u : 0u);
+  }
+  const int id_;
+  base::WeakPtr<content::WebContents> inspected_;
+  base::WeakPtr<content::WebContents> frontend_;
+  __weak NSView* root_;
+  __weak NSView* document_;
+  __weak NSView* container_;
+  __weak NSView* frontend_view_ = nil;
+  __weak NSView* toolbox_view_ = nil;
+  orbit_devtools_changed_t callback_;
+  void* context_;
+  bool docked_ = false;
+  bool laying_out_ = false;
+  int state_ = 0;
+  int reported_state_ = 0;
+  DevToolsContentsResizingStrategy strategy_;
+  std::unique_ptr<FrontendObservation> frontend_observation_;
+};
+
+void FrontendObservation::WebContentsDestroyed() { owner_->FrontendDestroyed(); }
+HostedDevTools* FindDevTools(content::WebContents* inspected) {
+  const int id = HostedBrowserID(inspected);
+  auto it = GetDevToolsHosts().find(id);
+  return it == GetDevToolsHosts().end() ? nullptr : it->second.get();
+}
+}  // namespace
+
+bool CanHostDevTools(content::WebContents* inspected) {
+  auto* state = inspected ? FindDevTools(inspected) : nullptr;
+  return state && state->live();
+}
+bool IsHostedDevToolsFrontend(content::WebContents* frontend) {
+  if (!frontend) return false;
+  for (const auto& [id, state] : GetDevToolsHosts())
+    if (state->frontend() == frontend) return true;
+  return false;
+}
+void PrepareHostedDevTools(content::WebContents* inspected) {
+  if (!CanHostDevTools(inspected)) return;
+  // Earlier CEF versions could only save an undocked state. Migrate once;
+  // subsequent native menu choices remain the profile's own preferences.
+  auto* profile = Profile::FromBrowserContext(inspected->GetBrowserContext());
+  ScopedDictPrefUpdate update(profile->GetPrefs(), prefs::kDevToolsPreferences);
+  if (!update->contains("orbit-docking-initialized")) {
+    update->Set("currentDockState", "\"right\"");
+    update->Set("lastDockState", "\"right\"");
+    update->Set("orbit-docking-initialized", "true");
+  }
+}
+void HostedDevToolsCreated(content::WebContents* inspected, content::WebContents* frontend) {
+  if (auto* state = FindDevTools(inspected)) state->SetFrontend(frontend);
+}
+void PresentHostedDevTools(content::WebContents* inspected, content::WebContents* frontend,
+                          bool docked, const DevToolsContentsResizingStrategy& strategy) {
+  if (auto* state = FindDevTools(inspected)) state->Present(frontend, docked, strategy);
+}
+bool RefreshHostedDevTools(content::WebContents* inspected) {
+  auto* state = inspected ? FindDevTools(inspected) : nullptr;
+  return state && state->Refresh();
+}
+bool ActivateHostedDevTools(content::WebContents* inspected) {
+  auto* state = inspected ? FindDevTools(inspected) : nullptr;
+  if (!state || !state->frontend()) return false;
+  state->Focus(); return true;
+}
+
+bool CloseHostedDevTools(content::WebContents* inspected) {
+  auto* state = inspected ? FindDevTools(inspected) : nullptr;
+  if (!state) return false;
+  state->RequestClose(false); return true;
+}
+bool HasHostedDevTools(content::WebContents* inspected) {
+  auto* state = inspected ? FindDevTools(inspected) : nullptr;
+  return state && state->state() != 0;
+}
+
+int32_t DevToolsSetHost(int32_t id, void* root_view, void* document_view, void* frontend_view,
+                       orbit_devtools_changed_t callback, void* context) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto it = GetDevToolsHosts().find(id);
+  if (!root_view || !document_view || !frontend_view || !callback) {
+    if (it != GetDevToolsHosts().end()) { it->second->Unregister(); GetDevToolsHosts().erase(id); }
+    return 1;
+  }
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  if (!host || !CefBrowserPlatformDelegateChromeHosted::FromBrowserId(id) || !host->GetWebContents()) return 0;
+  NSView* root = (__bridge NSView*)root_view;
+  NSView* document = (__bridge NSView*)document_view;
+  NSView* container = (__bridge NSView*)frontend_view;
+  NSView* page = host->GetWebContents()->GetNativeView().GetNativeNSView();
+  if (page.superview != document || document.superview != root || container.superview != root || root.window != container.window) return 0;
+  if (it != GetDevToolsHosts().end()) { it->second->Rebind(root, document, container, callback, context); return 1; }
+  GetDevToolsHosts()[id] = std::make_unique<HostedDevTools>(id, host->GetWebContents(), root, document, container, callback, context);
+  return 1;
+}
+int32_t DevToolsShow(int32_t id, int32_t inspect, int32_t x, int32_t y, const char* panel) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  if (!host || !CanHostDevTools(host->GetWebContents())) return 0;
+  const std::string name = panel ? panel : "";
+  if (!name.empty() && name != "elements" && name != "console" && name != "network") return 0;
+  auto* contents = host->GetWebContents();
+  if (inspect) {
+    DevToolsWindow::InspectElement(contents->GetPrimaryMainFrame(), x, y);
+  } else {
+    content::DevToolsManagerDelegate::DevToolsOptions options(
+        name.empty() ? std::nullopt : std::make_optional(name));
+    DevToolsWindow::OpenDevToolsWindow(contents, Profile::FromBrowserContext(contents->GetBrowserContext()),
+                                     DevToolsOpenedByAction::kMainMenuOrMainShortcut, options);
+  }
+  if (!name.empty()) {
+    if (auto* window = DevToolsWindow::GetInstanceForInspectedWebContents(contents)) {
+      if (auto* bindings = DevToolsUIBindings::ForWebContents(window->GetDevToolsWebContents()))
+        bindings->CallClientMethod("DevToolsAPI", "showPanel", base::Value(name));
+    }
+  }
+  return 1;
+}
+int32_t DevToolsClose(int32_t id, int32_t force) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto it = GetDevToolsHosts().find(id);
+  if (it == GetDevToolsHosts().end()) return 0;
+  it->second->RequestClose(force != 0); return 1;
+}
+int32_t DevToolsState(int32_t id) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto it = GetDevToolsHosts().find(id);
+  return it == GetDevToolsHosts().end() ? 0 : it->second->state();
+}
+int32_t DevToolsFocus(int32_t id) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto it = GetDevToolsHosts().find(id);
+  if (it == GetDevToolsHosts().end() || !it->second->frontend()) return 0;
+  it->second->frontend()->Focus(); return 1;
+}
+int32_t DevToolsLayout(int32_t id) {
+  if (!CONTEXT_STATE_VALID() || !CEF_CURRENTLY_ON_UIT()) return 0;
+  auto it = GetDevToolsHosts().find(id);
+  return it != GetDevToolsHosts().end() && it->second->Layout() ? 1 : 0;
+}
+}  // namespace orbit
