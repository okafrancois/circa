+// Orbit: the embedder passes the user data directory it owns (CefSettings
+// root_cache_path, never a command-line choice) in this switch. Data written
+// there before the non-default directory protection used the legacy "v10" key,
+// so that directory alone keeps it readable; new data is still written as
+// "v11". Any other directory keeps the upstream protection.
+constexpr char kOrbitOwnedUserDataDir[] = "orbit-owned-user-data-dir";
+
+bool IsOrbitOwnedUserDataDir() {
+  const base::FilePath owned =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+          kOrbitOwnedUserDataDir);
+  base::FilePath user_data_dir;
+  if (owned.empty() || !owned.IsAbsolute() ||
+      owned.ReferencesParent() ||
+      !base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir)) {
+    return false;
+  }
+  return owned.StripTrailingSeparators() ==
+         user_data_dir.StripTrailingSeparators();
+}
+
 }  // namespace
