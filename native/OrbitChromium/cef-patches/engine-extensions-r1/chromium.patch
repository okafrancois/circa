+namespace constrained_window {
+namespace {
+
+// These tests allocate real ordinary NSWindows and real Chromium widgets.
+// Run only in the PM's coordinated synthetic native-window test session.
+class ConstrainedWindowAppKitParentTest : public views::ViewsTestBase {
+ protected:
+  NSWindow* MakeParent() {
+    NSWindow* window =
+        [[NSWindow alloc] initWithContentRect:NSMakeRect(370, 240, 780, 600)
+                                    styleMask:NSWindowStyleMaskTitled |
+                                              NSWindowStyleMaskClosable |
+                                              NSWindowStyleMaskResizable
+                                      backing:NSBackingStoreBuffered
+                                        defer:NO];
+    window.releasedWhenClosed = NO;
+    return window;
+  }
+
+  struct Dialog {
+    explicit Dialog(NSWindow* parent,
+                    ui::mojom::ModalType type = ui::mojom::ModalType::kChild) {
+      delegate = std::make_unique<views::DialogDelegate>();
+      delegate->SetModalType(type);
+      delegate->SetOwnershipOfNewWidget(
+          views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+      auto contents = std::make_unique<views::StaticSizedView>();
+      contents->SetPreferredSize(gfx::Size(300, 180));
+      delegate->SetContentsView(std::move(contents));
+      widget.reset(views::DialogDelegate::CreateDialogWidget(
+          delegate.get(), gfx::NativeWindow(),
+          gfx::NativeView(parent.contentView)));
+    }
+    ~Dialog() {
+      if (!widget->IsClosed()) {
+        widget->CloseNow();
+      }
+    }
+    std::unique_ptr<views::DialogDelegate> delegate;
+    std::unique_ptr<views::Widget> widget;
+  };
+};
+
+TEST_F(ConstrainedWindowAppKitParentTest,
+       OrdinaryParentResolutionRequiresExplicitRegistration) {
+  NSWindow* parent = MakeParent();
+  const gfx::NativeView view(parent.contentView);
+  EXPECT_EQ(nullptr,
+            views::NativeWidgetMacNSWindowHost::GetFromNativeView(view));
+  EXPECT_FALSE(remote_cocoa::ScopedAppKitModalParent::IsRegistered(view));
+  auto first = std::make_unique<remote_cocoa::ScopedAppKitModalParent>(
+      gfx::NativeWindow(parent));
+  auto second = std::make_unique<remote_cocoa::ScopedAppKitModalParent>(
+      gfx::NativeWindow(parent));
+  EXPECT_TRUE(remote_cocoa::ScopedAppKitModalParent::IsRegistered(view));
+  first.reset();
+  EXPECT_TRUE(remote_cocoa::ScopedAppKitModalParent::IsRegistered(view));
+  second.reset();
+  EXPECT_FALSE(remote_cocoa::ScopedAppKitModalParent::IsRegistered(view));
+  [parent close];
+}
+
+TEST_F(ConstrainedWindowAppKitParentTest,
+       ChildModalCreatesRealInProcessParentAdapterBeforeShow) {
+  NSWindow* parent = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  {
+    Dialog dialog(parent);
+    auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+        dialog.widget->GetNativeWindow());
+    ASSERT_NE(nullptr, host);
+    EXPECT_EQ(nullptr, host->parent());
+    EXPECT_TRUE(host->HasAppKitModalParent());
+    EXPECT_EQ(ui::mojom::ModalType::kChild, dialog.delegate->GetModalType());
+    EXPECT_TRUE(dialog.widget->is_top_level());
+    EXPECT_FALSE(dialog.widget->IsVisible());
+    EXPECT_EQ(
+        nil, dialog.widget->GetNativeWindow().GetNativeNSWindow().parentWindow);
+    const gfx::Rect actual = host->AppKitModalParentBoundsInScreen();
+    EXPECT_EQ(remote_cocoa::ScopedAppKitModalParent::ContentBoundsInScreen(
+                  gfx::NativeView(parent.contentView)),
+              actual);
+    EXPECT_NE(gfx::Point(), actual.origin());
+  }
+  [parent close];
+}
