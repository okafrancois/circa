+TEST_F(ConstrainedWindowAppKitParentTest,
+       ModalBoundsUseNativeContentScreenCoordinatesAfterMoveAndResize) {
+  NSWindow* parent = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  {
+    Dialog dialog(parent);
+    class OffsetHost : public web_modal::TestWebContentsModalDialogHost {
+     public:
+      using TestWebContentsModalDialogHost::TestWebContentsModalDialogHost;
+      gfx::Point GetDialogPosition(const gfx::Size&) override {
+        return gfx::Point(120, 20);
+      }
+    };
+    OffsetHost host{gfx::NativeView(parent.contentView)};
+    host.set_max_dialog_size(gfx::Size(780, 600));
+    UpdateWidgetModalDialogPosition(dialog.widget.get(), &host);
+    gfx::Rect content =
+        remote_cocoa::ScopedAppKitModalParent::ContentBoundsInScreen(
+            gfx::NativeView(parent.contentView));
+    EXPECT_EQ(content.origin() + gfx::Vector2d(120, 20),
+              dialog.widget->GetWindowBoundsInScreen().origin());
+    [parent setFrameOrigin:NSMakePoint(580, 110)];
+    [parent setContentSize:NSMakeSize(900, 650)];
+    UpdateWidgetModalDialogPosition(dialog.widget.get(), &host);
+    content = remote_cocoa::ScopedAppKitModalParent::ContentBoundsInScreen(
+        gfx::NativeView(parent.contentView));
+    EXPECT_EQ(content.origin() + gfx::Vector2d(120, 20),
+              dialog.widget->GetWindowBoundsInScreen().origin());
+  }
+  [parent close];
+}
