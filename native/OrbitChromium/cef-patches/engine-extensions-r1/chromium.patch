+TEST_F(ConstrainedWindowAppKitParentTest,
+       ReparentMovesNativeRelationshipToNewRegisteredWindow) {
+  NSWindow* parent = MakeParent();
+  NSWindow* destination = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  remote_cocoa::ScopedAppKitModalParent destination_registration{
+      gfx::NativeWindow(destination)};
+  [parent orderFront:nil];
+  [destination orderFront:nil];
+  {
+    Dialog dialog(parent);
+    dialog.widget->ShowInactive();
+    views::Widget::ReparentNativeView(dialog.widget->GetNativeView(),
+                                      gfx::NativeView(destination.contentView));
+    EXPECT_EQ(
+        destination,
+        dialog.widget->GetNativeWindow().GetNativeNSWindow().parentWindow);
+    [parent close];
+    EXPECT_FALSE(dialog.widget->IsClosed());
+    [destination close];
+    EXPECT_TRUE(dialog.widget->IsClosed());
+  }
+}
