+TEST_F(ConstrainedWindowAppKitParentTest,
+       EscapeCancelsRealWidgetAndAllowsRetryWithoutChangingChildModality) {
+  NSWindow* parent = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  [NSApp activateIgnoringOtherApps:YES];
+  [parent makeKeyAndOrderFront:nil];
+  {
+    Dialog first(parent);
+    first.widget->Show();
+    ui::KeyEvent escape(ui::EventType::kKeyPressed, ui::VKEY_ESCAPE,
+                        ui::EF_NONE);
+    first.widget->OnKeyEvent(&escape);
+    base::RunLoop().RunUntilIdle();
+    EXPECT_TRUE(first.widget->IsClosed());
+    EXPECT_EQ(nil, parent.attachedSheet);
+    Dialog retry(parent);
+    retry.widget->ShowInactive();
+    EXPECT_EQ(ui::mojom::ModalType::kChild, retry.delegate->GetModalType());
+    EXPECT_EQ(parent,
+              retry.widget->GetNativeWindow().GetNativeNSWindow().parentWindow);
+  }
+  [parent close];
+}
