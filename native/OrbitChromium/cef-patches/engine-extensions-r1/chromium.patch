+TEST_F(ConstrainedWindowAppKitParentTest,
+       UnparentedBubbleKeepsChromiumTopLevelPath) {
+  NSWindow* parent = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  auto widget = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_BUBBLE);
+  params.bounds = gfx::Rect(500, 300, 220, 160);
+  widget->Init(std::move(params));
+  auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      widget->GetNativeWindow());
+  EXPECT_FALSE(host->HasAppKitModalParent());
+  widget->CloseNow();
+  [parent close];
+}
+
+}  // namespace
+}  // namespace constrained_window
