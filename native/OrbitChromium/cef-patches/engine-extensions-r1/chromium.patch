+// A non-modal bubble explicitly parented to the shell's view (the native
+// extension action popup) is an ordered child window of that window: it moves
+// with it, stays in its Space and closes with it.
+TEST_F(ConstrainedWindowAppKitParentTest,
+       ParentedBubbleIsOrderedChildWindowOfRegisteredParent) {
+  NSWindow* parent = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  [NSApp activateIgnoringOtherApps:YES];
+  [parent makeKeyAndOrderFront:nil];
+  auto widget = std::make_unique<views::Widget>();
+  views::Widget::InitParams params(
+      views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+      views::Widget::InitParams::TYPE_BUBBLE);
+  params.parent = gfx::NativeView(parent.contentView);
+  params.bounds = gfx::Rect(500, 300, 220, 160);
+  widget->Init(std::move(params));
+  auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+      widget->GetNativeWindow());
+  ASSERT_NE(nullptr, host);
+  EXPECT_TRUE(host->HasAppKitModalParent());
+  widget->Show();
+  NSWindow* popup = widget->GetNativeWindow().GetNativeNSWindow();
+  EXPECT_EQ(parent, popup.parentWindow);
+  const NSPoint before = popup.frame.origin;
+  [parent setFrameOrigin:NSMakePoint(parent.frame.origin.x + 30,
+                                     parent.frame.origin.y + 20)];
+  EXPECT_EQ(before.x + 30, popup.frame.origin.x);
+  EXPECT_EQ(before.y + 20, popup.frame.origin.y);
+  [parent close];
+  EXPECT_TRUE(widget->IsClosed());
+}
