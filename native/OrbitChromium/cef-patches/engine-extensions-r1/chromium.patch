+// Copyright 2026 Orbit. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_REMOTE_COCOA_APP_SHIM_APPKIT_MODAL_PARENT_H_
+#define COMPONENTS_REMOTE_COCOA_APP_SHIM_APPKIT_MODAL_PARENT_H_
+
+#include <memory>
+
+#include "base/functional/callback.h"
+#include "components/remote_cocoa/app_shim/remote_cocoa_app_shim_export.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/native_ui_types.h"
+
+namespace remote_cocoa {
+
+class AppKitModalParentState;
+
+// Explicit opt-in for an in-process, non-Views AppKit window. Registration
+// neither changes the window class/delegate/content nor creates a fake Widget.
+// All methods and destruction run on the AppKit main thread.
+class REMOTE_COCOA_APP_SHIM_EXPORT ScopedAppKitModalParent {
+ public:
+  explicit ScopedAppKitModalParent(gfx::NativeWindow window);
+  ~ScopedAppKitModalParent();
+  ScopedAppKitModalParent(const ScopedAppKitModalParent&) = delete;
+  ScopedAppKitModalParent& operator=(const ScopedAppKitModalParent&) = delete;
+
+  static bool IsRegistered(gfx::NativeView view);
+  static gfx::Rect ContentBoundsInScreen(gfx::NativeView view);
+
+ private:
+  std::shared_ptr<AppKitModalParentState> state_;
+};
+
+// Actual native relationship used by an in-process kChild or kWindow widget
+// bridge. Chromium still owns the child widget, compositor, keyboard routing
+// and WebContents input blocking. This adapter owns its ordinary AppKit parent
+// contract: visibility, z-order, coordinate origin and parent-close handling.
+class REMOTE_COCOA_APP_SHIM_EXPORT AppKitModalDialogParent {
+ public:
+  // kChild (web-modal) dialogs are ordered native child windows positioned by
+  // the constrained-window host. kWindow (browser-modal) dialogs are window-
+  // modal sheets, as for a Chromium parent on macOS: AppKit attaches, positions
+  // and moves them with the parent, and blocks the parent while they show.
+  enum class Presentation { kChildWindow, kSheet };
+
+  // |show_sheet| begins the sheet once a deferred kSheet show becomes possible
+  // (hidden, minimized or other-Space parent). Unused for kChildWindow.
+  static std::unique_ptr<AppKitModalDialogParent> Create(
+      gfx::NativeView parent_view,
+      gfx::NativeWindow child,
+      base::RepeatingClosure close_child,
+      Presentation presentation = Presentation::kChildWindow,
+      base::RepeatingClosure show_sheet = base::RepeatingClosure());
+  ~AppKitModalDialogParent();
+  AppKitModalDialogParent(const AppKitModalDialogParent&) = delete;
+  AppKitModalDialogParent& operator=(const AppKitModalDialogParent&) = delete;
+
+  void SetWantsVisible(bool visible);
+  void OnChildClosing();
+  bool PrepareToShow();
+  bool ParentIsClosed() const;
+  bool IsSheet() const;
+  gfx::Rect ContentBoundsInScreen() const;
+  gfx::NativeWindow native_parent() const;
+
+ private:
+  class Impl;
+  explicit AppKitModalDialogParent(std::unique_ptr<Impl> impl);
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace remote_cocoa
+
+#endif  // COMPONENTS_REMOTE_COCOA_APP_SHIM_APPKIT_MODAL_PARENT_H_
diff --git a/components/remote_cocoa/app_shim/appkit_modal_parent.mm b/components/remote_cocoa/app_shim/appkit_modal_parent.mm
new file mode 100644
index 0000000..ea87107
--- /dev/null
+++ b/components/remote_cocoa/app_shim/appkit_modal_parent.mm
@@ -0,0 +1,274 @@
+// Copyright 2026 Orbit. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "components/remote_cocoa/app_shim/appkit_modal_parent.h"
+
+#import <AppKit/AppKit.h>
+
+#include <map>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+
+namespace remote_cocoa {
+
+class AppKitModalParentState {
+ public:
+  explicit AppKitModalParentState(NSWindow* parent) : window(parent) {
+    close_observer_ = [NSNotificationCenter.defaultCenter
+        addObserverForName:NSWindowWillCloseNotification
+                    object:window
+                     queue:nil
+                usingBlock:^(NSNotification*) {
+                  closed = true;
+                }];
+  }
+  ~AppKitModalParentState() {
+    [NSNotificationCenter.defaultCenter removeObserver:close_observer_];
+  }
+
+  NSWindow* __strong window;
+  size_t registrations = 0;
+  bool closed = false;
+
+ private:
+  id __strong close_observer_;
+};
+
+namespace {
+using ParentMap = std::map<NSWindow*, std::weak_ptr<AppKitModalParentState>>;
+
+ParentMap& Parents() {
+  static base::NoDestructor<ParentMap> parents;
+  return *parents;
+}
+
+std::shared_ptr<AppKitModalParentState> Resolve(gfx::NativeView view) {
+  CHECK(NSThread.isMainThread);
+  auto found = Parents().find(view.GetNativeNSView().window);
+  return found == Parents().end() ? nullptr : found->second.lock();
+}
+
+gfx::Rect ContentBounds(NSWindow* window) {
+  NSView* view = window.contentView;
+  return gfx::ScreenRectFromNSRect(
+      [window convertRectToScreen:[view convertRect:view.bounds toView:nil]]);
+}
+}  // namespace
+
+ScopedAppKitModalParent::ScopedAppKitModalParent(gfx::NativeWindow window) {
+  CHECK(NSThread.isMainThread);
+  NSWindow* parent = window.GetNativeNSWindow();
+  CHECK(parent);
+  state_ = Parents()[parent].lock();
+  if (!state_) {
+    state_ = std::make_shared<AppKitModalParentState>(parent);
+    Parents()[parent] = state_;
+  }
+  ++state_->registrations;
+}
+
+ScopedAppKitModalParent::~ScopedAppKitModalParent() {
+  CHECK(NSThread.isMainThread);
+  if (--state_->registrations == 0) {
+    Parents().erase(state_->window);
+  }
+}
+
+bool ScopedAppKitModalParent::IsRegistered(gfx::NativeView view) {
+  return Resolve(view) != nullptr;
+}
+
+gfx::Rect ScopedAppKitModalParent::ContentBoundsInScreen(gfx::NativeView view) {
+  auto state = Resolve(view);
+  return state ? ContentBounds(state->window) : gfx::Rect();
+}
+
+class AppKitModalDialogParent::Impl {
+ public:
+  Impl(std::shared_ptr<AppKitModalParentState> parent,
+       NSWindow* child,
+       base::RepeatingClosure close_child,
+       AppKitModalDialogParent::Presentation presentation,
+       base::RepeatingClosure show_sheet)
+      : parent_(std::move(parent)),
+        child_(child),
+        close_child_(close_child),
+        presentation_(presentation),
+        show_sheet_(std::move(show_sheet)) {
+    auto* center = NSNotificationCenter.defaultCenter;
+    for (NSNotificationName name in @[
+           NSWindowDidChangeOcclusionStateNotification,
+           NSWindowDidMiniaturizeNotification,
+           NSWindowDidDeminiaturizeNotification,
+           NSWindowDidBecomeKeyNotification
+         ]) {
+      observers_.push_back([center addObserverForName:name
+                                               object:parent_->window
+                                                queue:nil
+                                           usingBlock:^(NSNotification*) {
+                                             UpdateVisibility();
+                                           }]);
+    }
+    for (NSNotificationName name in @[
+           NSApplicationDidHideNotification, NSApplicationDidUnhideNotification
+         ]) {
+      observers_.push_back([center addObserverForName:name
+                                               object:NSApp
+                                                queue:nil
+                                           usingBlock:^(NSNotification*) {
+                                             UpdateVisibility();
+                                           }]);
+    }
+    observers_.push_back([center
+        addObserverForName:NSWindowWillCloseNotification
+                    object:parent_->window
+                     queue:nil
+                usingBlock:^(NSNotification*) {
+                  parent_->closed = true;
+                  // Closing the child may synchronously destroy this adapter.
+                  base::RepeatingClosure close = close_child_;
+                  close.Run();
+                }]);
+  }
+  ~Impl() {
+    CHECK(NSThread.isMainThread);
+    for (id observer : observers_) {
+      [NSNotificationCenter.defaultCenter removeObserver:observer];
+    }
+    NSWindow* child = child_;
+    NSWindow* parent = parent_->window;
+    const bool restore_key =
+        restore_key_on_destroy_ && child.isKeyWindow && CanShow();
+    if (child && child.parentWindow == parent) {
+      [parent removeChildWindow:child];
+    }
+    // Never activate the app or steal focus from another browser window.
+    if (restore_key && NSApp.active &&
+        (!NSApp.keyWindow || NSApp.keyWindow == child ||
+         NSApp.keyWindow == parent)) {
+      [parent makeKeyWindow];
+    }
+  }
+
+  bool CanShow() const {
+    return !parent_->closed && !NSApp.hidden && parent_->window.visible &&
+           !parent_->window.miniaturized && parent_->window.onActiveSpace;
+  }
+
+  bool IsSheet() const {
+    return presentation_ == AppKitModalDialogParent::Presentation::kSheet;
+  }
+
+  void UpdateVisibility() {
+    NSWindow* child = child_;
+    if (!child || !ready_ || !wants_visible_) {
+      return;
+    }
+    if (IsSheet()) {
+      // AppKit hides, minimizes and moves an attached sheet with its parent.
+      // Only a show deferred while the parent could not present it remains.
+      if (CanShow() && parent_->window.attachedSheet != child &&
+          !child.visible && show_sheet_) {
+        base::RepeatingClosure show = show_sheet_;
+        show.Run();  // May synchronously destroy this adapter.
+      }
+      return;
+    }
+    if (CanShow()) {
+      if (child.parentWindow != parent_->window) {
+        [parent_->window addChildWindow:child ordered:NSWindowAbove];
+      }
+    } else {
+      [parent_->window removeChildWindow:child];
+      [child orderOut:nil];
+    }
+  }
+
+  void SetWantsVisible(bool visible) {
+    wants_visible_ = visible;
+    if (!visible) {
+      ready_ = false;
+      if (IsSheet()) {
+        return;  // The bridge ends or orders out its own sheet.
+      }
+      NSWindow* child = child_;
+      if (child && child.parentWindow == parent_->window) {
+        [parent_->window removeChildWindow:child];
+      }
+    }
+  }
+
+  bool PrepareToShow() {
+    ready_ = true;
+    if (IsSheet()) {
+      // The caller begins the sheet now, or UpdateVisibility() does later.
+      return CanShow() && wants_visible_;
+    }
+    UpdateVisibility();
+    return CanShow() && wants_visible_;
+  }
+
+  const std::shared_ptr<AppKitModalParentState> parent_;
+  NSWindow* __weak child_;
+  const base::RepeatingClosure close_child_;
+  const AppKitModalDialogParent::Presentation presentation_;
+  const base::RepeatingClosure show_sheet_;
+  bool wants_visible_ = false;
+  bool ready_ = false;
+  bool restore_key_on_destroy_ = false;
+  std::vector<id> observers_;
+};
+
+std::unique_ptr<AppKitModalDialogParent> AppKitModalDialogParent::Create(
+    gfx::NativeView parent_view,
+    gfx::NativeWindow child,
+    base::RepeatingClosure close_child,
+    Presentation presentation,
+    base::RepeatingClosure show_sheet) {
+  auto state = Resolve(parent_view);
+  if (!state) {
+    return nullptr;
+  }
+  CHECK(child);
+  CHECK(close_child);
+  CHECK(presentation == Presentation::kChildWindow || show_sheet);
+  return std::unique_ptr<AppKitModalDialogParent>(new AppKitModalDialogParent(
+      std::make_unique<Impl>(std::move(state), child.GetNativeNSWindow(),
+                             std::move(close_child), presentation,
+                             std::move(show_sheet))));
+}
+
+AppKitModalDialogParent::AppKitModalDialogParent(std::unique_ptr<Impl> impl)
+    : impl_(std::move(impl)) {}
+AppKitModalDialogParent::~AppKitModalDialogParent() = default;
+void AppKitModalDialogParent::SetWantsVisible(bool visible) {
+  impl_->SetWantsVisible(visible);
+}
+void AppKitModalDialogParent::OnChildClosing() {
+  impl_->restore_key_on_destroy_ = true;
+  // Keep the existing physical parent during close animation, but never
+  // re-show the child in response to a parent activation/visibility event.
+  impl_->wants_visible_ = false;
+  impl_->ready_ = false;
+}
+bool AppKitModalDialogParent::PrepareToShow() {
+  return impl_->PrepareToShow();
+}
+bool AppKitModalDialogParent::ParentIsClosed() const {
+  return impl_->parent_->closed;
+}
+bool AppKitModalDialogParent::IsSheet() const {
+  return impl_->IsSheet();
+}
+gfx::Rect AppKitModalDialogParent::ContentBoundsInScreen() const {
+  return ContentBounds(impl_->parent_->window);
+}
+gfx::NativeWindow AppKitModalDialogParent::native_parent() const {
+  return gfx::NativeWindow(impl_->parent_->window);
+}
+
+}  // namespace remote_cocoa
