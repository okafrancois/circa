+// Copyright 2026 Orbit. Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#import <AppKit/AppKit.h>
+
+#include "components/remote_cocoa/app_shim/appkit_modal_parent.h"
+
+#include "base/functional/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "ui/gfx/mac/coordinate_conversion.h"
+
+namespace remote_cocoa {
+namespace {
+
+// Requires PM coordination even though every native window remains hidden.
+// Uses real ordinary NSWindows, not NSObject or a fake native-widget host.
+class AppKitModalParentTest : public testing::Test {
+ protected:
+  void SetUp() override { [NSApplication sharedApplication]; }
+  NSWindow* MakeWindow() {
+    NSWindow* window = [[NSWindow alloc]
+        initWithContentRect:NSMakeRect(415, 230, 730, 520)
+                  styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
+                    backing:NSBackingStoreBuffered
+                      defer:NO];
+    window.releasedWhenClosed = NO;
+    return window;
+  }
+};
+
+TEST_F(AppKitModalParentTest, OnlyExplicitlyRegisteredParentCanBeResolved) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  gfx::NativeView view(parent.contentView);
+  auto close = base::BindRepeating([]() {});
+  EXPECT_FALSE(ScopedAppKitModalParent::IsRegistered(view));
+  EXPECT_EQ(nullptr, AppKitModalDialogParent::Create(
+                         view, gfx::NativeWindow(child), close));
+  {
+    ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+    auto adapter =
+        AppKitModalDialogParent::Create(view, gfx::NativeWindow(child), close);
+    ASSERT_TRUE(adapter);
+    EXPECT_EQ(parent, adapter->native_parent().GetNativeNSWindow());
+    EXPECT_FALSE(adapter->ParentIsClosed());
+  }
+  EXPECT_FALSE(ScopedAppKitModalParent::IsRegistered(view));
+  [child close];
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest, LogicalBrowsersReferenceCountSameOrdinaryWindow) {
+  NSWindow* parent = MakeWindow();
+  gfx::NativeView view(parent.contentView);
+  auto first =
+      std::make_unique<ScopedAppKitModalParent>(gfx::NativeWindow(parent));
+  auto second =
+      std::make_unique<ScopedAppKitModalParent>(gfx::NativeWindow(parent));
+  first.reset();
+  EXPECT_TRUE(ScopedAppKitModalParent::IsRegistered(view));
+  second.reset();
+  EXPECT_FALSE(ScopedAppKitModalParent::IsRegistered(view));
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest,
+       BoundsReadNativeContentCoordinatesAfterMoveAndResize) {
+  NSWindow* parent = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  gfx::NativeView view(parent.contentView);
+  const auto expected = [&]() {
+    return gfx::ScreenRectFromNSRect(
+        [parent convertRectToScreen:[parent.contentView
+                                        convertRect:parent.contentView.bounds
+                                             toView:nil]]);
+  };
+  EXPECT_TRUE(ScopedAppKitModalParent::ContentBoundsInScreen(view) ==
+              expected());
+  [parent setFrameOrigin:NSMakePoint(710, 90)];
+  [parent setContentSize:NSMakeSize(900, 630)];
+  const auto actual = ScopedAppKitModalParent::ContentBoundsInScreen(view);
+  EXPECT_TRUE(actual == expected());
+  EXPECT_NE(0, actual.x());
+  EXPECT_EQ(900, actual.width());
+  EXPECT_EQ(630, actual.height());
+  EXPECT_FALSE(parent.visible);
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest, HiddenParentCannotShowOrAttachItsChild) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([]() {}));
+  adapter->SetWantsVisible(true);
+  EXPECT_FALSE(adapter->PrepareToShow());
+  EXPECT_EQ(nil, child.parentWindow);
+  EXPECT_FALSE(child.visible);
+  adapter.reset();
+  [child close];
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest,
+       ParentCloseInvokesCloseCallbackAndKeepsTerminalState) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  int close_count = 0;
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&close_count)));
+  [parent close];
+  EXPECT_EQ(1, close_count);
+  EXPECT_TRUE(adapter->ParentIsClosed());
+  adapter->SetWantsVisible(true);
+  EXPECT_FALSE(adapter->PrepareToShow());
+  adapter.reset();
+  [child close];
+}
+
+TEST_F(AppKitModalParentTest, ParentCloseCanSynchronouslyDestroyAdapter) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  std::unique_ptr<AppKitModalDialogParent> adapter;
+  adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating(
+          [](std::unique_ptr<AppKitModalDialogParent>* slot) { slot->reset(); },
+          base::Unretained(&adapter)));
+  [parent close];
+  EXPECT_EQ(nullptr, adapter);
+  [child close];
+}
+
+// Browser-modal (kWindow) dialogs are presented as the parent's sheet: the
+// adapter never orders a child window and defers a show the hidden parent
+// cannot present. Every window stays hidden.
+TEST_F(AppKitModalParentTest, SheetPresentationDefersWhileParentCannotShow) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  int shows = 0;
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([]() {}),
+      AppKitModalDialogParent::Presentation::kSheet,
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&shows)));
+  ASSERT_TRUE(adapter);
+  EXPECT_TRUE(adapter->IsSheet());
+  adapter->SetWantsVisible(true);
+  EXPECT_FALSE(adapter->PrepareToShow());
+  [NSNotificationCenter.defaultCenter
+      postNotificationName:NSWindowDidBecomeKeyNotification
+                    object:parent];
+  EXPECT_EQ(0, shows);
+  EXPECT_EQ(nil, child.parentWindow);
+  EXPECT_EQ(nil, parent.attachedSheet);
+  EXPECT_FALSE(child.visible);
+  adapter->SetWantsVisible(false);
+  EXPECT_EQ(nil, child.parentWindow);
+  adapter.reset();
+  [child close];
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest, ChildWindowPresentationRemainsTheDefault) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([]() {}));
+  ASSERT_TRUE(adapter);
+  EXPECT_FALSE(adapter->IsSheet());
+  adapter.reset();
+  [child close];
+  [parent close];
+}
+
+TEST_F(AppKitModalParentTest, SheetParentCloseClosesChildAndStaysTerminal) {
+  NSWindow* parent = MakeWindow();
+  NSWindow* child = MakeWindow();
+  ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  int closes = 0, shows = 0;
+  auto adapter = AppKitModalDialogParent::Create(
+      gfx::NativeView(parent.contentView), gfx::NativeWindow(child),
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&closes)),
+      AppKitModalDialogParent::Presentation::kSheet,
+      base::BindRepeating([](int* count) { ++*count; },
+                          base::Unretained(&shows)));
+  adapter->SetWantsVisible(true);
+  EXPECT_FALSE(adapter->PrepareToShow());
+  [parent close];
+  EXPECT_EQ(1, closes);
+  EXPECT_TRUE(adapter->ParentIsClosed());
+  EXPECT_FALSE(adapter->PrepareToShow());
+  EXPECT_EQ(0, shows);
+  adapter.reset();
+  [child close];
+}
