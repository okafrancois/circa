@@ -0,0 +1,63 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Authors. Use of this
+// source code is governed by a BSD-style license that can be found in the
+// LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_NAVIGATOR_ORBIT_NAVIGATE_INTENT_H_
+#define CHROME_BROWSER_UI_NAVIGATOR_ORBIT_NAVIGATE_INTENT_H_
+
+#include "base/check.h"
+#include "base/memory/raw_ptr.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+
+namespace content {
+class WebContents;
+}
+
+namespace orbit {
+
+// Orbit CEF fork (EXT-OUTCOME-R2). Navigate() creates the WebContents of a new
+// tab and runs the Browser's creation hook (CEF's OnWebContentsCreated →
+// SetAsDelegate) before it loads the URL and inserts the tab. At that moment
+// the tab has no visible URL, no tab strip index and no activation state; the
+// request itself is the only authority for them. CreateTargetContents
+// publishes it here for the duration of that hook. UI thread only.
+struct NavigateIntent {
+  raw_ptr<const BrowserWindowInterface> browser = nullptr;
+  raw_ptr<const content::WebContents> contents = nullptr;
+  GURL url;
+  // Requested tab strip index, -1 when Chrome chooses it.
+  int tabstrip_index = -1;
+  // 1 the tab is added active, 0 in the background, -1 not a tab disposition.
+  int active = -1;
+};
+
+inline const NavigateIntent*& CurrentNavigateIntentSlot() {
+  static const NavigateIntent* current = nullptr;
+  return current;
+}
+
+// The intent of the tab whose creation hook is running, or null.
+inline const NavigateIntent* CurrentNavigateIntent() {
+  return CurrentNavigateIntentSlot();
+}
+
+class ScopedNavigateIntent {
+ public:
+  explicit ScopedNavigateIntent(const NavigateIntent* intent)
+      : previous_(CurrentNavigateIntentSlot()) {
+    CHECK(intent);
+    CurrentNavigateIntentSlot() = intent;
+  }
+  ScopedNavigateIntent(const ScopedNavigateIntent&) = delete;
+  ScopedNavigateIntent& operator=(const ScopedNavigateIntent&) = delete;
+  ~ScopedNavigateIntent() { CurrentNavigateIntentSlot() = previous_; }
+
+ private:
+  const NavigateIntent* const previous_;
+};
+
+}  // namespace orbit
+
+#endif  // CHROME_BROWSER_UI_NAVIGATOR_ORBIT_NAVIGATE_INTENT_H_
