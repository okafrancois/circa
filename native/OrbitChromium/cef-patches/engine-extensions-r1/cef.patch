+bool CefDownloadManagerDelegateImpl::ClassifyInstallerTransfer(
+    DownloadItem* item,
+    CefBrowserHostBase* browser) {
+  content::BrowserContext* item_context =
+      content::DownloadItemUtils::GetBrowserContext(item);
+  content::WebContents* contents =
