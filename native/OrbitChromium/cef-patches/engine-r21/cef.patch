@@ -0,0 +1,56 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+//
+// Framework side of the C API (compiled with the libcef_dll sources): the only
+// place where the embedder's C client is adopted as a C++ CefClient, exactly as
+// cef_browser_host_create_browser does.
+
+#include "base/functional/bind.h"
+#include "cef/include/internal/cef_export.h"
+#include "cef/libcef/browser/orbit/orbit_unowned_tabs.h"
+#include "cef/libcef/browser/orbit/orbit_unowned_tabs_api.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "cef/libcef_dll/ctocpp/client_ctocpp.h"
+
+namespace {
+
+CefRefPtr<CefClient> AdoptFromEmbedder(orbit_unowned_tab_handler_t handler,
+                                       void* context,
+                                       const orbit::UnownedTab& tab,
+                                       CefWindowHandle* parent) {
+  orbit_unowned_tab_t value = {};
+  value.struct_size = sizeof(value);
+  value.window_token = tab.window_token;
+  value.profile_path = tab.profile_path.c_str();
+  value.url = tab.url.c_str();
+  value.index = tab.index;
+  value.active = tab.active;
+  void* view = nullptr;
+  struct _cef_client_t* client = handler(context, &value, &view);
+  if (!client) {
+    return nullptr;
+  }
+  // Takes the new reference the embedder returned, even when it is refused.
+  CefRefPtr<CefClient> adopted = CefClientCToCpp_Wrap(
+      reinterpret_cast<struct _cef_client_0_t*>(client));
+  if (!view) {
+    return nullptr;
+  }
+  *parent = static_cast<CefWindowHandle>(view);
+  return adopted;
+}
+
+}  // namespace
+
+extern "C" CEF_EXPORT int32_t
+orbit_cef_set_unowned_tab_handler(orbit_unowned_tab_handler_t handler,
+                                 void* context) {
+  if (!CEF_CURRENTLY_ON_UIT()) {
+    return 0;
+  }
+  orbit::SetUnownedTabAdopter(
+      handler ? base::BindRepeating(&AdoptFromEmbedder, handler, context)
+              : orbit::UnownedTabAdopter());
+  return 1;
+}
