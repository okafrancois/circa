+void OrbitBrowserWindow::Activate() {
+  if (!browser_) return;
+  auto* contents = browser_->tab_strip_model()->GetActiveWebContents();
+  auto host = contents ? CefBrowserHostBase::GetBrowserForContents(contents) : nullptr;
+  if (!host || !host->GetClient()) return;
+  if (auto handler = host->GetClient()->GetFocusHandler())
+    handler->OnSetFocus(host->GetBrowser(), FOCUS_SOURCE_SYSTEM);
+}
