+bool OnValidUIThread() {
+  return CONTEXT_STATE_VALID() && CEF_CURRENTLY_ON_UIT();
+}
+
+uint32_t DiagnosticCapabilities() { return OnValidUIThread() ? 15u : 0u; }
+
+int32_t TaskManager(int32_t browser_id) {
+  if (!OnValidUIThread()) return 0;
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->CanExecuteChromeCommand(IDC_TASK_MANAGER)) return 0;
+  host->ExecuteChromeCommand(IDC_TASK_MANAGER, CEF_WOD_CURRENT_TAB);
+  return 1;
+}
+
+std::string& TraceProfile() {
+  static base::NoDestructor<std::string> profile;
+  return *profile;
+}
+enum class TracePhase { idle, starting, recording, stopping };
+TracePhase trace_phase = TracePhase::idle;
+class TraceStarted final : public CefCompletionCallback {
+ public:
+  TraceStarted(orbit_trace_callback_t cb, void* ctx) : cb_(cb), ctx_(ctx) {}
+  void OnComplete() override {
+    trace_phase = TracePhase::recording;
+    cb_(ctx_, 1, "");
+  }
+ private:
+  orbit_trace_callback_t cb_; void* ctx_;
+  IMPLEMENT_REFCOUNTING(TraceStarted);
+};
+class TraceEnded final : public CefEndTracingCallback {
+ public:
+  TraceEnded(std::string expected, orbit_trace_callback_t cb, void* ctx)
+      : expected_(std::move(expected)), cb_(cb), ctx_(ctx) {}
+  void OnEndTracingComplete(const CefString& file) override {
+    trace_phase = TracePhase::idle;
+    TraceProfile().clear();
+    const std::string path = file.ToString();
+    const bool ok = path == expected_ && base::PathExists(base::FilePath(path));
+    cb_(ctx_, ok ? 1 : 0, path.c_str());
+  }
+ private:
+  std::string expected_; orbit_trace_callback_t cb_; void* ctx_;
+  IMPLEMENT_REFCOUNTING(TraceEnded);
+};
+int32_t TraceBegin(const char* profile, const char* categories, orbit_trace_callback_t cb, void* ctx) {
+  if (!ExtensionProfile(profile) || !categories || !cb || trace_phase != TracePhase::idle) return 0;
+  TraceProfile() = profile;
+  trace_phase = TracePhase::starting;
+  if (CefBeginTracing(categories, new TraceStarted(cb, ctx))) return 1;
+  TraceProfile().clear(); trace_phase = TracePhase::idle;
+  return 0;
+}
+int32_t TraceEnd(const char* profile, const char* file, orbit_trace_callback_t cb, void* ctx) {
+  if (!OnValidUIThread() || !profile || TraceProfile() != profile || !file || !cb ||
+      trace_phase != TracePhase::recording) return 0;
+  const base::FilePath target(file);
+  // Resolve the parent and profile to reject traversal and symlink escapes. Do not
+  // overwrite an existing destination, including a dangling symbolic link.
+  const auto root = base::MakeAbsoluteFilePath(base::FilePath(profile));
+  const auto parent = base::MakeAbsoluteFilePath(target.DirName());
+  if (!target.IsAbsolute() || target.ReferencesParent() || root.empty() || parent.empty() ||
+      (root != parent && !root.IsParent(parent)) || base::PathExists(target) || base::IsLink(target)) return 0;
+  trace_phase = TracePhase::stopping;
+  if (CefEndTracing(file, new TraceEnded(file, cb, ctx))) return 1;
+  trace_phase = TracePhase::recording;
+  return 0;
+}
+int32_t ExtensionOptionsOpen(int32_t browser_id, const char* id) {
+  if (!OnValidUIThread() || !id) return 0;
+  auto host = GetChromeHost(browser_id);
+  auto* profile = host && host->browser() ? host->browser()->GetProfile() : nullptr;
+  auto* registry = profile && !profile->IsOffTheRecord() ? extensions::ExtensionRegistry::Get(profile) : nullptr;
+  const auto* extension = registry ? registry->enabled_extensions().GetByID(id) : nullptr;
+  if (!extension || extensions::Manifest::IsComponentLocation(extension->location()) ||
+      !extensions::OptionsPageInfo::HasOptionsPage(extension)) return 0;
+  return extensions::ExtensionTabUtil::OpenOptionsPage(extension, host->browser()) ? 1 : 0;
+}
+int32_t ExtensionIncognitoSet(const char* path, const char* id, int32_t allowed) {
+  auto* profile = ExtensionProfile(path);
+  if (!profile || !id || (allowed != 0 && allowed != 1)) return 0;
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  const auto* extension = registry ? registry->GetInstalledExtension(id) : nullptr;
+  if (!extension || extensions::Manifest::IsComponentLocation(extension->location()) ||
+      !extensions::util::CanBeIncognitoEnabled(extension)) return 0;
+  extensions::util::SetIsIncognitoEnabled(id, profile, allowed != 0);
+  return extensions::util::IsIncognitoEnabled(id, profile) == (allowed != 0) ? 1 : 0;
+}
+
+int32_t PopupNavigationMetadata(int32_t browser_id, const char* frame_id,
+                                orbit_navigation_metadata_t* metadata) {
+  if (!OnValidUIThread() || !frame_id || !metadata ||
+      metadata->struct_size < sizeof(*metadata)) return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  auto frame = host ? host->GetFrameByIdentifier(frame_id) : nullptr;
+  auto* render_frame = frame ? static_cast<CefFrameHostImpl*>(frame.get())->GetRenderFrameHost() : nullptr;
+  auto* pending = render_frame ? content::GetWindowCreationMetadata(render_frame) : nullptr;
+  if (!pending) return 0;
+  metadata->transition_type = pending->is_form_submission ? TT_FORM_SUBMIT : TT_LINK;
+  metadata->method = pending->has_post_data ? "POST" : "GET";
+  metadata->has_body = pending->has_post_data ? 1 : 0;
+  return 1;
+}
+
+int32_t SetAutomaticPiP(int32_t browser_id, int32_t automatic) {
+  if (!OnValidUIThread() || (automatic != 0 && automatic != 1)) return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  auto* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents || !CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id) ||
+      (automatic && contents->HasPictureInPictureVideo())) return 0;
+  auto* controller = content::PictureInPictureWindowController::
+      GetOrCreateVideoPictureInPictureController(contents);
+  controller->SetBrowserInitiatedAutomaticPictureInPicture(automatic != 0);
+  return 1;
+}
+
+int32_t WindowCreated(uint64_t window_token, void* nswindow) {
+  if (!OnValidUIThread() || !nswindow) {
+    return 0;
+  }
+  NSWindow* window = (__bridge NSWindow*)nswindow;
+  if (![window isKindOfClass:[NSWindow class]]) {
+    return 0;
+  }
+  return orbit::WindowCreated(window_token, window) ? 1 : 0;
+}
+
+int32_t WindowDestroyed(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  for (Browser* browser : orbit::GetLogicalBrowsers(window_token)) {
+    for (int i = 0; i < browser->tab_strip_model()->count(); ++i)
+      orbit::HidePasswordPrompt(browser->tab_strip_model()->GetWebContentsAt(i));
+  }
+  return orbit::WindowDestroyed(window_token);
+}
+
+int32_t WindowActivationChanged(uint64_t window_token, int32_t active) {
+  if (!OnValidUIThread() || !orbit::IsKnownWindow(window_token)) {
+    return 0;
+  }
+  for (Browser* browser : orbit::GetLogicalBrowsers(window_token)) {
+    auto* manager = BrowserActiveStateManager::From(browser);
+    if (!manager) {
+      continue;
+    }
+    if (!active) {
+      for (int i = 0; i < browser->tab_strip_model()->count(); ++i)
+        orbit::HidePasswordPrompt(browser->tab_strip_model()->GetWebContentsAt(i));
+    }
+    if (active) {
+      manager->DidBecomeActive();
+    } else {
+      manager->DidBecomeInactive();
+    }
+  }
+  return 1;
+}
+
+int32_t WindowBoundsChanged(uint64_t window_token) {
+  if (!OnValidUIThread() || !orbit::IsKnownWindow(window_token)) {
+    return 0;
+  }
+  for (Browser* browser : orbit::GetLogicalBrowsers(window_token)) {
+    // Same notification as BrowserView::TryNotifyWindowBoundsChanged().
+    if (auto* controller =
+            extensions::BrowserExtensionWindowController::From(browser)) {
+      controller->NotifyWindowBoundsChanged();
+    }
+  }
+  return 1;
+}
+
+int32_t PrepareHostedTab(void* parent_nsview,
+                         uint64_t window_token,
+                         int32_t index) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  return orbit::PrepareHostedTab(
+             CAST_NSVIEW_TO_CEF_WINDOW_HANDLE((__bridge NSView*)parent_nsview),
+             window_token, index)
+             ? 1
+             : 0;
+}
+
+int32_t CancelHostedTab(void* parent_nsview) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  return orbit::CancelHostedTab(CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+             (__bridge NSView*)parent_nsview))
+             ? 1
+             : 0;
+}
+
+int32_t AttachView(int32_t browser_id, void* parent_nsview) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  auto* delegate =
+      CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id);
+  if (!delegate) {
+    return 0;
+  }
+  return delegate->AttachToParent(CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+             (__bridge NSView*)parent_nsview))
+             ? 1
+             : 0;
+}
+
+CefRefPtr<ChromeBrowserHostImpl> GetChromeHost(int32_t browser_id) {
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!host || !host->IsChromeStyle()) {
+    return nullptr;
+  }
+  return ChromeBrowserHostImpl::FromBaseChecked(host);
+}
+
+int32_t ActivateTab(int32_t browser_id) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->browser() ||
+      !CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id)) {
+    return 0;
+  }
+  auto* model = host->browser()->tab_strip_model();
+  const int index = model->GetIndexOfWebContents(host->GetWebContents());
+  if (index == TabStripModel::kNoTab) {
+    return 0;
+  }
+  model->ActivateTabAt(index);
+  return 1;
+}
+
+int32_t GetTabInfo(int32_t browser_id, orbit_tab_info_t* info) {
+  if (!OnValidUIThread() || !info ||
+      info->struct_size < sizeof(orbit_tab_info_t)) {
+    return 0;
+  }
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!host) {
+    return 0;
+  }
+  info->tab_id = -1;
+  info->window_id = -1;
+  info->index = -1;
+  info->active = 0;
+  info->hosted = 0;
+  info->window_token = 0;
+  auto* contents = host->GetWebContents();
+  if (!contents) {
+    return 1;
+  }
+  info->tab_id = extensions::ExtensionTabUtil::GetTabId(contents);
+  info->window_id = extensions::ExtensionTabUtil::GetWindowIdOfTab(contents);
+  if (auto* delegate =
+          CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id)) {
+    info->hosted = 1;
+    info->window_token = delegate->window_token();
+  }
+  if (host->IsChromeStyle()) {
+    auto chrome_host = ChromeBrowserHostImpl::FromBaseChecked(host);
+    if (Browser* browser = chrome_host->browser()) {
+      auto* model = browser->tab_strip_model();
+      info->index = model->GetIndexOfWebContents(contents);
+      info->active = info->index != TabStripModel::kNoTab &&
+                             info->index == model->active_index()
+                         ? 1
+                         : 0;
+    }
+  }
+  return 1;
+}
+
+int32_t WindowBrowserCount(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return static_cast<int32_t>(orbit::GetLogicalBrowsers(window_token).size());
+}
+
+int32_t MoveTab(int32_t browser_id,
+                uint64_t window_token,
+                int32_t index,
+                void* parent_nsview) {
+  if (!OnValidUIThread()) {
+    return 0;
+  }
+  auto host = GetChromeHost(browser_id);
+  if (!host || !host->OrbitMoveToWindow(window_token, index)) {
+    return 0;
+  }
+  orbit::HidePasswordPrompt(host->GetWebContents());
+  if (parent_nsview) {
+    if (auto* delegate =
+            CefBrowserPlatformDelegateChromeHosted::FromBrowserId(browser_id)) {
+      delegate->AttachToParent(CAST_NSVIEW_TO_CEF_WINDOW_HANDLE(
+          (__bridge NSView*)parent_nsview));
+    }
+  }
+  return 1;
+}
+
+int32_t ProfileLoaded(const char* path) {
+  if (!OnValidUIThread() || !path || path[0] != '/' || !g_browser_process) {
+    return -1;
+  }
+  ProfileManager* manager = g_browser_process->profile_manager();
+  if (!manager) {
+    return -1;
+  }
+  return manager->GetProfileByPath(base::FilePath(path)) ? 1 : 0;
+}
+
+int32_t HoldWindow(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return orbit::HoldWindow(window_token);
+}
+
+int32_t ReleaseWindow(uint64_t window_token) {
+  if (!OnValidUIThread()) {
+    return -1;
+  }
+  return orbit::ReleaseWindow(window_token);
+}
