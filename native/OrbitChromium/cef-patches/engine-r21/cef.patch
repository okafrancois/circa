+// Cache activations skip navigation throttles. Ask the same policy at their
+// commit gate, before the cached document replaces the current document.
+class CachedNavigationCondition final : public content::CommitDeferringCondition {
+ public:
+  explicit CachedNavigationCondition(content::NavigationHandle& handle)
+      : CommitDeferringCondition(handle) {}
+  Result WillCommitNavigation(base::OnceClosure) override {
+    auto& handle = GetNavigationHandle();
+    auto* contents = handle.GetWebContents();
+    bool cancel = false;
+    NavigationOnUIThread(&handle, false,
+        base::BindOnce([](bool* result, bool ignored) { *result = ignored; }, &cancel));
+    if (cancel) {
+      // Stop destroys this condition; do not access members after this call.
+      contents->Stop();
+      return Result::kCancelled;
+    }
+    return Result::kProceed;
+  }
+  const char* TraceEventName() const override { return "CefCachedNavigationPolicy"; }
+};
