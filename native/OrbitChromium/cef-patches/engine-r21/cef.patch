+void CefBrowserManager::GetBoosts(GetBoostsCallback callback) {
+  // This receiver runs on IO. BrowserContext and process-host lookup belong to UI;
+  // the reply returns to the receiver sequence without retaining this connection.
+  CEF_TASK_RUNNER<CEF_UIT>()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce([](content::ChildProcessId id) {
+        auto* host = content::RenderProcessHost::FromID(id);
+        return orbit::BoostSnapshot(host ? host->GetBrowserContext() : nullptr);
+      }, render_process_id_),
+      base::BindOnce([](GetBoostsCallback cb, std::string snapshot) {
+        std::move(cb).Run(snapshot);
+      }, std::move(callback)));
+}
