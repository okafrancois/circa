+namespace orbit {
+namespace {
+const char kRegistry = 0;
+struct Registry : base::SupportsUserData::Data {
+  uint64_t revision = 0;
+  std::string json;
+  base::DictValue snapshot;
+};
+// Completion owns its pipes until every live renderer installs the revision.
+struct Completion : std::enable_shared_from_this<Completion> {
+  orbit_boost_ack_t callback; void* context; uint64_t revision; size_t remaining = 1;
+  bool finished = false;
+  std::vector<mojo::Remote<cef::mojom::RenderManager>> pipes;
+  void Done(bool ok) {
+    if (finished) return;
+    if (ok && --remaining) return;
+    finished = true;
+    auto cb = callback; callback = nullptr;
+    pipes.clear();
+    cb(context, revision, ok ? 1 : 0);
+  }
+};
+}
+std::string BoostSnapshot(content::BrowserContext* context) {
+  if (!context || context->IsOffTheRecord()) return {};
+  auto* registry = static_cast<Registry*>(context->GetUserData(&kRegistry));
+  return registry ? registry->json : std::string();
+}
+int32_t ReplaceBoosts(const char* path, const char* json, uint64_t revision,
+                     orbit_boost_ack_t callback, void* context) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (!path || path[0] != '/' || !json || !callback || !g_browser_process ||
+      !g_browser_process->profile_manager()) return 0;
+  auto* profile = g_browser_process->profile_manager()->GetProfileByPath(base::FilePath(path));
+  if (!profile || profile->IsOffTheRecord()) return 0;
+  auto parsed = ParseBoosts(json); uint64_t parsed_revision;
+  if (!parsed || !BoostRevision(*parsed, parsed_revision) || revision != parsed_revision) return 0;
+  auto* registry = static_cast<Registry*>(profile->GetUserData(&kRegistry));
+  if (registry) {
+    if (revision < registry->revision || (revision == registry->revision && *parsed != registry->snapshot)) return 0;
+    for (const auto& b : *parsed->FindList("boosts")) {
+      for (const auto& old : *registry->snapshot.FindList("boosts")) {
+        if (*b.GetDict().FindString("id") != *old.GetDict().FindString("id")) continue;
+        uint64_t next, prev; BoostRevision(b.GetDict(), next); BoostRevision(old.GetDict(), prev);
+        if (next < prev || (next == prev && b != old)) return 0;
+      }
+    }
+  } else {
+    auto owned = std::make_unique<Registry>(); registry = owned.get();
+    profile->SetUserData(&kRegistry, std::move(owned));
+  }
+  registry->revision = revision; registry->json = json; registry->snapshot = std::move(*parsed);
+  auto completion = std::make_shared<Completion>();
+  completion->callback = callback; completion->context = context; completion->revision = revision;
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+    auto* host = it.GetCurrentValue();
+    if (host->GetBrowserContext() != profile || !host->IsInitializedAndNotDead()) continue;
+    auto pipe = CefBrowserManager::GetRenderManagerForProcess(host);
+    ++completion->remaining;
+    pipe.set_disconnect_handler(base::BindOnce([](std::shared_ptr<Completion> c) { c->Done(false); }, completion));
+    pipe->UpdateBoosts(json, base::BindOnce([](std::shared_ptr<Completion> c) { c->Done(true); }, completion));
+    completion->pipes.push_back(std::move(pipe));
+  }
+  auto runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+  runner->PostTask(FROM_HERE, base::BindOnce([](std::shared_ptr<Completion> c) { c->Done(true); }, completion));
+  runner->PostDelayedTask(FROM_HERE, base::BindOnce([](std::shared_ptr<Completion> c) { c->Done(false); }, completion), base::Seconds(5));
+  return 1;
+}
+}  // namespace orbit
