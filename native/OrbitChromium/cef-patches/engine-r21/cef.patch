@@ -0,0 +1,30 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_installer_downloads.h"
+
+namespace orbit {
+
+bool IsWebstoreInstallerTransfer(const InstallerTransferFacts& facts) {
+  if (facts.source != download::DownloadSource::EXTENSION_INSTALLER ||
+      !facts.chrome_style || !facts.same_browser_context ||
+      facts.off_the_record || facts.user_data_dir.empty() ||
+      facts.forced_target.empty() || facts.forced_target.ReferencesParent() ||
+      !facts.forced_target.IsAbsolute() ||
+      facts.forced_target.Extension() != FILE_PATH_LITERAL(".crx") ||
+      facts.forced_target.DirName() !=
+          facts.user_data_dir.Append(kWebstoreDownloadFolder)) {
+    return false;
+  }
+  // Secondary, native comparison (extension_urls::IsWebstoreUpdateUrl):
+  // scheme, host and path only; the source above is the authority.
+  const GURL& url = facts.original_url;
+  const GURL& store = facts.webstore_update_url;
+  return url.is_valid() && store.is_valid() && url.SchemeIs("https") &&
+         url.scheme() == store.scheme() && url.host() == store.host() &&
+         url.path() == store.path() && !url.has_username() &&
+         !url.has_password() && !url.has_ref();
+}
+
+}  // namespace orbit
diff --git a/libcef/browser/orbit/orbit_installer_downloads.h b/libcef/browser/orbit/orbit_installer_downloads.h
new file mode 100644
index 0000000000000000000000000000000000000000..0ebff15546d7f99c7d1bada330d76a05b479fdc9
--- /dev/null
+++ b/libcef/browser/orbit/orbit_installer_downloads.h
@@ -0,0 +1,44 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_INSTALLER_DOWNLOADS_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_INSTALLER_DOWNLOADS_H_
+#pragma once
+
+#include "base/files/file_path.h"
+#include "components/download/public/common/download_source.h"
+#include "url/gurl.h"
+
+namespace orbit {
+
+// EXT-OUTCOME-R2. The Chrome Web Store installer downloads its CRX through the
+// download manager (extensions::WebstoreInstaller::StartDownload): source
+// EXTENSION_INSTALLER, a forced target "<user data>/Webstore Downloads/<id>_
+// <n>.crx", the Store update URL, the Store tab's own browser context. CEF
+// would offer that transfer to the embedder's CefDownloadHandler like any
+// download. Native facts only: no URL query, MIME type or page is trusted.
+struct InstallerTransferFacts {
+  download::DownloadSource source = download::DownloadSource::UNKNOWN;
+  base::FilePath forced_target;
+  GURL original_url;
+  GURL webstore_update_url;  // extension_urls::GetWebstoreUpdateUrl().
+  base::FilePath user_data_dir;  // ExtensionsBrowserClient::GetUserDataDir().
+  bool chrome_style = false;  // Unhandled means Chrome handling, not cancel.
+  bool same_browser_context = false;  // Item context is the browser's own.
+  bool off_the_record = true;
+};
+
+// The folder WebstoreInstaller::DownloadCrx uses (kWebstoreDownloadFolder,
+// file-local in extensions/browser/webstore_installer.cc).
+inline constexpr base::FilePath::CharType kWebstoreDownloadFolder[] =
+    FILE_PATH_LITERAL("Webstore Downloads");
+
+// True only for the installer's own transfer, which CEF then keeps away from
+// the embedder's download handler entirely: Chrome's target determination,
+// hidden download UI, approval and CrxInstaller verification apply unchanged.
+bool IsWebstoreInstallerTransfer(const InstallerTransferFacts& facts);
+
+}  // namespace orbit
+
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_INSTALLER_DOWNLOADS_H_
diff --git a/libcef/browser/orbit/orbit_installer_downloads_unittest.cc b/libcef/browser/orbit/orbit_installer_downloads_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0cb52362b0112463e744d088cf1456bcab3ead62
--- /dev/null
+++ b/libcef/browser/orbit/orbit_installer_downloads_unittest.cc
@@ -0,0 +1,102 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_installer_downloads.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace orbit {
+namespace {
+
+InstallerTransferFacts Installer() {
+  InstallerTransferFacts facts;
+  facts.source = download::DownloadSource::EXTENSION_INSTALLER;
+  facts.user_data_dir = base::FilePath(FILE_PATH_LITERAL("/synthetic/root"));
+  facts.forced_target = facts.user_data_dir.Append(kWebstoreDownloadFolder)
+                            .Append(FILE_PATH_LITERAL(
+                                "abcdefghijklmnopabcdefghijklmnop_42.crx"));
+  facts.webstore_update_url =
+      GURL("https://clients2.google.com/service/update2/crx");
+  facts.original_url = GURL(
+      "https://clients2.google.com/service/update2/crx?response=redirect&x=id%"
+      "3Dabcdefghijklmnopabcdefghijklmnop%26installsource%3Dondemand%26uc");
+  facts.chrome_style = true;
+  facts.same_browser_context = true;
+  facts.off_the_record = false;
+  return facts;
+}
+
+TEST(OrbitInstallerDownloadsTest, InstallerOwnTransferIsRecognized) {
+  EXPECT_TRUE(IsWebstoreInstallerTransfer(Installer()));
+}
+
+// The review's counterexample: identical public URL/MIME/document facts but an
+// ordinary download source stays the embedder's ordinary download.
+TEST(OrbitInstallerDownloadsTest, OrdinarySourceWithStoreShapeIsNotOwned) {
+  for (auto source : {download::DownloadSource::UNKNOWN,
+                      download::DownloadSource::NAVIGATION,
+                      download::DownloadSource::DRAG_AND_DROP,
+                      download::DownloadSource::FROM_RENDERER,
+                      download::DownloadSource::EXTENSION_API,
+                      download::DownloadSource::CONTEXT_MENU,
+                      download::DownloadSource::WEB_CONTENTS_API,
+                      download::DownloadSource::INTERNAL_API,
+                      download::DownloadSource::RETRY}) {
+    InstallerTransferFacts facts = Installer();
+    facts.source = source;
+    EXPECT_FALSE(IsWebstoreInstallerTransfer(facts));
+  }
+}
+
+TEST(OrbitInstallerDownloadsTest, ForcedInternalTargetIsRequired) {
+  const base::FilePath::CharType* targets[] = {
+      FILE_PATH_LITERAL(""),
+      FILE_PATH_LITERAL("/synthetic/root/Downloads/x.crx"),
+      FILE_PATH_LITERAL("/synthetic/root/Webstore Downloads/x.zip"),
+      FILE_PATH_LITERAL("/synthetic/root/Webstore Downloads/sub/x.crx"),
+      FILE_PATH_LITERAL("/synthetic/root/Webstore Downloads/../x.crx"),
+      FILE_PATH_LITERAL("/synthetic/other/Webstore Downloads/x.crx"),
+      FILE_PATH_LITERAL("Webstore Downloads/x.crx"),
+  };
+  for (const auto* target : targets) {
+    InstallerTransferFacts facts = Installer();
+    facts.forced_target = base::FilePath(target);
+    EXPECT_FALSE(IsWebstoreInstallerTransfer(facts)) << target;
+  }
+  InstallerTransferFacts facts = Installer();
+  facts.user_data_dir = base::FilePath();
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(facts));
+}
+
+TEST(OrbitInstallerDownloadsTest, ContextStyleAndProfileAreRequired) {
+  InstallerTransferFacts alloy = Installer();
+  alloy.chrome_style = false;  // Unhandled would cancel on Alloy.
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(alloy));
+  InstallerTransferFacts foreign = Installer();
+  foreign.same_browser_context = false;
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(foreign));
+  InstallerTransferFacts incognito = Installer();
+  incognito.off_the_record = true;
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(incognito));
+}
+
+TEST(OrbitInstallerDownloadsTest, UpdateUrlIsASecondaryNativeCheck) {
+  for (const char* url :
+       {"http://clients2.google.com/service/update2/crx?x=1",
+        "https://clients2.google.com.example/service/update2/crx",
+        "https://clients2.google.com/service/update2/crxx",
+        "https://user@clients2.google.com/service/update2/crx",
+        "https://clients2.google.com/service/update2/crx#fragment",
+        "https://example.invalid/extension.crx", "not a url"}) {
+    InstallerTransferFacts facts = Installer();
+    facts.original_url = GURL(url);
+    EXPECT_FALSE(IsWebstoreInstallerTransfer(facts)) << url;
+  }
+  InstallerTransferFacts facts = Installer();
+  facts.webstore_update_url = GURL();
+  EXPECT_FALSE(IsWebstoreInstallerTransfer(facts));
+}
+
+}  // namespace
+}  // namespace orbit
diff --git a/libcef/browser/orbit/orbit_lifecycle.inc b/libcef/browser/orbit/orbit_lifecycle.inc
new file mode 100644
index 0000000000000000000000000000000000000000..b4189e8335ac45f96b2797b4bbe5aabe7b5cd11b
--- /dev/null
+++ b/libcef/browser/orbit/orbit_lifecycle.inc
@@ -0,0 +1,271 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "chrome/browser/performance_manager/policies/discard_eligibility_policy.h"
+#include "chrome/browser/performance_manager/public/user_tuning/user_tuning_utils.h"
+#include "components/performance_manager/public/freezing/freezing.h"
+#include "components/performance_manager/public/graph/graph.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "content/public/browser/media_player_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include <algorithm>
+#include <cstring>
+
+namespace {
+namespace pm = performance_manager;
+class LifecycleObservation;
+using LifecycleMap = std::map<int32_t, std::shared_ptr<LifecycleObservation>>;
+LifecycleMap& Lifecycles() {
+  static base::NoDestructor<LifecycleMap> map;
+  return *map;
+}
+bool PageIsVisible(content::WebContents* wc) {
+  if (!wc || wc->GetVisibility() != content::Visibility::VISIBLE)
+    return false;
+  auto* view = wc->GetRenderWidgetHostView();
+  NSView* native = wc->GetNativeView().GetNativeNSView();
+  return view && view->IsShowing() && native && native.window.isVisible &&
+         !native.isHiddenOrHasHiddenAncestor;
+}
+uint64_t NextDocumentID() {
+  static uint64_t next = 0;
+  return ++next;
+}
+class LifecycleObservation final
+    : public content::WebContentsObserver,
+      public pm::PageNodeObserver,
+      public MediaStreamCaptureIndicator::Observer,
+      public std::enable_shared_from_this<LifecycleObservation> {
+ public:
+  LifecycleObservation(int32_t id, content::WebContents* wc)
+      : content::WebContentsObserver(wc),
+        document_id(NextDocumentID()),
+        id_(id) {
+    if (pm::PerformanceManager::IsAvailable()) {
+      graph_ = pm::PerformanceManager::GetGraph();
+      graph_->AddPageNodeObserver(this);
+    }
+    indicator_ = MediaCaptureDevicesDispatcher::GetInstance()
+                     ->GetMediaStreamCaptureIndicator();
+    indicator_->AddObserver(this);
+  }
+  ~LifecycleObservation() override { Detach(); }
+  void Detach() {
+    if (graph_) {
+      graph_->RemovePageNodeObserver(this);
+      graph_ = nullptr;
+    }
+    if (indicator_) {
+      indicator_->RemoveObserver(this);
+      indicator_.reset();
+    }
+  }
+  bool Read(orbit_page_lifecycle_t* s) {
+    const uint32_t requested_size = s->struct_size;
+    constexpr uint32_t kV16Size = offsetof(orbit_page_lifecycle_t,
+                                             cannot_freeze_mask);
+    if (requested_size < kV16Size)
+      return false;
+    auto* wc = web_contents();
+    if (!wc || !pm::PerformanceManager::IsAvailable())
+      return false;
+    auto page = pm::PerformanceManager::GetPrimaryPageNodeForWebContents(wc);
+    if (!page)
+      return false;
+    std::memset(s, 0, std::min<size_t>(requested_size, sizeof(*s)));
+    s->struct_size = requested_size;
+    s->playing_video = wc->GetCurrentlyPlayingVideoCount() > 0;
+    s->playing_media = !players_.empty() || s->playing_video;
+    s->audio_context_running = !audio_contexts_.empty();
+    s->audible = page->IsAudible();
+    s->pip = page->HasPictureInPicture();
+    s->had_form_interaction = page->HadFormInteraction();
+    s->had_user_edits = page->HadUserEdits();
+    s->web_lock = page->IsHoldingWebLock();
+    s->idb_lock = page->IsHoldingBlockingIndexedDBLock();
+    s->webrtc = page->UsesWebRTC();
+    s->document_id = document_id;
+    s->lifecycle = wc->WasDiscarded()
+                       ? 2
+                       : (page->GetLifecycleState() ==
+                                  pm::PageNode::LifecycleState::kFrozen
+                              ? 1
+                              : 0);
+    if (indicator_) {
+      s->capturing = (indicator_->IsCapturingVideo(wc) ? 1u : 0u) |
+                     (indicator_->IsCapturingAudio(wc) ? 2u : 0u) |
+                     (indicator_->IsBeingMirrored(wc) ? 4u : 0u) |
+                     (indicator_->IsCapturingTab(wc) ? 8u : 0u) |
+                     (indicator_->IsCapturingWindow(wc) ? 16u : 0u) |
+                     (indicator_->IsCapturingDisplay(wc) ? 32u : 0u);
+    }
+    auto* policy = pm::policies::DiscardEligibilityPolicy::GetFromGraph(
+        pm::PerformanceManager::GetGraph());
+    if (!policy)
+      return false;
+    std::vector<pm::policies::CannotDiscardReason> reasons;
+    policy->CanDiscard(page.get(), ::mojom::LifecycleUnitDiscardReason::URGENT,
+                       false, &reasons);
+    for (auto reason : reasons)
+      s->cannot_discard_mask |= uint64_t{1} << static_cast<unsigned>(reason);
+    if (requested_size >= sizeof(*s)) {
+      s->cannot_freeze_mask = CannotFreezeMask(
+          pm::freezing::GetCanFreezeDetailsForPageNode(page.get()));
+    }
+    s->footprint_kb =
+        pm::user_tuning::GetDiscardedMemoryEstimateForPage(page.get()).InKiB();
+    auto* frame = wc->GetPrimaryMainFrame();
+    if (frame)
+      s->renderer_pid = frame->GetProcess()->GetProcess().Pid();
+    return true;
+  }
+  void Notify() {
+    if (pending_ || !changed)
+      return;
+    pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](std::weak_ptr<LifecycleObservation> weak) {
+                         if (auto self = weak.lock()) {
+                           self->pending_ = false;
+                           self->Emit(0, 0);
+                         }
+                       },
+                       weak_from_this()));
+  }
+  void Emit(int event, int initiator) {
+    auto alive = shared_from_this();
+    orbit_page_lifecycle_t state{};
+    state.struct_size = sizeof(state);
+    if (changed && Read(&state))
+      changed(context, event, initiator, &state);
+  }
+  void MediaStartedPlaying(const MediaPlayerInfo&,
+                           const content::MediaPlayerId& id) override {
+    players_.insert(id);
+    Notify();
+  }
+  void MediaStoppedPlaying(const MediaPlayerInfo&,
+                           const content::MediaPlayerId& id,
+                           MediaStoppedReason) override {
+    players_.erase(id);
+    Notify();
+  }
+  void AudioContextPlaybackStarted(const AudioContextId& id) override {
+    audio_contexts_.insert(id);
+    Notify();
+  }
+  void AudioContextPlaybackStopped(const AudioContextId& id) override {
+    audio_contexts_.erase(id);
+    Notify();
+  }
+  void OnAudioStateChanged(bool) override { Notify(); }
+  void PrimaryPageChanged(content::Page&) override {
+    document_id = NextDocumentID();
+    Notify();
+  }
+  void AboutToBeDiscarded(content::WebContents* replacement) override {
+    discard_initiator_ = embedder_discard ? 1 : 2;
+    Emit(1, discard_initiator_);
+    // Current Chromium discards in place; retain observation on older
+    // replacement paths too.
+    if (replacement && replacement != web_contents())
+      Observe(replacement);
+  }
+  void WasDiscarded() override {
+    players_.clear();
+    audio_contexts_.clear();
+    Emit(2, discard_initiator_ ? discard_initiator_ : 2);
+    Notify();
+  }
+  void WebContentsDestroyed() override {
+    auto alive = shared_from_this();
+    auto cb = changed;
+    changed = nullptr;
+    Detach();
+    Observe(nullptr);
+    Lifecycles().erase(id_);
+    if (cb)
+      cb(context, 3, 0, nullptr);
+  }
+#define ORBIT_PAGE_CHANGE(method)                    \
+  void method(const pm::PageNode* p) override {      \
+    if (p->GetWebContents().get() == web_contents()) \
+      Notify();                                      \
+  }
+  ORBIT_PAGE_CHANGE(OnIsVisibleChanged)
+  ORBIT_PAGE_CHANGE(OnIsAudibleChanged)
+  ORBIT_PAGE_CHANGE(OnHasPictureInPictureChanged)
+  ORBIT_PAGE_CHANGE(OnPageLifecycleStateChanged)
+  ORBIT_PAGE_CHANGE(OnPageIsHoldingWebLockChanged)
+  ORBIT_PAGE_CHANGE(OnPageIsHoldingBlockingIndexedDBLockChanged)
+  ORBIT_PAGE_CHANGE(OnPageUsesWebRTCChanged)
+  ORBIT_PAGE_CHANGE(OnHadFormInteractionChanged)
+  ORBIT_PAGE_CHANGE(OnHadUserEditsChanged)
+  ORBIT_PAGE_CHANGE(OnMainFrameDocumentChanged)
+#undef ORBIT_PAGE_CHANGE
+#define ORBIT_CAPTURE_CHANGE(method)                     \
+  void method(content::WebContents* wc, bool) override { \
+    if (wc == web_contents())                            \
+      Notify();                                          \
+  }
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingVideoChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingAudioChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsBeingMirroredChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingTabChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingWindowChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingDisplayChanged)
+#undef ORBIT_CAPTURE_CHANGE
+  orbit_lifecycle_callback_t changed = nullptr;
+  void* context = nullptr;
+  bool embedder_discard = false;
+  uint64_t document_id;
+
+ private:
+  int32_t id_;
+  raw_ptr<pm::Graph> graph_ = nullptr;
+  scoped_refptr<MediaStreamCaptureIndicator> indicator_;
+  std::set<content::MediaPlayerId> players_;
+  std::set<AudioContextId> audio_contexts_;
+  bool pending_ = false;
+  int discard_initiator_ = 0;
+};
+std::shared_ptr<LifecycleObservation> EnsureLifecycle(int32_t id) {
+  auto it = Lifecycles().find(id);
+  if (it != Lifecycles().end())
+    return it->second;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  auto* wc = host ? host->GetWebContents() : nullptr;
+  if (!wc)
+    return {};
+  auto observation = std::make_shared<LifecycleObservation>(id, wc);
+  Lifecycles()[id] = observation;
+  return observation;
+}
+int32_t PageLifecycle(int32_t id, orbit_page_lifecycle_t* state) {
+  if (!OnValidUIThread() || !state ||
+      state->struct_size < offsetof(orbit_page_lifecycle_t,
+                                    cannot_freeze_mask))
+    return 0;
+  auto observation = EnsureLifecycle(id);
+  return observation && observation->Read(state);
+}
+int32_t PageLifecycleObserve(int32_t id,
+                             orbit_lifecycle_callback_t callback,
+                             void* context) {
+  if (!OnValidUIThread())
+    return 0;
+  auto observation = EnsureLifecycle(id);
+  if (!observation)
+    return 0;
+  observation->changed = callback;
+  observation->context = context;
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_media.inc b/libcef/browser/orbit/orbit_media.inc
new file mode 100644
index 0000000000000000000000000000000000000000..7c2cf3db506b1cb48318bb4522de832ffd5b94e1
--- /dev/null
+++ b/libcef/browser/orbit/orbit_media.inc
@@ -0,0 +1,115 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include <cmath>
+#include "content/public/browser/media_session.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/media_session/public/cpp/media_image.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/cpp/media_position.h"
+
+namespace {
+class MediaObservation;
+using MediaMap = std::map<int32_t, std::shared_ptr<MediaObservation>>;
+MediaMap& MediaObservers() { static base::NoDestructor<MediaMap> map; return *map; }
+class MediaObservation final : public content::WebContentsObserver,
+    public media_session::mojom::MediaSessionObserver,
+    public std::enable_shared_from_this<MediaObservation> {
+ public:
+  MediaObservation(int32_t id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), id_(id) {
+    content::MediaSession::Get(contents)->AddObserver(receiver_.BindNewPipeAndPassRemote());
+  }
+  orbit_json_changed_t callback = nullptr;
+  void* context = nullptr;
+  std::string Snapshot() {
+    auto* session = content::MediaSession::GetIfExists(web_contents());
+    if (!session) return "{}";
+    auto info = session->GetMediaSessionInfoSync();
+    const auto& metadata = session->GetMediaSessionMetadata();
+    base::DictValue value;
+    value.Set("title", base::UTF16ToUTF8(metadata.title));
+    value.Set("artist", base::UTF16ToUTF8(metadata.artist));
+    value.Set("album", base::UTF16ToUTF8(metadata.album));
+    value.Set("playbackState", static_cast<int>(info->playback_state));
+    value.Set("sessionState", static_cast<int>(info->state));
+    value.Set("artwork", artwork_.Clone());
+    base::ListValue actions;
+    for (auto action : session->GetMediaSessionActionsSync()) actions.Append(static_cast<int>(action));
+    value.Set("actions", std::move(actions));
+    if (const auto position = session->GetMediaSessionPosition()) {
+      const double current = position->GetPosition().InSecondsF();
+      const double duration = position->duration().InSecondsF();
+      const double rate = position->playback_rate();
+      if (std::isfinite(current)) value.Set("position", current);
+      if (std::isfinite(duration)) value.Set("duration", duration);
+      if (std::isfinite(rate)) value.Set("playbackRate", rate);
+    }
+    return base::WriteJson(value).value_or("{}");
+  }
+  void MediaSessionInfoChanged(media_session::mojom::MediaSessionInfoPtr) override { Notify(); }
+  void MediaSessionMetadataChanged(const std::optional<media_session::MediaMetadata>&) override { Notify(); }
+  void MediaSessionActionsChanged(const std::vector<media_session::mojom::MediaSessionAction>&) override { Notify(); }
+  void MediaSessionImagesChanged(const base::flat_map<media_session::mojom::MediaSessionImageType,
+      std::vector<media_session::MediaImage>>& images) override {
+    artwork_.clear();
+    auto it = images.find(media_session::mojom::MediaSessionImageType::kArtwork);
+    if (it != images.end()) for (const auto& image : it->second) artwork_.Append(image.src.spec());
+    Notify();
+  }
+  void MediaSessionPositionChanged(const std::optional<media_session::MediaPosition>&) override { Notify(); }
+  void WebContentsDestroyed() override {
+    auto alive = shared_from_this();
+    callback = nullptr;
+    receiver_.reset();
+    Observe(nullptr);
+    MediaObservers().erase(id_);
+  }
+ private:
+  void Notify() {
+    auto alive = shared_from_this();
+    if (callback && web_contents()) {
+      auto text = Snapshot();
+      callback(context, text.c_str(), static_cast<uint32_t>(text.size()));
+    }
+  }
+  int32_t id_;
+  base::ListValue artwork_;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+};
+std::shared_ptr<MediaObservation> MediaObserver(int32_t id) {
+  auto* contents = SideContents(id);
+  if (!contents) return nullptr;
+  auto& item = MediaObservers()[id];
+  if (!item) item = std::make_shared<MediaObservation>(id, contents);
+  return item;
+}
+int32_t MediaSnapshot(int32_t id, char* out, uint32_t capacity) {
+  auto item = MediaObserver(id);
+  return item ? CopySideText(item->Snapshot(), out, capacity) : -1;
+}
+int32_t MediaObserve(int32_t id, orbit_json_changed_t cb, void* context) {
+  if (!OnValidUIThread()) return 0;
+  if (!cb) { MediaObservers().erase(id); return 1; }
+  auto item = MediaObserver(id);
+  if (!item) return 0;
+  item->callback = cb; item->context = context;
+  return 1;
+}
+int32_t MediaAction(int32_t id, int32_t action, double seconds) {
+  auto* contents = SideContents(id);
+  auto* session = contents ? content::MediaSession::GetIfExists(contents) : nullptr;
+  if (!session) return 0;
+  using Action = media_session::mojom::MediaSessionAction;
+  const auto actions = session->GetMediaSessionActionsSync();
+  const Action types[] = {Action::kPlay, Action::kPause, Action::kSeekTo, Action::kNextTrack, Action::kPreviousTrack};
+  if (action < 0 || action > 4 || !std::ranges::contains(actions, types[action])) return 0;
+  if (action == 2) {
+    const auto position = session->GetMediaSessionPosition();
+    if (!position || !std::isfinite(seconds) || seconds < 0 || seconds > position->duration().InSecondsF()) return 0;
+    session->SeekTo(base::Seconds(seconds));
+  } else if (action == 3) session->NextTrack();
+  else if (action == 4) session->PreviousTrack();
+  else if (action == 0) session->Resume(content::MediaSession::SuspendType::kUI);
+  else session->Suspend(content::MediaSession::SuspendType::kUI);
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_memory.inc b/libcef/browser/orbit/orbit_memory.inc
new file mode 100644
index 0000000000000000000000000000000000000000..a6e53809b044a01998f00ecef2fd15c5b2d2af1c
--- /dev/null
+++ b/libcef/browser/orbit/orbit_memory.inc
@@ -0,0 +1,79 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "base/json/json_writer.h"
+#include "mojo/public/cpp/bindings/callback_helpers.h"
+#include "services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.h"
+
+namespace {
+base::DictValue MemoryAllocator(
+    const memory_instrumentation::mojom::AllocatorMemDump& node) {
+  base::DictValue result, metrics, children;
+  for (const auto& [name, value] : node.numeric_entries)
+    metrics.Set(name, static_cast<double>(value));
+  for (const auto& [name, child] : node.children)
+    children.Set(name, MemoryAllocator(*child));
+  result.Set("metrics", std::move(metrics));
+  result.Set("children", std::move(children));
+  return result;
+}
+class MemoryRequest {
+ public:
+  MemoryRequest(orbit_memory_callback_t cb, void* ctx) : cb_(cb), ctx_(ctx) {}
+  void Finish(memory_instrumentation::mojom::RequestOutcome outcome,
+              memory_instrumentation::mojom::GlobalMemoryDumpPtr dump) {
+    if (!cb_)
+      return;
+    auto cb = cb_;
+    cb_ = nullptr;
+    base::DictValue result;
+    result.Set("outcome", static_cast<int>(outcome));
+    base::ListValue processes;
+    if (dump) {
+      for (const auto& process : dump->process_dumps) {
+        base::DictValue row, allocators;
+        row.Set("pid", static_cast<int>(process->pid));
+        row.Set("processType", static_cast<int>(process->process_type));
+        if (process->os_dump)
+          row.Set("privateFootprintKB",
+                  static_cast<double>(process->os_dump->private_footprint_kb));
+        for (const auto& [name, node] : process->chrome_allocator_dumps)
+          allocators.Set(name, MemoryAllocator(*node));
+        row.Set("allocators", std::move(allocators));
+        processes.Append(std::move(row));
+      }
+    }
+    result.Set("processes", std::move(processes));
+    std::string json;
+    base::JSONWriter::Write(result, &json);
+    const int status = !dump ? -1 :
+        outcome == memory_instrumentation::mojom::RequestOutcome::kSuccess ? 1 : 2;
+    cb(ctx_, status, json.data(), static_cast<uint32_t>(json.size()));
+  }
+ private:
+  orbit_memory_callback_t cb_;
+  void* ctx_;
+};
+int32_t MemoryDump(orbit_memory_callback_t cb, void* ctx) {
+  if (!OnValidUIThread() || !cb)
+    return 0;
+  auto* instrumentation = memory_instrumentation::MemoryInstrumentation::GetInstance();
+  if (!instrumentation)
+    return 0;
+  auto request = std::make_shared<MemoryRequest>(cb, ctx);
+  using namespace memory_instrumentation::mojom;
+  // Keep native hierarchy/metrics: parent and child totals overlap and must not
+  // be added together. Missing allocators differ from measured zero bytes.
+  instrumentation->GetCoordinator()->RequestGlobalMemoryDump(
+      base::trace_event::MemoryDumpType::kSummaryOnly,
+      base::trace_event::MemoryDumpLevelOfDetail::kBackground,
+      base::trace_event::MemoryDumpDeterminism::kNone,
+      {"partition_alloc/*", "malloc/*", "v8/*", "blink_gc/*", "cc/*", "discardable/*"},
+      mojo::WrapCallbackWithDefaultInvokeIfNotRun(
+          base::BindOnce(&MemoryRequest::Finish, request),
+          RequestOutcome::kTimeout, GlobalMemoryDumpPtr()));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE, base::BindOnce(&MemoryRequest::Finish, request,
+                               RequestOutcome::kTimeout, GlobalMemoryDumpPtr()),
+      base::Seconds(15));
+  return 1;
+}
+}  // namespace
