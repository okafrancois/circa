diff --git a/libcef/browser/orbit/orbit_password_prompt.mm b/libcef/browser/orbit/orbit_password_prompt.mm
new file mode 100644
index 0000000000000000000000000000000000000000..658aca478f6af5f0bb7db4630cbfdc8693da24e8
--- /dev/null
+++ b/libcef/browser/orbit/orbit_password_prompt.mm
@@ -0,0 +1,186 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "cef/libcef/browser/orbit/orbit_password_prompt.h"
+#include <map>
+#include <memory>
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/orbit/browser_platform_delegate_chrome_hosted.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/passwords/manage_passwords_ui_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "url/origin.h"
+
+namespace orbit {
+namespace {
+uint64_t NextGeneration() { static uint64_t value = 0; return ++value; }
+class Prompt;
+using Prompts = std::map<content::WebContents*, std::shared_ptr<Prompt>>;
+Prompts& Entries() { static base::NoDestructor<Prompts> entries; return *entries; }
+auto* Controller(content::WebContents* contents) {
+  return ManagePasswordsUIController::FromWebContents(contents);
+}
+bool Hosted(content::WebContents* contents) {
+  auto host = CefBrowserHostBase::GetBrowserForContents(contents);
+  return host && CefBrowserPlatformDelegateChromeHosted::FromBrowserId(host->GetIdentifier());
+}
+class Prompt final : public content::WebContentsObserver,
+                     public std::enable_shared_from_this<Prompt> {
+ public:
+  explicit Prompt(content::WebContents* contents) : WebContentsObserver(contents) {
+    auto host = CefBrowserHostBase::GetBrowserForContents(contents);
+    id_ = host->GetIdentifier();
+    profile_ = Profile::FromBrowserContext(contents->GetBrowserContext());
+    path_ = profile_->GetPath().value();
+  }
+  orbit_password_prompt_t Snapshot() const {
+    return {sizeof(orbit_password_prompt_t), 1, id_, state_, generation_,
+            path_.c_str(), origin_.c_str(), username_.c_str(), 1,
+            (state_ == 1 || state_ == 2) && !consumed_ ? 1 : 0};
+  }
+  void Emit(int event) {
+    auto keep_alive = shared_from_this();
+    if (!callback_) return;
+    const auto snapshot = Snapshot();
+    callback_(context_, event, &snapshot);
+  }
+  uint64_t Hide() {
+    const auto generation = generation_ = NextGeneration();
+    held_ = false;
+    if (shown_) { shown_ = false; Emit(2); }
+    return generation;
+  }
+  void Reset() {
+    Hide(); state_ = 0; held_ = false; consumed_ = false;
+    origin_.clear(); username_.clear();
+  }
+  void Update(bool show) {
+    auto* controller = Controller(web_contents());
+    if (!controller) return;
+    using namespace password_manager::ui;
+    const auto native_state = controller->GetState();
+    int state = native_state == PENDING_PASSWORD_STATE ? 1 :
+                native_state == PENDING_PASSWORD_UPDATE_STATE ? 2 :
+                native_state == SAVE_CONFIRMATION_STATE ? 3 : 0;
+    std::string origin, username;
+    if (state) {
+      const auto& pending = controller->GetPendingPassword();
+      origin = url::Origin::Create(pending.url).Serialize();
+      username = base::UTF16ToUTF8(pending.username_value);
+    }
+    const bool changed = state != state_ || origin != origin_ || username != username_;
+    if (changed) {
+      Hide();
+      if (!web_contents()) return;
+      state_ = state; origin_ = std::move(origin); username_ = std::move(username);
+      consumed_ = false; held_ = false;
+      generation_ = NextGeneration();
+      Emit(3);
+    }
+    if (!web_contents() || !state_ || consumed_) return;
+    controller = Controller(web_contents());
+    if (!controller) return;
+    if (show) {
+      // Keep the existing model alive even with presentation disabled. No decision
+      // is inferred from an absent shell UI or observer.
+      held_ = true;
+      controller->OnBubbleShown();
+    }
+    if (held_ && callback_ && !shown_ && web_contents()->GetVisibility() == content::Visibility::VISIBLE) {
+      shown_ = true;
+      Emit(1);
+    }
+  }
+  void OnVisibilityChanged(content::Visibility visibility) override {
+    if (visibility != content::Visibility::VISIBLE) Hide();
+  }
+  void WebContentsDestroyed() override {
+    auto keep_alive = shared_from_this();
+    Reset(); callback_ = nullptr;
+    Entries().erase(web_contents());
+  }
+  int id_ = 0, state_ = 0;
+  uint64_t generation_ = NextGeneration();
+  raw_ptr<Profile> profile_ = nullptr;
+  std::string path_, origin_, username_;
+  bool shown_ = false, held_ = false, consumed_ = false;
+  orbit_password_prompt_callback_t callback_ = nullptr;
+  void* context_ = nullptr;
+};
+std::shared_ptr<Prompt> Entry(content::WebContents* contents) {
+  auto& value = Entries()[contents];
+  if (!value) value = std::make_shared<Prompt>(contents);
+  return value;
+}
+std::shared_ptr<Prompt> Find(int id, const char* path) {
+  if (!CEF_CURRENTLY_ON_UIT() || !path) return nullptr;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  if (!host || !host->GetWebContents() || !Hosted(host->GetWebContents())) return nullptr;
+  auto* profile = Profile::FromBrowserContext(host->GetWebContents()->GetBrowserContext());
+  if (profile->IsOffTheRecord() || profile->GetPath().value() != path) return nullptr;
+  return Entry(host->GetWebContents());
+}
+}
+bool UpdatePasswordPrompt(content::WebContents* contents, bool show) {
+  if (!Hosted(contents)) return false;
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile->IsOffTheRecord()) Entry(contents)->Update(show);
+  return true;
+}
+bool HidePasswordPrompt(content::WebContents* contents) {
+  if (!Hosted(contents)) return false;
+  auto found = Entries().find(contents);
+  if (found != Entries().end()) found->second->Hide();
+  return true;
+}
+void ResetPasswordPrompt(content::WebContents* contents) {
+  auto found = Entries().find(contents);
+  if (found != Entries().end()) found->second->Reset();
+}
+int32_t PasswordPromptObserve(int32_t id, const char* path, orbit_password_prompt_callback_t cb, void* context) {
+  auto entry = Find(id, path); if (!entry) return 0;
+  entry->Hide(); entry->callback_ = cb; entry->context_ = context;
+  entry->Update(false);
+  return 1;
+}
+int32_t PasswordPromptSnapshot(int32_t id, const char* path, orbit_password_prompt_t* out) {
+  auto entry = Find(id, path);
+  if (!entry || !out || out->struct_size < sizeof(*out)) return 0;
+  *out = entry->Snapshot(); return 1;
+}
+int32_t PasswordPromptDecide(int32_t id, const char* path, uint64_t generation, int32_t decision) {
+  auto entry = Find(id, path);
+  if (!entry || generation != entry->generation_ || entry->consumed_ ||
+      (entry->state_ != 1 && entry->state_ != 2) || decision < 1 || decision > 3 ||
+      (decision == 2 && entry->state_ != 1)) return 0;
+  auto* controller = Controller(entry->web_contents());
+  if (!controller || (controller->GetState() != password_manager::ui::PENDING_PASSWORD_STATE &&
+                      controller->GetState() != password_manager::ui::PENDING_PASSWORD_UPDATE_STATE)) return 0;
+  const int state = entry->state_;
+  // Revoke before calling the model, but notify dismissal only after the
+  // decision has taken effect. A UI may unregister itself from its hide callback.
+  const bool was_shown = entry->shown_;
+  entry->consumed_ = true; entry->held_ = false; entry->shown_ = false;
+  entry->generation_ = NextGeneration();
+  if (decision == 1) {
+    const auto pending = controller->GetPendingPassword();
+    controller->SavePassword(pending.username_value, pending.password_value);
+  } else if (decision == 2) controller->NeverSavePassword();
+  else if (state == 2) controller->OnNopeUpdateClicked();
+  else controller->OnNotNowClicked();
+  if (was_shown) entry->Emit(2);
+  if (entry->web_contents()) {
+    if (auto* live = Controller(entry->web_contents())) live->OnBubbleHidden();
+    entry->Update(false);
+  }
+  return 1;
+}
+int32_t PasswordPromptReopen(int32_t id, const char* path, uint64_t generation) {
+  auto entry = Find(id, path);
+  if (!entry || entry->generation_ != generation || entry->consumed_ ||
+      (entry->state_ != 1 && entry->state_ != 2)) return 0;
+  entry->Update(true); return 1;
+}
+}
diff --git a/libcef/browser/orbit/orbit_password_store.inc b/libcef/browser/orbit/orbit_password_store.inc
new file mode 100644
index 0000000000000000000000000000000000000000..248527377d9d3ba674d62d65dc3b0de388af88ec
--- /dev/null
+++ b/libcef/browser/orbit/orbit_password_store.inc
@@ -0,0 +1,218 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include <deque>
+#include "base/memory/weak_ptr.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/password_manager/factories/profile_password_store_factory.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "components/password_manager/core/browser/password_store/password_store_consumer.h"
+#include "components/password_manager/core/browser/password_store/password_store_interface.h"
+
+namespace {
+using password_manager::StoredCredential;
+using password_manager::PasswordStoreInterface;
+
+orbit_password_text_t PasswordText(std::u16string_view text) {
+  return {reinterpret_cast<const uint16_t*>(text.data()), static_cast<uint32_t>(text.size())};
+}
+bool ReadPasswordText(orbit_password_text_t text, std::u16string& out) {
+  if (text.count > 1024 * 1024 || (text.count && !text.data)) return false;
+  if (!text.count) { out.clear(); return true; }
+  out.assign(reinterpret_cast<const char16_t*>(text.data), text.count);
+  return true;
+}
+bool ReadPasswordRecord(const orbit_password_record_t* row, StoredCredential& out) {
+  if (!row || row->struct_size < sizeof(*row) || !row->signon_realm ||
+      !row->origin_url || !row->action_url || row->scheme < 0 || row->scheme > 4 ||
+      (row->blocked_by_user != 0 && row->blocked_by_user != 1)) return false;
+  out.signon_realm = row->signon_realm;
+  out.url = GURL(row->origin_url); out.action = GURL(row->action_url);
+  if (out.signon_realm.empty() || !out.url.is_valid() ||
+      (!out.action.is_empty() && !out.action.is_valid())) return false;
+  std::u16string password;
+  if (!ReadPasswordText(row->username_element, out.username_element) ||
+      !ReadPasswordText(row->username_value, out.username_value) ||
+      !ReadPasswordText(row->password_element, out.password_element) ||
+      !ReadPasswordText(row->password_value, password)) return false;
+  out.password_value = password_manager::PasswordString(std::move(password));
+  out.date_created = base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(row->date_created));
+  out.date_last_used = base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(row->date_last_used));
+  out.date_password_modified = base::Time::FromDeltaSinceWindowsEpoch(base::Microseconds(row->date_password_modified));
+  out.blocked_by_user = row->blocked_by_user;
+  out.scheme = static_cast<password_manager::PasswordForm::Scheme>(row->scheme);
+  return true;
+}
+void SetPasswordFields(const StoredCredential& from, StoredCredential& to) {
+  to.signon_realm = from.signon_realm; to.url = from.url; to.action = from.action;
+  to.username_element = from.username_element; to.username_value = from.username_value;
+  to.password_element = from.password_element; to.password_value = from.password_value;
+  to.date_created = from.date_created; to.date_last_used = from.date_last_used;
+  to.date_password_modified = from.date_password_modified;
+  to.blocked_by_user = from.blocked_by_user; to.scheme = from.scheme;
+}
+bool SamePasswordFields(const StoredCredential& a, const StoredCredential& b) {
+  return password_manager::AreStoredCredentialUniqueKeysEqual(a, b) &&
+      a.action == b.action && a.password_value == b.password_value &&
+      a.date_created == b.date_created && a.date_last_used == b.date_last_used &&
+      a.date_password_modified == b.date_password_modified &&
+      a.blocked_by_user == b.blocked_by_user && a.scheme == b.scheme;
+}
+struct PasswordRequest {
+  int operation = 0;
+  bool verifying = false;
+  StoredCredential record, old_key;
+  orbit_password_result_t callback = nullptr;
+  void* context = nullptr;
+};
+class PasswordSession;
+auto& PasswordSessions() {
+  static base::NoDestructor<std::map<uint64_t, std::shared_ptr<PasswordSession>>> sessions;
+  return *sessions;
+}
+class PasswordSession final : public password_manager::PasswordStoreConsumer,
+                              public PasswordStoreInterface::Observer,
+                              public ProfileObserver,
+                              public std::enable_shared_from_this<PasswordSession> {
+ public:
+  PasswordSession(Profile* profile, scoped_refptr<PasswordStoreInterface> store)
+      : profile_(profile), store_(std::move(store)) {
+    profile_->AddObserver(this); store_->AddObserver(this);
+  }
+  ~PasswordSession() override { CHECK(!profile_); }
+  void Close() {
+    if (!profile_) return;
+    auto keep_alive = shared_from_this();
+    weak_.InvalidateWeakPtrs();
+    store_->RemoveObserver(this); profile_->RemoveObserver(this);
+    profile_ = nullptr; store_ = nullptr;
+    auto pending = std::move(requests_);
+    auto cb = changed_; auto ctx = changed_context_; changed_ = nullptr;
+    for (auto& request : pending) request->callback(request->context, -2, nullptr, 0);
+    if (cb) cb(ctx, 3);
+  }
+  void OnProfileWillBeDestroyed(Profile*) override {
+    auto keep_alive = shared_from_this();
+    std::erase_if(PasswordSessions(), [this](const auto& entry) { return entry.second.get() == this; });
+    Close();
+  }
+  void Enqueue(std::unique_ptr<PasswordRequest> request) {
+    requests_.push_back(std::move(request));
+    if (requests_.size() == 1) Read();
+  }
+  bool Observe(orbit_password_changed_t cb, void* context) {
+    if (!profile_) return false;
+    changed_ = cb; changed_context_ = context; return true;
+  }
+  bool live() const { return profile_ != nullptr; }
+  void OnLoginsChanged(PasswordStoreInterface*, const password_manager::PasswordStoreChangeList&) override { Emit(1); }
+  void OnLoginsRetained(PasswordStoreInterface*, const std::vector<StoredCredential>&) override { Emit(2); }
+  void OnGetPasswordStoreResultsOrErrorFrom(PasswordStoreInterface*,
+      base::expected<std::vector<StoredCredential>, password_manager::PasswordStoreBackendError> result) override {
+    auto keep_alive = shared_from_this();
+    if (requests_.empty()) return;
+    if (!result.has_value()) { Finish(-1); return; }
+    auto& request = *requests_.front();
+    if (!request.operation) {
+      std::vector<crypto::SecureU16String> passwords;
+      passwords.reserve(result->size());
+      std::vector<orbit_password_record_t> rows;
+      for (auto& f : *result) {
+        passwords.push_back(f.password_value.secure_value());
+        rows.push_back({sizeof(orbit_password_record_t), f.signon_realm.c_str(),
+            f.url.spec().c_str(), f.action.spec().c_str(), PasswordText(f.username_element),
+            PasswordText(f.username_value), PasswordText(f.password_element), PasswordText(passwords.back()),
+            f.date_created.ToDeltaSinceWindowsEpoch().InMicroseconds(),
+            f.date_last_used.ToDeltaSinceWindowsEpoch().InMicroseconds(),
+            f.date_password_modified.ToDeltaSinceWindowsEpoch().InMicroseconds(), f.blocked_by_user,
+            static_cast<int32_t>(f.scheme)});
+      }
+      Finish(1, rows.data(), rows.size()); return;
+    }
+    auto find = [&](const StoredCredential& key) {
+      return std::ranges::find_if(*result, [&](const auto& f) {
+        return password_manager::AreStoredCredentialUniqueKeysEqual(f, key);
+      });
+    };
+    auto target = find(request.record), old = find(request.old_key);
+    if (request.verifying) {
+      bool success = request.operation == 3 ? old == result->end() :
+          target != result->end() && SamePasswordFields(*target, request.record);
+      if (request.operation == 2 && !password_manager::AreStoredCredentialUniqueKeysEqual(request.old_key, request.record))
+        success = success && old == result->end();
+      Finish(success ? 1 : -1); return;
+    }
+    if ((request.operation == 1 && target != result->end()) ||
+        (request.operation != 1 && old == result->end()) ||
+        (request.operation == 2 && target != result->end() && target != old)) { Finish(-3); return; }
+    request.verifying = true;
+    auto done = base::BindOnce(&PasswordSession::Read, weak_.GetWeakPtr());
+    if (request.operation == 1) {
+      StoredCredential form; SetPasswordFields(request.record, form);
+      store_->AddLogin(std::move(form), std::move(done));
+    } else if (request.operation == 2) {
+      auto form = std::move(*old); SetPasswordFields(request.record, form);
+      if (password_manager::AreStoredCredentialUniqueKeysEqual(request.old_key, request.record))
+        store_->UpdateLogin(std::move(form), std::move(done));
+      else store_->UpdateLoginWithPrimaryKey(std::move(form), request.old_key, std::move(done));
+    } else {
+      // The local backend sequences reads after removals on its task runner.
+      store_->RemoveLogin(FROM_HERE, request.old_key); Read();
+    }
+  }
+ private:
+  void Emit(int event) { auto keep_alive = shared_from_this(); if (changed_) changed_(changed_context_, event); }
+  void Read() { if (store_) store_->GetAllLogins(weak_.GetWeakPtr()); }
+  void Finish(int status, const orbit_password_record_t* rows = nullptr, uint32_t count = 0) {
+    auto keep_alive = shared_from_this();
+    auto request = std::move(requests_.front()); requests_.pop_front();
+    // Start the next queued operation before calling external reentrant code.
+    if (!requests_.empty()) Read();
+    request->callback(request->context, status, rows, count);
+  }
+  raw_ptr<Profile> profile_;
+  scoped_refptr<PasswordStoreInterface> store_;
+  std::deque<std::unique_ptr<PasswordRequest>> requests_;
+  orbit_password_changed_t changed_ = nullptr;
+  void* changed_context_ = nullptr;
+  base::WeakPtrFactory<PasswordSession> weak_{this};
+};
+std::shared_ptr<PasswordSession> PasswordSessionFor(uint64_t handle) {
+  if (!OnValidUIThread()) return nullptr;
+  auto found = PasswordSessions().find(handle);
+  return found != PasswordSessions().end() && found->second->live() ? found->second : nullptr;
+}
+uint64_t PasswordStoreOpen(const char* path) {
+  Profile* profile = ExtensionProfile(path);
+  if (!profile || !profile->IsRegularProfile()) return 0;
+  auto store = ProfilePasswordStoreFactory::GetForProfile(profile, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!store) return 0;
+  static uint64_t next = 1;
+  uint64_t handle = next++;
+  PasswordSessions()[handle] = std::make_shared<PasswordSession>(profile, std::move(store));
+  return handle;
+}
+void PasswordStoreClose(uint64_t handle) {
+  if (!OnValidUIThread()) return;
+  auto found = PasswordSessions().find(handle);
+  if (found == PasswordSessions().end()) return;
+  auto session = found->second; PasswordSessions().erase(found); session->Close();
+}
+int32_t PasswordStoreList(uint64_t handle, orbit_password_result_t cb, void* context) {
+  auto session = PasswordSessionFor(handle); if (!session || !cb) return 0;
+  auto request = std::make_unique<PasswordRequest>(); request->callback = cb; request->context = context;
+  session->Enqueue(std::move(request)); return 1;
+}
+int32_t PasswordStoreWrite(uint64_t handle, int32_t operation, const orbit_password_record_t* record,
+    const orbit_password_record_t* old_key, orbit_password_result_t cb, void* context) {
+  auto session = PasswordSessionFor(handle);
+  if (!session || !cb || operation < 1 || operation > 3) return 0;
+  auto request = std::make_unique<PasswordRequest>();
+  if ((operation != 3 && !ReadPasswordRecord(record, request->record)) ||
+      (operation != 1 && !ReadPasswordRecord(old_key, request->old_key))) return 0;
+  request->operation = operation; request->callback = cb; request->context = context;
+  session->Enqueue(std::move(request)); return 1;
+}
+int32_t PasswordStoreObserve(uint64_t handle, orbit_password_changed_t cb, void* context) {
+  auto session = PasswordSessionFor(handle); return session && session->Observe(cb, context) ? 1 : 0;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_preconnect.inc b/libcef/browser/orbit/orbit_preconnect.inc
new file mode 100644
index 0000000000000000000000000000000000000000..ad4d1be7cdd4c0ea4388a22101bd2c85110bffe3
--- /dev/null
+++ b/libcef/browser/orbit/orbit_preconnect.inc
@@ -0,0 +1,86 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include <deque>
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/time/time.h"
+#include "chrome/browser/predictors/loading_predictor.h"
+#include "chrome/browser/predictors/loading_predictor_config.h"
+#include "chrome/browser/predictors/loading_predictor_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "content/public/browser/preconnect_manager.h"
+#include "content/public/browser/preconnect_request.h"
+#include "content/public/browser/storage_partition.h"
+#include "net/base/network_anonymization_key.h"
+#include "services/network/public/cpp/constants.h"
+#include "url/origin.h"
+
+namespace {
+struct OrbitPreconnectProfileState {
+  std::deque<base::TimeTicks> accepted;
+  std::map<std::string, base::TimeTicks> origin_time;
+};
+
+std::map<std::string, OrbitPreconnectProfileState>& PreconnectStates() {
+  static base::NoDestructor<std::map<std::string, OrbitPreconnectProfileState>> states;
+  return *states;
+}
+
+int32_t Preconnect(const char* profile_id, const char* url, int32_t sockets) {
+  if (!OnValidUIThread() || !profile_id || !*profile_id || !url ||
+      sockets < 1 || sockets > 6 || !g_browser_process ||
+      !g_browser_process->profile_manager())
+    return 0;
+  auto* profile = g_browser_process->profile_manager()->GetProfileByPath(
+      base::FilePath(profile_id));
+  if (!profile || profile->IsOffTheRecord() ||
+      !predictors::IsLoadingPredictorEnabled(profile) ||
+      !predictors::IsPreconnectAllowed(profile))
+    return 0;
+
+  const GURL target(url);
+  if (!target.is_valid() || !target.SchemeIsHTTPOrHTTPS() ||
+      !target.has_host())
+    return 0;
+  const url::Origin origin = url::Origin::Create(target);
+  if (origin.opaque())
+    return 0;
+  const std::string origin_key = origin.Serialize();
+  auto& state = PreconnectStates()[profile->GetPath().AsUTF8Unsafe()];
+  const base::TimeTicks now = base::TimeTicks::Now();
+  while (!state.accepted.empty() &&
+         now - state.accepted.front() >= base::Minutes(1))
+    state.accepted.pop_front();
+  for (auto it = state.origin_time.begin(); it != state.origin_time.end();) {
+    if (now - it->second >= base::Seconds(10))
+      it = state.origin_time.erase(it);
+    else
+      ++it;
+  }
+  if (state.accepted.size() >= 6 || state.origin_time.contains(origin_key))
+    return 0;
+
+  auto* predictor = predictors::LoadingPredictorFactory::GetForProfile(profile);
+  if (!predictor || predictor->WasShutdown())
+    return 0;
+  auto* manager = predictor->preconnect_manager();
+  auto* partition = profile->GetDefaultStoragePartition();
+  if (!manager || !partition)
+    return 0;
+
+  const auto key = net::NetworkAnonymizationKey::CreateSameSite(
+      net::SchemefulSite(origin));
+  if (key.IsEmpty() && net::NetworkAnonymizationKey::IsPartitioningEnabled())
+    return 0;
+  std::vector<content::PreconnectRequest> requests;
+  requests.emplace_back(origin, sockets, key,
+                        network::GetNoOpNetworkRestrictionsId());
+  manager->Start(origin.GetURL(), std::move(requests),
+                 predictors::kLoadingPredictorPreconnectTrafficAnnotation);
+  state.accepted.push_back(now);
+  state.origin_time[origin_key] = now;
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_purge.inc b/libcef/browser/orbit/orbit_purge.inc
new file mode 100644
index 0000000000000000000000000000000000000000..faac2984c1eac11d608d6403ec5cca6475061e51
--- /dev/null
+++ b/libcef/browser/orbit/orbit_purge.inc
@@ -0,0 +1,139 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include <memory>
+#include <optional>
+
+#include "base/allocator/partition_allocator/src/partition_alloc/memory_reclaimer.h"
+#include "base/functional/bind.h"
+#include "base/process/process.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/time/time.h"
+#include "services/resource_coordinator/public/cpp/memory_instrumentation/global_memory_dump.h"
+#include "services/resource_coordinator/public/cpp/memory_instrumentation/memory_instrumentation.h"
+
+namespace {
+using memory_instrumentation::GlobalMemoryDump;
+using memory_instrumentation::mojom::RequestOutcome;
+
+std::optional<uint64_t> CommittedAllocatorKB(const GlobalMemoryDump* dump) {
+  if (!dump)
+    return std::nullopt;
+  for (const auto& process : dump->process_dumps()) {
+    if (process.pid() != base::GetCurrentProcId())
+      continue;
+    const auto bytes = process.GetMetric("partition_alloc/partitions",
+                                        "virtual_committed_size");
+    return bytes ? std::optional<uint64_t>(*bytes / 1024) : std::nullopt;
+  }
+  return std::nullopt;
+}
+
+class OrbitPurgeRequest : public std::enable_shared_from_this<OrbitPurgeRequest> {
+ public:
+  OrbitPurgeRequest(uint32_t flags, orbit_purge_callback_t callback, void* context)
+      : flags_(flags), callback_(callback), context_(context) {}
+
+  void Start() {
+    auto* instrumentation = memory_instrumentation::MemoryInstrumentation::GetInstance();
+    if (!instrumentation || !instrumentation->GetCoordinator()) {
+      Reclaim();
+      Finish();
+      return;
+    }
+    instrumentation->RequestGlobalDumpForPid(
+        base::GetCurrentProcId(), {"partition_alloc/partitions"},
+        base::BindOnce(&OrbitPurgeRequest::OnBeforeDump, shared_from_this()));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&OrbitPurgeRequest::OnBeforeTimeout, shared_from_this()),
+        base::Seconds(15));
+  }
+
+ private:
+  void OnBeforeTimeout() {
+    if (done_ || reclaimed_)
+      return;
+    Reclaim();
+    Finish();
+  }
+
+  void OnBeforeDump(RequestOutcome outcome,
+                    std::unique_ptr<GlobalMemoryDump> dump) {
+    if (done_ || reclaimed_)
+      return;
+    if (outcome == RequestOutcome::kSuccess)
+      before_ = CommittedAllocatorKB(dump.get());
+    Reclaim();
+    auto* instrumentation = memory_instrumentation::MemoryInstrumentation::GetInstance();
+    if (!instrumentation || !instrumentation->GetCoordinator()) {
+      Finish();
+      return;
+    }
+    instrumentation->RequestGlobalDumpForPid(
+        base::GetCurrentProcId(), {"partition_alloc/partitions"},
+        base::BindOnce(&OrbitPurgeRequest::OnAfterDump, shared_from_this()));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&OrbitPurgeRequest::Finish, shared_from_this()),
+        base::Seconds(15));
+  }
+
+  void Reclaim() {
+    if (reclaimed_)
+      return;
+    reclaimed_ = true;
+    const base::TimeTicks started = base::TimeTicks::Now();
+    auto* reclaimer = partition_alloc::MemoryReclaimer::Instance();
+    if (!reclaimer) {
+      reclaim_succeeded_ = false;
+      return;
+    }
+    if (flags_ == ORBIT_PURGE_FAST)
+      reclaimer->ReclaimFast();
+    else
+      reclaimer->ReclaimAll();
+    elapsed_us_ = static_cast<uint64_t>(
+        (base::TimeTicks::Now() - started).InMicroseconds());
+    reclaim_succeeded_ = true;
+  }
+
+  void OnAfterDump(RequestOutcome outcome,
+                   std::unique_ptr<GlobalMemoryDump> dump) {
+    if (done_)
+      return;
+    if (outcome == RequestOutcome::kSuccess)
+      after_ = CommittedAllocatorKB(dump.get());
+    Finish();
+  }
+
+  void Finish() {
+    if (done_ || !callback_)
+      return;
+    done_ = true;
+    auto callback = callback_;
+    callback_ = nullptr;
+    const uint64_t before = before_.value_or(ORBIT_PURGE_UNKNOWN_KB);
+    const uint64_t after = after_.value_or(ORBIT_PURGE_UNKNOWN_KB);
+    const int32_t status = !reclaim_succeeded_ ? -1
+                           : (before_ && after_ ? 1 : 2);
+    callback(context_, status, before, after, elapsed_us_);
+  }
+
+  const uint32_t flags_;
+  orbit_purge_callback_t callback_;
+  void* const context_;
+  bool reclaimed_ = false;
+  bool done_ = false;
+  bool reclaim_succeeded_ = true;
+  uint64_t elapsed_us_ = 0;
+  std::optional<uint64_t> before_;
+  std::optional<uint64_t> after_;
+};
+
+int32_t PurgeMemory(uint32_t flags, orbit_purge_callback_t callback, void* context) {
+  if (!OnValidUIThread() || !callback ||
+      (flags != ORBIT_PURGE_FAST && flags != ORBIT_PURGE_AGGRESSIVE))
+    return 0;
+  auto request = std::make_shared<OrbitPurgeRequest>(flags, callback, context);
+  request->Start();
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_runtime_state.inc b/libcef/browser/orbit/orbit_runtime_state.inc
new file mode 100644
index 0000000000000000000000000000000000000000..d0a7583931481458bff3ed71eca10ca303992565
--- /dev/null
+++ b/libcef/browser/orbit/orbit_runtime_state.inc
@@ -0,0 +1,60 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace {
+void ReadBrowserState(content::WebContents* contents, orbit_browser_state_t* state) {
+  state->audible = contents->IsCurrentlyAudible() ? 1 : 0;
+  state->muted = contents->IsAudioMuted() ? 1 : 0;
+  const auto theme = contents->GetThemeColor();
+  const auto background = contents->GetBackgroundColor();
+  state->colors = (theme ? 1u : 0u) | (background ? 2u : 0u);
+  state->theme_color = theme.value_or(0);
+  state->background_color = background.value_or(0);
+}
+int32_t BrowserState(int32_t id, orbit_browser_state_t* state) {
+  if (!OnValidUIThread() || !state || state->struct_size < sizeof(*state)) return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  if (!host || !host->GetWebContents()) return 0;
+  ReadBrowserState(host->GetWebContents(), state);
+  return 1;
+}
+class OrbitRuntimeObservation final : public content::WebContentsObserver,
+                                     public std::enable_shared_from_this<OrbitRuntimeObservation> {
+ public:
+  OrbitRuntimeObservation(content::WebContents* contents,
+      void (*changed)(void*, const orbit_browser_state_t*), void* context)
+      : content::WebContentsObserver(contents), changed_(changed), context_(context) {}
+  void OnAudioStateChanged(bool) override { Notify(); }
+  void DidUpdateAudioMutingState(bool) override { Notify(); }
+  void DidChangeThemeColor() override { Notify(); }
+  void OnBackgroundColorChanged() override { Notify(); }
+  void WebContentsDestroyed() override { changed_ = nullptr; Observe(nullptr); }
+ private:
+  void Notify() {
+    auto alive = shared_from_this();
+    if (!changed_ || !web_contents()) return;
+    orbit_browser_state_t state{};
+    state.struct_size = sizeof(state);
+    ReadBrowserState(web_contents(), &state);
+    changed_(context_, &state);
+  }
+  void (*changed_)(void*, const orbit_browser_state_t*);
+  void* context_;
+};
+using RuntimeObservationMap = std::map<int32_t, std::shared_ptr<OrbitRuntimeObservation>>;
+RuntimeObservationMap& RuntimeObservations() {
+  static base::NoDestructor<RuntimeObservationMap> observations;
+  return *observations;
+}
+int32_t BrowserStateObserve(int32_t id,
+    void (*changed)(void*, const orbit_browser_state_t*), void* context) {
+  if (!OnValidUIThread()) return 0;
+  RuntimeObservations().erase(id);
+  if (!changed) return 1;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  if (!host || !host->GetWebContents()) return 0;
+  RuntimeObservations()[id] = std::make_shared<OrbitRuntimeObservation>(host->GetWebContents(), changed, context);
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_security.inc b/libcef/browser/orbit/orbit_security.inc
new file mode 100644
index 0000000000000000000000000000000000000000..42888c7f6a8dea86908a26f39709a4da5ab8c3cd
--- /dev/null
+++ b/libcef/browser/orbit/orbit_security.inc
@@ -0,0 +1,147 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cef/libcef/browser/permission_prompt.h"
+#include "chrome/browser/ssl/chrome_security_state_util.h"
+#include "components/security_interstitials/content/security_interstitial_tab_helper.h"
+#include "components/url_formatter/elide_url.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+
+namespace {
+int32_t CopySideText(const std::string& text, char* out, uint32_t capacity) {
+  if (text.size() > INT32_MAX) return -1;
+  if (out && capacity > text.size()) memcpy(out, text.c_str(), text.size() + 1);
+  return static_cast<int32_t>(text.size());
+}
+content::WebContents* SideContents(int32_t id) {
+  if (!OnValidUIThread()) return nullptr;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  return host ? host->GetWebContents() : nullptr;
+}
+int32_t PermissionAcceptOnce(int32_t browser_id, uint64_t prompt_id) {
+  if (!OnValidUIThread()) return 0;
+  return permission_prompt::AcceptOnce(browser_id, prompt_id);
+}
+std::string SecurityJSON(content::WebContents* contents) {
+  auto native = chrome_security_state::GetVisibleSecurityState(contents);
+  auto* interstitial = security_interstitials::SecurityInterstitialTabHelper::FromWebContents(contents);
+  base::DictValue value;
+  value.Set("level", static_cast<int>(chrome_security_state::GetSecurityLevel(contents)));
+  value.Set("certificateStatus", static_cast<double>(native->cert_status));
+  value.Set("certificateError", net::IsCertStatusError(native->cert_status));
+  value.Set("displayedMixedContent", native->displayed_mixed_content);
+  value.Set("ranMixedContent", native->ran_mixed_content);
+  value.Set("displayedCertificateErrorContent", native->displayed_content_with_cert_errors);
+  value.Set("ranCertificateErrorContent", native->ran_content_with_cert_errors);
+  value.Set("interstitial", interstitial && interstitial->IsDisplayingInterstitial());
+  return base::WriteJson(value).value_or("{}");
+}
+int32_t SecurityState(int32_t id, char* out, uint32_t capacity) {
+  auto* contents = SideContents(id);
+  return contents ? CopySideText(SecurityJSON(contents), out, capacity) : -1;
+}
+int32_t SecurityDisplay(const char* text, int32_t scheme, char* out, uint32_t capacity) {
+  if (!OnValidUIThread() || !text || scheme < 0 || scheme > 2) return -1;
+  GURL url(text);
+  if (!url.is_valid()) return -1;
+  return CopySideText(base::UTF16ToUTF8(url_formatter::FormatUrlForSecurityDisplay(
+      url, static_cast<url_formatter::SchemeDisplay>(scheme))), out, capacity);
+}
+int32_t CommittedURL(int32_t id, char* out, uint32_t capacity) {
+  auto* contents = SideContents(id);
+  return contents ? CopySideText(contents->GetLastCommittedURL().spec(), out, capacity) : -1;
+}
+class SecurityObservation;
+using SecurityMap = std::map<int32_t, std::shared_ptr<SecurityObservation>>;
+SecurityMap& SecurityObservers() {
+  static base::NoDestructor<SecurityMap> map;
+  return *map;
+}
+class SecurityObservation final : public content::WebContentsObserver,
+                                  public std::enable_shared_from_this<SecurityObservation> {
+ public:
+  SecurityObservation(int32_t id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), id_(id) {}
+  orbit_json_changed_t security = nullptr;
+  void* security_context = nullptr;
+  orbit_fullscreen_changed_t fullscreen = nullptr;
+  void* fullscreen_context = nullptr;
+  void DidChangeVisibleSecurityState() override {
+    auto alive = shared_from_this();
+    if (security && web_contents()) {
+      const auto json = SecurityJSON(web_contents());
+      security(security_context, json.c_str(), static_cast<uint32_t>(json.size()));
+    }
+  }
+  void DidAcquireFullscreen(content::RenderFrameHost* frame) override {
+    auto alive = shared_from_this();
+    const auto origin = frame->GetLastCommittedOrigin().Serialize();
+    if (origin == origin_) return;
+    origin_ = origin;
+    if (fullscreen) fullscreen(fullscreen_context, 1, origin.c_str());
+  }
+  void DidToggleFullscreenModeForTab(bool entered, bool) override {
+    auto alive = shared_from_this();
+    if (!entered && !origin_.empty()) {
+      const auto origin = std::exchange(origin_, std::string());
+      if (fullscreen) fullscreen(fullscreen_context, 0, origin.c_str());
+    }
+  }
+  void WebContentsDestroyed() override {
+    auto alive = shared_from_this();
+    Observe(nullptr);
+    SecurityObservers().erase(id_);
+  }
+ private:
+  int32_t id_;
+  std::string origin_;
+};
+std::shared_ptr<SecurityObservation> SecurityObserver(int32_t id) {
+  auto* contents = SideContents(id);
+  if (!contents) return nullptr;
+  auto& item = SecurityObservers()[id];
+  if (!item) item = std::make_shared<SecurityObservation>(id, contents);
+  return item;
+}
+int32_t SecurityObserve(int32_t id, orbit_json_changed_t cb, void* context) {
+  if (!OnValidUIThread()) return 0;
+  auto item = cb ? SecurityObserver(id) : (SecurityObservers().contains(id) ? SecurityObservers()[id] : nullptr);
+  if (!item) return cb ? 0 : 1;
+  item->security = cb; item->security_context = context;
+  if (!item->security && !item->fullscreen) SecurityObservers().erase(id);
+  return 1;
+}
+int32_t FullscreenObserve(int32_t id, orbit_fullscreen_changed_t cb, void* context) {
+  if (!OnValidUIThread()) return 0;
+  auto item = cb ? SecurityObserver(id) : (SecurityObservers().contains(id) ? SecurityObservers()[id] : nullptr);
+  if (!item) return cb ? 0 : 1;
+  item->fullscreen = cb; item->fullscreen_context = context;
+  if (!item->security && !item->fullscreen) SecurityObservers().erase(id);
+  return 1;
+}
+int32_t NavigationEntries(int32_t id, char* out, uint32_t capacity) {
+  auto* contents = SideContents(id);
+  if (!contents) return -1;
+  auto& controller = contents->GetController();
+  base::DictValue value;
+  value.Set("currentIndex", controller.GetLastCommittedEntryIndex());
+  base::ListValue entries;
+  for (int i = 0; i < controller.GetEntryCount(); ++i) {
+    auto* entry = controller.GetEntryAtIndex(i);
+    base::DictValue row;
+    row.Set("index", i);
+    row.Set("url", entry->GetURL().spec());
+    row.Set("title", base::UTF16ToUTF8(entry->GetTitle()));
+    entries.Append(std::move(row));
+  }
+  value.Set("entries", std::move(entries));
+  return CopySideText(base::WriteJson(value).value_or("{}"), out, capacity);
+}
+int32_t NavigationGoIndex(int32_t id, int32_t index) {
+  auto* contents = SideContents(id);
+  if (!contents || index < 0 || index >= contents->GetController().GetEntryCount()) return 0;
+  contents->GetController().GoToIndex(index);
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_suspension.inc b/libcef/browser/orbit/orbit_suspension.inc
new file mode 100644
index 0000000000000000000000000000000000000000..db993b89c14e574c25b3570cd02d2b173be90d83
--- /dev/null
+++ b/libcef/browser/orbit/orbit_suspension.inc
@@ -0,0 +1,35 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "base/feature_list.h"
+#include "base/functional/callback_helpers.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/common/content_features.h"
+
+namespace {
+int32_t DiscardTab(int32_t id) {
+  if (!OnValidUIThread() ||
+      !base::FeatureList::IsEnabled(features::kWebContentsDiscard)) return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  auto* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents || contents->IsLoading() || contents->WasDiscarded() ||
+      !contents->GetController().GetLastCommittedEntry()) return 0;
+  // The embedder has synchronously checked background ownership and document safety.
+  // Hide before discarding so activation is the only trigger for lazy restoration.
+  contents->WasHidden();
+  auto observation = EnsureLifecycle(id);
+  observation->embedder_discard = true;
+  contents->Discard(base::DoNothing());
+  observation->embedder_discard = false;
+  return contents->WasDiscarded() ? 1 : 0;
+}
+int32_t RestoreDiscardedTab(int32_t id) {
+  if (!OnValidUIThread()) return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  auto* contents = host ? host->GetWebContents() : nullptr;
+  if (!contents) return 0;
+  // Do not Reload or LoadURL: history loading restores PageState and uses Chromium's
+  // cache-only POST recovery. A cache miss is never silently resubmitted.
+  contents->GetController().LoadIfNecessary();
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_unowned_tabs.h b/libcef/browser/orbit/orbit_unowned_tabs.h
new file mode 100644
index 0000000000000000000000000000000000000000..cc48f92c6e81cfd1defab30489117b4c80e7af53
--- /dev/null
+++ b/libcef/browser/orbit/orbit_unowned_tabs.h
@@ -0,0 +1,65 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#ifndef CEF_LIBCEF_BROWSER_ORBIT_ORBIT_UNOWNED_TABS_H_
+#define CEF_LIBCEF_BROWSER_ORBIT_ORBIT_UNOWNED_TABS_H_
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "cef/include/cef_client.h"
+
+class Browser;
+struct CefBrowserCreateParams;
+
+namespace content {
+class WebContents;
+}
+
+namespace orbit {
+
+// EXT-OUTCOME-R1. A tab that Chrome creates by itself in an Orbit logical
+// Browser: an extension's tabs.create, an options page opened in a tab,
+// onboarding after an install. Without an embedder answer it would get a CEF
+// host with no client and no parent view (ChromeBrowserDelegate::SetAsDelegate).
+struct UnownedTab {
+  uint64_t window_token = 0;
+  std::string profile_path;
+  std::string url;
+  int index = -1;
+  // 1 Chrome activates the tab, 0 it opens in the background, -1 unknown
+  // (never guessed: the embedder treats unknown as background).
+  int active = -1;
+};
+
+// The embedder's answer: a client and the parent view of one of its own
+// surfaces, or a null client. Installed by orbit_cef_set_unowned_tab_handler
+// (orbit_unowned_tabs_entry.cc, framework side of the C API). UI thread only.
+using UnownedTabAdopter =
+    base::RepeatingCallback<CefRefPtr<CefClient>(const UnownedTab& tab,
+                                                 CefWindowHandle* parent)>;
+void SetUnownedTabAdopter(UnownedTabAdopter adopter);
+// Changes with every SetUnownedTabAdopter call: an offer revalidates it after
+// the embedder returns, so a cleared or replaced handler never publishes.
+uint64_t UnownedTabAdopterGeneration();
+
+// Offers |contents|, a tab Chrome is creating or inserting in the logical
+// Browser |browser|, to the embedder. URL, index and activation come from the
+// creating Navigate() request when its hook is running (orbit_navigate_intent.h,
+// published before the tab is loaded or inserted), otherwise from the tab
+// strip once the tab is inserted; activation stays unknown otherwise. After the
+// embedder returns, the Browser, contents, logical Browser registration,
+// window generation and handler generation are verified again. On acceptance
+// sets the client, parent view, window generation and tab index of |params| and
+// returns true; |params| is unchanged otherwise, and a client the embedder
+// returned is released (the embedder aborts its pending surface on release).
+bool OfferUnownedTab(Browser* browser,
+                     content::WebContents* contents,
+                     CefBrowserCreateParams* params);
+
+}  // namespace orbit
+
+#endif  // CEF_LIBCEF_BROWSER_ORBIT_ORBIT_UNOWNED_TABS_H_
diff --git a/libcef/browser/orbit/orbit_unowned_tabs.mm b/libcef/browser/orbit/orbit_unowned_tabs.mm
new file mode 100644
index 0000000000000000000000000000000000000000..33c66a9ec7aec332d8f192fba30c5bf6d8b877da
--- /dev/null
+++ b/libcef/browser/orbit/orbit_unowned_tabs.mm
@@ -0,0 +1,116 @@
+// Copyright 2026 Orbit. Portions copyright The Chromium Embedded Framework
+// Authors. Use of this source code is governed by a BSD-style license that can
+// be found in the LICENSE file.
+
+#include "cef/libcef/browser/orbit/orbit_unowned_tabs.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "cef/libcef/browser/orbit/orbit_hosted.h"
+#include "cef/libcef/browser/browser_host_base.h"
+#include "cef/libcef/browser/thread_util.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser.h"
+#include "chrome/browser/ui/navigator/orbit_navigate_intent.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/web_contents.h"
+
+namespace orbit {
+
+namespace {
+
+UnownedTabAdopter& Adopter() {
+  static base::NoDestructor<UnownedTabAdopter> adopter;
+  return *adopter;
+}
+
+uint64_t& AdopterGeneration() {
+  static uint64_t generation = 0;
+  return generation;
+}
+
+}  // namespace
+
+void SetUnownedTabAdopter(UnownedTabAdopter adopter) {
+  CEF_REQUIRE_UIT();
+  ++AdopterGeneration();
+  Adopter() = std::move(adopter);
+}
+
+uint64_t UnownedTabAdopterGeneration() {
+  return AdopterGeneration();
+}
+
+bool OfferUnownedTab(Browser* browser,
+                     content::WebContents* contents,
+                     CefBrowserCreateParams* params) {
+  CEF_REQUIRE_UIT();
+  if (!Adopter() || !browser || !contents || !params ||
+      !params->orbit_window_token || !IsLogicalBrowser(browser)) {
+    return false;
+  }
+  const uint64_t window_token = params->orbit_window_token;
+  const auto generation = GetWindowGeneration(window_token);
+  if (!generation) {
+    return false;
+  }
+  Profile* const profile = browser->GetProfile();
+  UnownedTab tab;
+  tab.window_token = window_token;
+  tab.profile_path = profile->GetPath().value();
+  const NavigateIntent* intent = CurrentNavigateIntent();
+  TabStripModel* model = browser->tab_strip_model();
+  const int inserted = model ? model->GetIndexOfWebContents(contents) : -1;
+  if (intent &&
+      intent->browser.get() ==
+          static_cast<const BrowserWindowInterface*>(browser) &&
+      intent->contents.get() == contents) {
+    // Pre-insertion creation (Navigate: tabs.create, options pages): the
+    // request is the authority.
+    tab.url = intent->url.spec();
+    tab.index = intent->tabstrip_index;
+    tab.active = intent->active;
+  } else if (inserted >= 0) {
+    // Already inserted: the tab strip is the authority.
+    tab.url = contents->GetVisibleURL().spec();
+    tab.index = inserted;
+    tab.active = model->active_index() == inserted ? 1 : 0;
+  } else {
+    tab.url = contents->GetVisibleURL().spec();
+  }
+
+  // The embedder may close the window, remove the profile, clear the handler
+  // or destroy this Browser while it answers; nothing below dereferences
+  // |browser| or |contents| before they are verified alive again.
+  const base::WeakPtr<BrowserWindowInterface> weak_browser =
+      browser->GetWeakPtr();
+  const base::WeakPtr<content::WebContents> weak_contents =
+      contents->GetWeakPtr();
+  const uint64_t adopter_generation = AdopterGeneration();
+  UnownedTabAdopter adopter = Adopter();  // The call may clear the original.
+  CefWindowHandle parent = kNullWindowHandle;
+  CefRefPtr<CefClient> client = adopter.Run(tab, &parent);
+  if (!client || !parent) {
+    return false;
+  }
+  if (!weak_browser || !weak_contents ||
+      weak_browser.get() != static_cast<BrowserWindowInterface*>(browser) ||
+      AdopterGeneration() != adopter_generation ||
+      !IsLogicalBrowser(browser) || browser->GetProfile() != profile ||
+      GetLogicalBrowser(window_token, profile) != browser ||
+      GetWindowGeneration(window_token) != generation) {
+    return false;  // |client| is released: the embedder aborts its surface.
+  }
+  params->client = client;
+  if (!params->window_info) {
+    params->window_info = std::make_unique<CefWindowInfo>();
+  }
+  params->window_info->parent_view = parent;
+  params->orbit_window_generation = *generation;
+  params->orbit_tab_index = tab.index;
+  return true;
+}
+
+}  // namespace orbit
