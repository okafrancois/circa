+#if BUILDFLAG(IS_MAC)
+bool ChromeBrowserHostImpl::OrbitMoveToWindow(uint64_t window_token,
+                                             int index) {
+  CEF_REQUIRE_UIT();
+  auto* hosted =
+      CefBrowserPlatformDelegateChromeHosted::FromBrowserId(GetIdentifier());
+  content::WebContents* contents = GetWebContents();
+  if (!hosted || !contents || !browser_ || is_destroying_browser_ ||
+      !orbit::IsLogicalBrowser(browser_) || browser_->IsDeleteScheduled()) {
+    return false;
+  }
+  const auto generation = orbit::GetWindowGeneration(window_token);
+  if (!generation) {
+    return false;
+  }
+  TabStripModel* source = browser_->tab_strip_model();
+  const int from = source->GetIndexOfWebContents(contents);
+  if (from == TabStripModel::kNoTab || source->closing_all()) {
+    return false;
+  }
+
+  CefBrowserCreateParams params;
+  params.request_context = request_context();
+  params.orbit_window_token = window_token;
+  params.orbit_window_generation = *generation;
+  Browser* target = GetOrCreateOrbitBrowser(params);
+  if (!target || target->IsDeleteScheduled()) {
+    return false;
+  }
+
+  if (target == browser_) {
+    // Same logical Browser: mirror Orbit's order (tabs.onMoved).
+    const int last = source->count() - 1;
+    const int to = index < 0 || index > last ? last : index;
+    if (to != from) {
+      source->MoveWebContentsAt(from, to, /*select_after_move=*/false);
+    }
+    return true;
+  }
+
+  TabStripModel* destination = target->tab_strip_model();
+  // The source Browser may close once its last tab left (TabStripEmpty): it is
+  // not used after the detach. Browser::OnTabDetached and OnTabInsertedAt call
+  // SetAsDelegate, which re-parents this host (SetBrowser).
+  std::unique_ptr<tabs::TabModel> tab = source->DetachTabAtForInsertion(from);
+  if (!tab) {
+    if (destination->empty()) {
+      target->GetWindow()->Close();
+    }
+    return false;
+  }
+  hosted->SetWindow(window_token, *generation);
+  const int count = destination->count();
+  const int to = index < 0 || index > count ? count : index;
+  destination->InsertDetachedTabAt(to, std::move(tab), AddTabTypes::ADD_NONE);
+  return true;
+}
