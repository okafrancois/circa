+    explicit Dialog(NSWindow* parent,
+                    ui::mojom::ModalType type = ui::mojom::ModalType::kChild) {
+      delegate = std::make_unique<views::DialogDelegate>();
+      delegate->SetModalType(type);
+      delegate->SetOwnershipOfNewWidget(
+          views::Widget::InitParams::CLIENT_OWNS_WIDGET);
+      auto contents = std::make_unique<views::StaticSizedView>();
+      contents->SetPreferredSize(gfx::Size(300, 180));
+      delegate->SetContentsView(std::move(contents));
+      widget.reset(views::DialogDelegate::CreateDialogWidget(
+          delegate.get(), gfx::NativeWindow(),
+          gfx::NativeView(parent.contentView)));
+    }
+    ~Dialog() {
+      if (!widget->IsClosed()) {
+        widget->CloseNow();
+      }
+    }
+    std::unique_ptr<views::DialogDelegate> delegate;
+    std::unique_ptr<views::Widget> widget;
+  };
+};
