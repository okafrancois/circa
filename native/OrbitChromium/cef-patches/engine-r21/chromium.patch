+// Browser-modal dialogs (extension install/uninstall/post-install prompts and
+// other kWindow constrained windows) on a registered ordinary AppKit parent.
+// Without registration Chromium falls back to an unparented, immovable
+// top-level window. These tests show and activate their synthetic windows.
+TEST_F(ConstrainedWindowAppKitParentTest,
+       BrowserModalDialogIsSheetOfRegisteredParent) {
+  NSWindow* parent = MakeParent();
+  remote_cocoa::ScopedAppKitModalParent registration{gfx::NativeWindow(parent)};
+  [NSApp activateIgnoringOtherApps:YES];
+  [parent makeKeyAndOrderFront:nil];
+  {
+    Dialog dialog(parent, ui::mojom::ModalType::kWindow);
+    auto* host = views::NativeWidgetMacNSWindowHost::GetFromNativeWindow(
+        dialog.widget->GetNativeWindow());
+    ASSERT_NE(nullptr, host);
+    EXPECT_EQ(nullptr, host->parent());
+    EXPECT_TRUE(host->HasAppKitModalParent());
+    NSWindow* sheet = dialog.widget->GetNativeWindow().GetNativeNSWindow();
+    EXPECT_FALSE(sheet.movable);
+    dialog.widget->Show();
+    base::RunLoop().RunUntilIdle();
+    EXPECT_EQ(sheet, parent.attachedSheet);
+    EXPECT_EQ(parent, sheet.sheetParent);
+    EXPECT_EQ(nil, sheet.parentWindow);
+    EXPECT_EQ(1u, parent.sheets.count);
+    // Sheets move with their parent.
+    const NSPoint before = sheet.frame.origin;
+    [parent setFrameOrigin:NSMakePoint(parent.frame.origin.x + 60,
+                                       parent.frame.origin.y - 40)];
+    EXPECT_EQ(before.x + 60, sheet.frame.origin.x);
+  }
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(nil, parent.attachedSheet);
+  [parent close];
+}
