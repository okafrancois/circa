+      : MediaProgressView(std::forward<Args>(args)...),
+        automatic_(std::move(automatic)),
+        progress_(std::move(progress)) {}
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (!automatic_.Run()) {
+      MediaProgressView::OnPaint(canvas);
+      return;
+    }
+    cc::PaintFlags f;
+    f.setAntiAlias(true);
+    f.setColor(SkColorSetA(SK_ColorWHITE, 90));
+    canvas->DrawRoundRect(gfx::RectF(8, 10, width() - 16, 4), 2, f);
+    f.setColor(SK_ColorWHITE);
+    canvas->DrawRoundRect(
+        gfx::RectF(8, 10, (width() - 16) * std::clamp(progress_.Run(), 0.0, 1.0), 4),
+        2, f);
+  }
+
+ private:
+  base::RepeatingCallback<bool()> automatic_;
+  base::RepeatingCallback<double()> progress_;
+};
+class AutomaticPlaybackButton : public PlaybackImageButton {
