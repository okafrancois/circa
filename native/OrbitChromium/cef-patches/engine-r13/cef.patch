diff --git a/libcef/browser/orbit/orbit_media.inc b/libcef/browser/orbit/orbit_media.inc
new file mode 100644
index 0000000..7c2cf3d
--- /dev/null
+++ b/libcef/browser/orbit/orbit_media.inc
@@ -0,0 +1,115 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include <cmath>
+#include "content/public/browser/media_session.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "services/media_session/public/cpp/media_image.h"
+#include "services/media_session/public/cpp/media_metadata.h"
+#include "services/media_session/public/cpp/media_position.h"
+
+namespace {
+class MediaObservation;
+using MediaMap = std::map<int32_t, std::shared_ptr<MediaObservation>>;
+MediaMap& MediaObservers() { static base::NoDestructor<MediaMap> map; return *map; }
+class MediaObservation final : public content::WebContentsObserver,
+    public media_session::mojom::MediaSessionObserver,
+    public std::enable_shared_from_this<MediaObservation> {
+ public:
+  MediaObservation(int32_t id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), id_(id) {
+    content::MediaSession::Get(contents)->AddObserver(receiver_.BindNewPipeAndPassRemote());
+  }
+  orbit_json_changed_t callback = nullptr;
+  void* context = nullptr;
+  std::string Snapshot() {
+    auto* session = content::MediaSession::GetIfExists(web_contents());
+    if (!session) return "{}";
+    auto info = session->GetMediaSessionInfoSync();
+    const auto& metadata = session->GetMediaSessionMetadata();
+    base::DictValue value;
+    value.Set("title", base::UTF16ToUTF8(metadata.title));
+    value.Set("artist", base::UTF16ToUTF8(metadata.artist));
+    value.Set("album", base::UTF16ToUTF8(metadata.album));
+    value.Set("playbackState", static_cast<int>(info->playback_state));
+    value.Set("sessionState", static_cast<int>(info->state));
+    value.Set("artwork", artwork_.Clone());
+    base::ListValue actions;
+    for (auto action : session->GetMediaSessionActionsSync()) actions.Append(static_cast<int>(action));
+    value.Set("actions", std::move(actions));
+    if (const auto position = session->GetMediaSessionPosition()) {
+      const double current = position->GetPosition().InSecondsF();
+      const double duration = position->duration().InSecondsF();
+      const double rate = position->playback_rate();
+      if (std::isfinite(current)) value.Set("position", current);
+      if (std::isfinite(duration)) value.Set("duration", duration);
+      if (std::isfinite(rate)) value.Set("playbackRate", rate);
+    }
+    return base::WriteJson(value).value_or("{}");
+  }
+  void MediaSessionInfoChanged(media_session::mojom::MediaSessionInfoPtr) override { Notify(); }
+  void MediaSessionMetadataChanged(const std::optional<media_session::MediaMetadata>&) override { Notify(); }
+  void MediaSessionActionsChanged(const std::vector<media_session::mojom::MediaSessionAction>&) override { Notify(); }
+  void MediaSessionImagesChanged(const base::flat_map<media_session::mojom::MediaSessionImageType,
+      std::vector<media_session::MediaImage>>& images) override {
+    artwork_.clear();
+    auto it = images.find(media_session::mojom::MediaSessionImageType::kArtwork);
+    if (it != images.end()) for (const auto& image : it->second) artwork_.Append(image.src.spec());
+    Notify();
+  }
+  void MediaSessionPositionChanged(const std::optional<media_session::MediaPosition>&) override { Notify(); }
+  void WebContentsDestroyed() override {
+    auto alive = shared_from_this();
+    callback = nullptr;
+    receiver_.reset();
+    Observe(nullptr);
+    MediaObservers().erase(id_);
+  }
+ private:
+  void Notify() {
+    auto alive = shared_from_this();
+    if (callback && web_contents()) {
+      auto text = Snapshot();
+      callback(context, text.c_str(), static_cast<uint32_t>(text.size()));
+    }
+  }
+  int32_t id_;
+  base::ListValue artwork_;
+  mojo::Receiver<media_session::mojom::MediaSessionObserver> receiver_{this};
+};
+std::shared_ptr<MediaObservation> MediaObserver(int32_t id) {
+  auto* contents = SideContents(id);
+  if (!contents) return nullptr;
+  auto& item = MediaObservers()[id];
+  if (!item) item = std::make_shared<MediaObservation>(id, contents);
+  return item;
+}
+int32_t MediaSnapshot(int32_t id, char* out, uint32_t capacity) {
+  auto item = MediaObserver(id);
+  return item ? CopySideText(item->Snapshot(), out, capacity) : -1;
+}
+int32_t MediaObserve(int32_t id, orbit_json_changed_t cb, void* context) {
+  if (!OnValidUIThread()) return 0;
+  if (!cb) { MediaObservers().erase(id); return 1; }
+  auto item = MediaObserver(id);
+  if (!item) return 0;
+  item->callback = cb; item->context = context;
+  return 1;
+}
+int32_t MediaAction(int32_t id, int32_t action, double seconds) {
+  auto* contents = SideContents(id);
+  auto* session = contents ? content::MediaSession::GetIfExists(contents) : nullptr;
+  if (!session) return 0;
+  using Action = media_session::mojom::MediaSessionAction;
+  const auto actions = session->GetMediaSessionActionsSync();
+  const Action types[] = {Action::kPlay, Action::kPause, Action::kSeekTo, Action::kNextTrack, Action::kPreviousTrack};
+  if (action < 0 || action > 4 || !std::ranges::contains(actions, types[action])) return 0;
+  if (action == 2) {
+    const auto position = session->GetMediaSessionPosition();
+    if (!position || !std::isfinite(seconds) || seconds < 0 || seconds > position->duration().InSecondsF()) return 0;
+    session->SeekTo(base::Seconds(seconds));
+  } else if (action == 3) session->NextTrack();
+  else if (action == 4) session->PreviousTrack();
+  else if (action == 0) session->Resume(content::MediaSession::SuspendType::kUI);
+  else session->Suspend(content::MediaSession::SuspendType::kUI);
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_security.inc b/libcef/browser/orbit/orbit_security.inc
new file mode 100644
index 0000000..42888c7
--- /dev/null
+++ b/libcef/browser/orbit/orbit_security.inc
@@ -0,0 +1,147 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "base/json/json_writer.h"
+#include "base/strings/utf_string_conversions.h"
+#include "cef/libcef/browser/permission_prompt.h"
+#include "chrome/browser/ssl/chrome_security_state_util.h"
+#include "components/security_interstitials/content/security_interstitial_tab_helper.h"
+#include "components/url_formatter/elide_url.h"
+#include "content/public/browser/navigation_entry.h"
+#include "content/public/browser/render_frame_host.h"
+
+namespace {
+int32_t CopySideText(const std::string& text, char* out, uint32_t capacity) {
+  if (text.size() > INT32_MAX) return -1;
+  if (out && capacity > text.size()) memcpy(out, text.c_str(), text.size() + 1);
+  return static_cast<int32_t>(text.size());
+}
+content::WebContents* SideContents(int32_t id) {
+  if (!OnValidUIThread()) return nullptr;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  return host ? host->GetWebContents() : nullptr;
+}
+int32_t PermissionAcceptOnce(int32_t browser_id, uint64_t prompt_id) {
+  if (!OnValidUIThread()) return 0;
+  return permission_prompt::AcceptOnce(browser_id, prompt_id);
+}
+std::string SecurityJSON(content::WebContents* contents) {
+  auto native = chrome_security_state::GetVisibleSecurityState(contents);
+  auto* interstitial = security_interstitials::SecurityInterstitialTabHelper::FromWebContents(contents);
+  base::DictValue value;
+  value.Set("level", static_cast<int>(chrome_security_state::GetSecurityLevel(contents)));
+  value.Set("certificateStatus", static_cast<double>(native->cert_status));
+  value.Set("certificateError", net::IsCertStatusError(native->cert_status));
+  value.Set("displayedMixedContent", native->displayed_mixed_content);
+  value.Set("ranMixedContent", native->ran_mixed_content);
+  value.Set("displayedCertificateErrorContent", native->displayed_content_with_cert_errors);
+  value.Set("ranCertificateErrorContent", native->ran_content_with_cert_errors);
+  value.Set("interstitial", interstitial && interstitial->IsDisplayingInterstitial());
+  return base::WriteJson(value).value_or("{}");
+}
+int32_t SecurityState(int32_t id, char* out, uint32_t capacity) {
+  auto* contents = SideContents(id);
+  return contents ? CopySideText(SecurityJSON(contents), out, capacity) : -1;
+}
+int32_t SecurityDisplay(const char* text, int32_t scheme, char* out, uint32_t capacity) {
+  if (!OnValidUIThread() || !text || scheme < 0 || scheme > 2) return -1;
+  GURL url(text);
+  if (!url.is_valid()) return -1;
+  return CopySideText(base::UTF16ToUTF8(url_formatter::FormatUrlForSecurityDisplay(
+      url, static_cast<url_formatter::SchemeDisplay>(scheme))), out, capacity);
+}
+int32_t CommittedURL(int32_t id, char* out, uint32_t capacity) {
+  auto* contents = SideContents(id);
+  return contents ? CopySideText(contents->GetLastCommittedURL().spec(), out, capacity) : -1;
+}
+class SecurityObservation;
+using SecurityMap = std::map<int32_t, std::shared_ptr<SecurityObservation>>;
+SecurityMap& SecurityObservers() {
+  static base::NoDestructor<SecurityMap> map;
+  return *map;
+}
+class SecurityObservation final : public content::WebContentsObserver,
+                                  public std::enable_shared_from_this<SecurityObservation> {
+ public:
+  SecurityObservation(int32_t id, content::WebContents* contents)
+      : content::WebContentsObserver(contents), id_(id) {}
+  orbit_json_changed_t security = nullptr;
+  void* security_context = nullptr;
+  orbit_fullscreen_changed_t fullscreen = nullptr;
+  void* fullscreen_context = nullptr;
+  void DidChangeVisibleSecurityState() override {
+    auto alive = shared_from_this();
+    if (security && web_contents()) {
+      const auto json = SecurityJSON(web_contents());
+      security(security_context, json.c_str(), static_cast<uint32_t>(json.size()));
+    }
+  }
+  void DidAcquireFullscreen(content::RenderFrameHost* frame) override {
+    auto alive = shared_from_this();
+    const auto origin = frame->GetLastCommittedOrigin().Serialize();
+    if (origin == origin_) return;
+    origin_ = origin;
+    if (fullscreen) fullscreen(fullscreen_context, 1, origin.c_str());
+  }
+  void DidToggleFullscreenModeForTab(bool entered, bool) override {
+    auto alive = shared_from_this();
+    if (!entered && !origin_.empty()) {
+      const auto origin = std::exchange(origin_, std::string());
+      if (fullscreen) fullscreen(fullscreen_context, 0, origin.c_str());
+    }
+  }
+  void WebContentsDestroyed() override {
+    auto alive = shared_from_this();
+    Observe(nullptr);
+    SecurityObservers().erase(id_);
+  }
+ private:
+  int32_t id_;
+  std::string origin_;
+};
+std::shared_ptr<SecurityObservation> SecurityObserver(int32_t id) {
+  auto* contents = SideContents(id);
+  if (!contents) return nullptr;
+  auto& item = SecurityObservers()[id];
+  if (!item) item = std::make_shared<SecurityObservation>(id, contents);
+  return item;
+}
+int32_t SecurityObserve(int32_t id, orbit_json_changed_t cb, void* context) {
+  if (!OnValidUIThread()) return 0;
+  auto item = cb ? SecurityObserver(id) : (SecurityObservers().contains(id) ? SecurityObservers()[id] : nullptr);
+  if (!item) return cb ? 0 : 1;
+  item->security = cb; item->security_context = context;
+  if (!item->security && !item->fullscreen) SecurityObservers().erase(id);
+  return 1;
+}
+int32_t FullscreenObserve(int32_t id, orbit_fullscreen_changed_t cb, void* context) {
+  if (!OnValidUIThread()) return 0;
+  auto item = cb ? SecurityObserver(id) : (SecurityObservers().contains(id) ? SecurityObservers()[id] : nullptr);
+  if (!item) return cb ? 0 : 1;
+  item->fullscreen = cb; item->fullscreen_context = context;
+  if (!item->security && !item->fullscreen) SecurityObservers().erase(id);
+  return 1;
+}
+int32_t NavigationEntries(int32_t id, char* out, uint32_t capacity) {
+  auto* contents = SideContents(id);
+  if (!contents) return -1;
+  auto& controller = contents->GetController();
+  base::DictValue value;
+  value.Set("currentIndex", controller.GetLastCommittedEntryIndex());
+  base::ListValue entries;
+  for (int i = 0; i < controller.GetEntryCount(); ++i) {
+    auto* entry = controller.GetEntryAtIndex(i);
+    base::DictValue row;
+    row.Set("index", i);
+    row.Set("url", entry->GetURL().spec());
+    row.Set("title", base::UTF16ToUTF8(entry->GetTitle()));
+    entries.Append(std::move(row));
+  }
+  value.Set("entries", std::move(entries));
+  return CopySideText(base::WriteJson(value).value_or("{}"), out, capacity);
+}
+int32_t NavigationGoIndex(int32_t id, int32_t index) {
+  auto* contents = SideContents(id);
+  if (!contents || index < 0 || index >= contents->GetController().GetEntryCount()) return 0;
+  contents->GetController().GoToIndex(index);
+  return 1;
+}
+}  // namespace
