+std::vector<std::unique_ptr<content::CommitDeferringCondition>>
+ChromeContentBrowserClientCef::CreateCommitDeferringConditionsForNavigation(
+    content::NavigationHandle* handle,
+    content::CommitDeferringCondition::NavigationType type) {
+  auto conditions = ChromeContentBrowserClient::CreateCommitDeferringConditionsForNavigation(handle, type);
+  if (auto policy = throttle::CreateCachedNavigationCondition(*handle)) {
+    conditions.insert(conditions.begin(), std::move(policy));
+  }
+  return conditions;
+}
