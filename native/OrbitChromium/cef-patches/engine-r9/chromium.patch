+namespace {
+struct PendingWindowCreationMetadata {
+  RenderFrameHost* opener;
+  WindowCreationMetadata metadata;
+};
+const PendingWindowCreationMetadata* g_pending_window_creation = nullptr;
+}  // namespace
+
+const WindowCreationMetadata* GetWindowCreationMetadata(RenderFrameHost* opener) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return g_pending_window_creation && g_pending_window_creation->opener == opener
+             ? &g_pending_window_creation->metadata : nullptr;
+}
