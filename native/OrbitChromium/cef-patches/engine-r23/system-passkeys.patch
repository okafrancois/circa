diff --git a/chrome/browser/webauthn/chrome_authenticator_request_delegate.cc b/chrome/browser/webauthn/chrome_authenticator_request_delegate.cc
index 6c8b888..85fbd6f 100644
--- a/chrome/browser/webauthn/chrome_authenticator_request_delegate.cc
+++ b/chrome/browser/webauthn/chrome_authenticator_request_delegate.cc
@@ -1423,6 +1423,17 @@ void ChromeAuthenticatorRequestDelegate::ConfigureNSWindow(
     if (window) {
       discovery_factory->set_nswindow(window);
     }
+    return;
+  }
+
+  // Orbit: a WebContents hosted directly in the embedder's AppKit view
+  // hierarchy has no Views widget. Use the NSWindow that contains its view
+  // ([native_view window]) so the system passkey provider can present its
+  // sheet. Nothing is set while the view is not in a window.
+  const gfx::NativeWindow hosted_window =
+      web_contents->GetTopLevelNativeWindow();
+  if (hosted_window) {
+    discovery_factory->set_nswindow(hosted_window);
   }
 }
