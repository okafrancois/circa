 bool OrbitBrowserWindow::IsFullscreen() const {
-  NSWindow* window = OrbitNSWindow(window_token_);
-  return window && ([window styleMask] & NSWindowStyleMaskFullScreen);
+  // The AppKit shell owns native window fullscreen independently. Its animated
+  // style-mask transition must not keep Chrome's element fullscreen alive after
+  // ExitFullscreen(), or make an already-fullscreen shell skip EnterFullscreen.
+  return content_fullscreen_;
+}
+
+void OrbitBrowserWindow::EnterFullscreen(
+    const url::Origin& origin,
+    ExclusiveAccessBubbleType bubble_type,
+    FullscreenTabParams fullscreen_tab_params) {
+  if (content_fullscreen_) {
+    return;
+  }
+  content_fullscreen_ = true;
+  NotifyFullscreenStateChanged();
+}
+
+void OrbitBrowserWindow::ExitFullscreen() {
+  if (!content_fullscreen_) {
+    return;
+  }
+  content_fullscreen_ = false;
+  NotifyFullscreenStateChanged();
+}
+
+// As the platform window reports a completed transition: asynchronously, after
+// FullscreenController finished its own state change (browser_view.cc).
+void OrbitBrowserWindow::NotifyFullscreenStateChanged() {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<OrbitBrowserWindow> self) {
+                       if (!self || !self->browser_) {
+                         return;
+                       }
+                       if (auto* manager =
+                               ExclusiveAccessManager::From(self->browser_)) {
+                         manager->fullscreen_controller()
+                             ->WindowFullscreenStateChanged();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
 }
 
