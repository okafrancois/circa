+bool ExtensionPopup::CheckNativeInvocation() {
+  if (!orbit_native_) return true;
+  if (orbit_cancelled_) return false;
+  if (native_invocation_ && native_invocation_->IsValid()) return true;
+  CancelNativeInvocation();
+  return false;
+}
+
+void ExtensionPopup::CancelNativeInvocation() {
+  orbit_cancelled_ = true;
+  native_invocation_weak_ptr_factory_.InvalidateWeakPtrs();
+  deferred_close_weak_ptr_factory_.InvalidateWeakPtrs();
+  Observe(nullptr);
+  extension_registry_observation_.Reset();
+  security_dialog_tracker_observation_.Reset();
+  anchor_widget_observation_.Reset();
+  if (observed_tab_strip_) {
+    observed_tab_strip_->RemoveObserver(this);
+    observed_tab_strip_ = nullptr;
+  }
+  browser_ = nullptr; // Revoke before calling external/native cancellation code.
+  auto invocation = std::move(native_invocation_);
+  if (invocation) { invocation->SetCancellation({}); invocation->Cancel(); }
+  if (orbit_constructing_) return;
+  auto weak = deferred_close_weak_ptr_factory_.GetWeakPtr();
+  if (extension_view_) RemoveChildViewT(extension_view_.ExtractAsDangling());
+  if (!weak) return;
+  host_.reset();
+  if (!weak) return;
+  withheld_from_view_.reset();
+  if (!orbit_destroying_ && GetWidget()) CloseDeferredIfNecessary();
+}
+
+void ExtensionPopup::OnTabStripModelDestroyed(TabStripModel*) {
+  observed_tab_strip_ = nullptr;
+  browser_ = nullptr;
+  if (orbit_native_) CancelNativeInvocation();
+  else if (GetWidget()) CloseDeferredIfNecessary();
+}
