+void ExtensionPopup::ShowPopupWithNativeParent(
+    BrowserWindowInterface* browser,
+    std::unique_ptr<extensions::ExtensionViewHost> host,
+    gfx::NativeView native_parent, const gfx::Rect& screen_anchor,
+    std::shared_ptr<NativeInvocation> invocation) {
+  if (!native_parent || !invocation || !invocation->IsValid()) return;
+  auto* popup = new ExtensionPopup(
+      browser, std::move(host), views::BubbleAnchor(),
+      views::BubbleBorder::TOP_RIGHT, PopupShowAction::kShow,
+      ShowPopupCallback(), native_parent, screen_anchor, std::move(invocation));
+  if (popup->orbit_cancelled_) { delete popup; return; }
+  auto weak = popup->deferred_close_weak_ptr_factory_.GetWeakPtr();
+  views::BubbleDialogDelegateView::CreateBubble(popup);
+  if (!weak) return;
+  if (popup->CheckNativeInvocation() && popup->host_->has_loaded_once()) popup->ShowBubble();
+}
