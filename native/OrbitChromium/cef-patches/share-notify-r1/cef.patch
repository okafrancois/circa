+    content::RenderFrameHost* frame) {
+  auto* contents = content::WebContents::FromRenderFrameHost(frame);
+  if (auto browser = CefBrowserHostBase::GetBrowserForContents(contents)) {
+    // CefFocusHandler receives FOCUS_SOURCE_SYSTEM. Orbit selects this live surface
+    // in its owning native window and Space; the hidden Chrome window stays hidden.
+    browser->SetFocus(true);
+  }
