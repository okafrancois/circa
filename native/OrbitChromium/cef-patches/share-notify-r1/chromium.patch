 void MacNotificationServiceUN::DisplayNotification(
+    mojom::NotificationPtr notification) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  // Ask macOS only after a site with a web grant actually sends a notification.
+  // Do not ask at provider creation: Chrome creates its provider during startup.
+  RequestPermission(base::BindOnce(
+      [](base::WeakPtr<MacNotificationServiceUN> service,
+         mojom::NotificationPtr notification,
+         mojom::RequestPermissionResult result) {
+        using Result = mojom::RequestPermissionResult;
+        if (service && (result == Result::kPermissionGranted ||
+                        result == Result::kPermissionPreviouslyGranted)) {
+          service->DisplayAuthorizedNotification(std::move(notification));
+        }
+      }, weak_factory_.GetWeakPtr(), std::move(notification)));
+}
