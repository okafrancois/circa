diff --git a/libcef/browser/orbit/orbit_activation.inc b/libcef/browser/orbit/orbit_activation.inc
new file mode 100644
index 0000000..3651766
--- /dev/null
+++ b/libcef/browser/orbit/orbit_activation.inc
@@ -0,0 +1,118 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "content/public/browser/navigation_handle.h"
+namespace {
+class ActivationRequest;
+using ActivationMap = std::map<int32_t, std::shared_ptr<ActivationRequest>>;
+ActivationMap& Activations() {
+  static base::NoDestructor<ActivationMap> map;
+  return *map;
+}
+class ActivationRequest final
+    : public content::WebContentsObserver,
+      public std::enable_shared_from_this<ActivationRequest> {
+ public:
+  ActivationRequest(content::WebContents* wc,
+                    int32_t id,
+                    uint64_t activation,
+                    uint64_t document,
+                    orbit_activation_callback_t cb,
+                    void* ctx)
+      : content::WebContentsObserver(wc),
+        id_(id),
+        activation_(activation),
+        document_(document),
+        cb_(cb),
+        ctx_(ctx) {}
+  void Finish(int status) {
+    if (!cb_)
+      return;
+    if (web_contents() && web_contents()->IsBeingDestroyed())
+      status = 4;
+    if (status == 1 && !PageIsVisible(web_contents()))
+      status = 3;
+    auto alive = shared_from_this();
+    auto cb = cb_;
+    cb_ = nullptr;
+    Observe(nullptr);
+    Activations().erase(id_);
+    cb(ctx_, id_, activation_, document_, status,
+       status == 1 ? base::TimeTicks::Now().since_origin().InMicroseconds()
+                   : 0);
+  }
+  void DidStartNavigation(content::NavigationHandle* n) override {
+    if (n->IsInPrimaryMainFrame())
+      Finish(2);
+  }
+  void PrimaryPageChanged(content::Page&) override { Finish(2); }
+  void OnVisibilityChanged(content::Visibility v) override {
+    if (v != content::Visibility::VISIBLE)
+      Finish(3);
+  }
+  void WebContentsDestroyed() override { Finish(4); }
+
+ private:
+  int32_t id_;
+  uint64_t activation_, document_;
+  orbit_activation_callback_t cb_;
+  void* ctx_;
+};
+int32_t ActivationFrame(int32_t id,
+                        uint64_t activation,
+                        orbit_activation_callback_t cb,
+                        void* ctx) {
+  if (!OnValidUIThread())
+    return 0;
+  // The embedder announces close before detaching its native view. This
+  // cancels pending work before visibility callbacks can win the close race.
+  if (!cb && !activation) {
+    if (auto it = Activations().find(id); it != Activations().end())
+      it->second->Finish(4);
+    return 1;
+  }
+  if (!cb || !activation)
+    return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  auto* wc = host ? host->GetWebContents() : nullptr;
+  auto lifecycle = EnsureLifecycle(id);
+  if (!wc || !lifecycle)
+    return 0;
+  if (auto it = Activations().find(id); it != Activations().end())
+    it->second->Finish(2);
+  if (host->GetWebContents() != wc)
+    return 0;
+  // Reentrant completion may have created a successor: never overwrite its
+  // ownership.
+  if (Activations().contains(id))
+    return 0;
+  auto request = std::make_shared<ActivationRequest>(
+      wc, id, activation, lifecycle->document_id, cb, ctx);
+  Activations()[id] = request;
+  auto runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+  runner->PostTask(FROM_HERE,
+                   base::BindOnce(
+                       [](std::weak_ptr<ActivationRequest> w, bool hidden) {
+                         if (hidden) {
+                           if (auto r = w.lock())
+                             r->Finish(3);
+                         }
+                       },
+                       std::weak_ptr(request), !PageIsVisible(wc)));
+  runner->PostDelayedTask(FROM_HERE,
+                          base::BindOnce(
+                              [](std::weak_ptr<ActivationRequest> w) {
+                                if (auto r = w.lock())
+                                  r->Finish(5);
+                              },
+                              std::weak_ptr(request)),
+                          base::Milliseconds(150));
+  if (PageIsVisible(wc) && wc->GetPrimaryMainFrame()) {
+    wc->GetPrimaryMainFrame()->InsertVisualStateCallback(base::BindOnce(
+        [](std::weak_ptr<ActivationRequest> w, bool ok) {
+          if (auto r = w.lock())
+            r->Finish(ok ? 1 : 2);
+        },
+        std::weak_ptr(request)));
+  }
+  return 1;
+}
+}  // namespace
diff --git a/libcef/browser/orbit/orbit_capture.inc b/libcef/browser/orbit/orbit_capture.inc
new file mode 100644
index 0000000..2f90a96
--- /dev/null
+++ b/libcef/browser/orbit/orbit_capture.inc
@@ -0,0 +1,96 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+namespace {
+class CaptureRequest final
+    : public content::WebContentsObserver,
+      public std::enable_shared_from_this<CaptureRequest> {
+ public:
+  CaptureRequest(content::WebContents* wc,
+                 orbit_capture_callback_t cb,
+                 void* ctx)
+      : content::WebContentsObserver(wc), cb_(cb), ctx_(ctx) {}
+  void Finish(int status, SkBitmap bitmap = {}) {
+    if (!cb_)
+      return;
+    auto cb = cb_;
+    cb_ = nullptr;
+    Observe(nullptr);
+    cb(ctx_, status, bitmap.width(), bitmap.height(), bitmap.rowBytes(),
+       static_cast<const uint8_t*>(bitmap.getPixels()), status == 1 ? 1 : 0);
+  }
+  void WebContentsDestroyed() override { Finish(-2); }
+  void PrimaryPageChanged(content::Page&) override { Finish(-4); }
+
+ private:
+  orbit_capture_callback_t cb_;
+  void* ctx_;
+};
+int32_t CaptureView(int32_t id,
+                    orbit_capture_rect_t rect,
+                    int32_t width,
+                    int32_t height,
+                    int32_t timeout,
+                    orbit_capture_callback_t cb,
+                    void* ctx) {
+  if (!OnValidUIThread() || !cb || width <= 0 || height <= 0 || width > 4096 ||
+      height > 4096 || timeout < 1 || timeout > 5000 || rect.x < 0 ||
+      rect.y < 0 || rect.width < 0 || rect.height < 0 ||
+      ((rect.width == 0) != (rect.height == 0)))
+    return 0;
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(id);
+  auto* wc = host ? host->GetWebContents() : nullptr;
+  if (!wc)
+    return 0;
+  auto request = std::make_shared<CaptureRequest>(wc, cb, ctx);
+  auto runner = base::SingleThreadTaskRunner::GetCurrentDefault();
+  runner->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce([](std::shared_ptr<CaptureRequest> r) { r->Finish(-3); },
+                     request),
+      base::Milliseconds(timeout));
+  auto* view = wc->GetRenderWidgetHostView();
+  if (!view || !PageIsVisible(wc) || !view->IsSurfaceAvailableForCopy()) {
+    runner->PostTask(
+        FROM_HERE,
+        base::BindOnce([](std::shared_ptr<CaptureRequest> r) { r->Finish(-1); },
+                       request));
+    return 1;
+  }
+  view->CopyFromSurface(
+      gfx::Rect(rect.x, rect.y, rect.width, rect.height),
+      gfx::Size(width, height), base::Milliseconds(timeout),
+      base::BindOnce(
+          [](scoped_refptr<base::SingleThreadTaskRunner> ui,
+             std::shared_ptr<CaptureRequest> request, int width, int height,
+             const content::CopyFromSurfaceResult& result) {
+            SkBitmap pixels;
+            int status = -1;
+            if (result && !result->bitmap.drawsNothing()) {
+              const auto info = SkImageInfo::Make(
+                  width, height, kBGRA_8888_SkColorType, kPremul_SkAlphaType,
+                  SkColorSpace::MakeSRGB());
+              if (pixels.tryAllocPixels(info) &&
+                  result->bitmap.width() == width &&
+                  result->bitmap.height() == height &&
+                  result->bitmap.readPixels(info, pixels.getPixels(),
+                                            pixels.rowBytes(), 0, 0))
+                status = 1;
+            } else if (!result && result.error() ==
+                                      content::CopyFromSurfaceError::kTimeout)
+              status = -3;
+            if (status != 1)
+              pixels.reset();
+            ui->PostTask(FROM_HERE,
+                         base::BindOnce(
+                             [](std::shared_ptr<CaptureRequest> r, int status,
+                                SkBitmap pixels) {
+                               r->Finish(status, std::move(pixels));
+                             },
+                             std::move(request), status, std::move(pixels)));
+          },
+          runner, request, width, height));
+  return 1;
+}
+}  // namespace
