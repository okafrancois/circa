diff --git a/libcef/browser/orbit/orbit_lifecycle.inc b/libcef/browser/orbit/orbit_lifecycle.inc
new file mode 100644
index 0000000..85e42f7
--- /dev/null
+++ b/libcef/browser/orbit/orbit_lifecycle.inc
@@ -0,0 +1,256 @@
+// Copyright 2026 Orbit. BSD-style license; see LICENSE.
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/media/webrtc/media_capture_devices_dispatcher.h"
+#include "chrome/browser/media/webrtc/media_stream_capture_indicator.h"
+#include "chrome/browser/performance_manager/policies/discard_eligibility_policy.h"
+#include "chrome/browser/performance_manager/public/user_tuning/user_tuning_utils.h"
+#include "components/performance_manager/public/graph/graph.h"
+#include "components/performance_manager/public/graph/page_node.h"
+#include "components/performance_manager/public/performance_manager.h"
+#include "content/public/browser/media_player_id.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/render_process_host.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+namespace {
+namespace pm = performance_manager;
+class LifecycleObservation;
+using LifecycleMap = std::map<int32_t, std::shared_ptr<LifecycleObservation>>;
+LifecycleMap& Lifecycles() {
+  static base::NoDestructor<LifecycleMap> map;
+  return *map;
+}
+bool PageIsVisible(content::WebContents* wc) {
+  if (!wc || wc->GetVisibility() != content::Visibility::VISIBLE)
+    return false;
+  auto* view = wc->GetRenderWidgetHostView();
+  NSView* native = wc->GetNativeView().GetNativeNSView();
+  return view && view->IsShowing() && native && native.window.isVisible &&
+         !native.isHiddenOrHasHiddenAncestor;
+}
+uint64_t NextDocumentID() {
+  static uint64_t next = 0;
+  return ++next;
+}
+class LifecycleObservation final
+    : public content::WebContentsObserver,
+      public pm::PageNodeObserver,
+      public MediaStreamCaptureIndicator::Observer,
+      public std::enable_shared_from_this<LifecycleObservation> {
+ public:
+  LifecycleObservation(int32_t id, content::WebContents* wc)
+      : content::WebContentsObserver(wc),
+        document_id(NextDocumentID()),
+        id_(id) {
+    if (pm::PerformanceManager::IsAvailable()) {
+      graph_ = pm::PerformanceManager::GetGraph();
+      graph_->AddPageNodeObserver(this);
+    }
+    indicator_ = MediaCaptureDevicesDispatcher::GetInstance()
+                     ->GetMediaStreamCaptureIndicator();
+    indicator_->AddObserver(this);
+  }
+  ~LifecycleObservation() override { Detach(); }
+  void Detach() {
+    if (graph_) {
+      graph_->RemovePageNodeObserver(this);
+      graph_ = nullptr;
+    }
+    if (indicator_) {
+      indicator_->RemoveObserver(this);
+      indicator_.reset();
+    }
+  }
+  bool Read(orbit_page_lifecycle_t* s) {
+    auto* wc = web_contents();
+    if (!wc || !pm::PerformanceManager::IsAvailable())
+      return false;
+    auto page = pm::PerformanceManager::GetPrimaryPageNodeForWebContents(wc);
+    if (!page)
+      return false;
+    *s = {};
+    s->struct_size = sizeof(*s);
+    s->playing_video = wc->GetCurrentlyPlayingVideoCount() > 0;
+    s->playing_media = !players_.empty() || s->playing_video;
+    s->audio_context_running = !audio_contexts_.empty();
+    s->audible = page->IsAudible();
+    s->pip = page->HasPictureInPicture();
+    s->had_form_interaction = page->HadFormInteraction();
+    s->had_user_edits = page->HadUserEdits();
+    s->web_lock = page->IsHoldingWebLock();
+    s->idb_lock = page->IsHoldingBlockingIndexedDBLock();
+    s->webrtc = page->UsesWebRTC();
+    s->document_id = document_id;
+    s->lifecycle = wc->WasDiscarded()
+                       ? 2
+                       : (page->GetLifecycleState() ==
+                                  pm::PageNode::LifecycleState::kFrozen
+                              ? 1
+                              : 0);
+    if (indicator_) {
+      s->capturing = (indicator_->IsCapturingVideo(wc) ? 1u : 0u) |
+                     (indicator_->IsCapturingAudio(wc) ? 2u : 0u) |
+                     (indicator_->IsBeingMirrored(wc) ? 4u : 0u) |
+                     (indicator_->IsCapturingTab(wc) ? 8u : 0u) |
+                     (indicator_->IsCapturingWindow(wc) ? 16u : 0u) |
+                     (indicator_->IsCapturingDisplay(wc) ? 32u : 0u);
+    }
+    auto* policy = pm::policies::DiscardEligibilityPolicy::GetFromGraph(
+        pm::PerformanceManager::GetGraph());
+    if (!policy)
+      return false;
+    std::vector<pm::policies::CannotDiscardReason> reasons;
+    policy->CanDiscard(page.get(), ::mojom::LifecycleUnitDiscardReason::URGENT,
+                       false, &reasons);
+    for (auto reason : reasons)
+      s->cannot_discard_mask |= uint64_t{1} << static_cast<unsigned>(reason);
+    s->footprint_kb =
+        pm::user_tuning::GetDiscardedMemoryEstimateForPage(page.get()).InKiB();
+    auto* frame = wc->GetPrimaryMainFrame();
+    if (frame)
+      s->renderer_pid = frame->GetProcess()->GetProcess().Pid();
+    return true;
+  }
+  void Notify() {
+    if (pending_ || !changed)
+      return;
+    pending_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](std::weak_ptr<LifecycleObservation> weak) {
+                         if (auto self = weak.lock()) {
+                           self->pending_ = false;
+                           self->Emit(0, 0);
+                         }
+                       },
+                       weak_from_this()));
+  }
+  void Emit(int event, int initiator) {
+    auto alive = shared_from_this();
+    orbit_page_lifecycle_t state{};
+    if (changed && Read(&state))
+      changed(context, event, initiator, &state);
+  }
+  void MediaStartedPlaying(const MediaPlayerInfo&,
+                           const content::MediaPlayerId& id) override {
+    players_.insert(id);
+    Notify();
+  }
+  void MediaStoppedPlaying(const MediaPlayerInfo&,
+                           const content::MediaPlayerId& id,
+                           MediaStoppedReason) override {
+    players_.erase(id);
+    Notify();
+  }
+  void AudioContextPlaybackStarted(const AudioContextId& id) override {
+    audio_contexts_.insert(id);
+    Notify();
+  }
+  void AudioContextPlaybackStopped(const AudioContextId& id) override {
+    audio_contexts_.erase(id);
+    Notify();
+  }
+  void OnAudioStateChanged(bool) override { Notify(); }
+  void PrimaryPageChanged(content::Page&) override {
+    document_id = NextDocumentID();
+    Notify();
+  }
+  void AboutToBeDiscarded(content::WebContents* replacement) override {
+    discard_initiator_ = embedder_discard ? 1 : 2;
+    Emit(1, discard_initiator_);
+    // Current Chromium discards in place; retain observation on older
+    // replacement paths too.
+    if (replacement && replacement != web_contents())
+      Observe(replacement);
+  }
+  void WasDiscarded() override {
+    players_.clear();
+    audio_contexts_.clear();
+    Emit(2, discard_initiator_ ? discard_initiator_ : 2);
+    Notify();
+  }
+  void WebContentsDestroyed() override {
+    auto alive = shared_from_this();
+    auto cb = changed;
+    changed = nullptr;
+    Detach();
+    Observe(nullptr);
+    Lifecycles().erase(id_);
+    if (cb)
+      cb(context, 3, 0, nullptr);
+  }
+#define ORBIT_PAGE_CHANGE(method)                    \
+  void method(const pm::PageNode* p) override {      \
+    if (p->GetWebContents().get() == web_contents()) \
+      Notify();                                      \
+  }
+  ORBIT_PAGE_CHANGE(OnIsVisibleChanged)
+  ORBIT_PAGE_CHANGE(OnIsAudibleChanged)
+  ORBIT_PAGE_CHANGE(OnHasPictureInPictureChanged)
+  ORBIT_PAGE_CHANGE(OnPageLifecycleStateChanged)
+  ORBIT_PAGE_CHANGE(OnPageIsHoldingWebLockChanged)
+  ORBIT_PAGE_CHANGE(OnPageIsHoldingBlockingIndexedDBLockChanged)
+  ORBIT_PAGE_CHANGE(OnPageUsesWebRTCChanged)
+  ORBIT_PAGE_CHANGE(OnHadFormInteractionChanged)
+  ORBIT_PAGE_CHANGE(OnHadUserEditsChanged)
+  ORBIT_PAGE_CHANGE(OnMainFrameDocumentChanged)
+#undef ORBIT_PAGE_CHANGE
+#define ORBIT_CAPTURE_CHANGE(method)                     \
+  void method(content::WebContents* wc, bool) override { \
+    if (wc == web_contents())                            \
+      Notify();                                          \
+  }
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingVideoChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingAudioChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsBeingMirroredChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingTabChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingWindowChanged)
+  ORBIT_CAPTURE_CHANGE(OnIsCapturingDisplayChanged)
+#undef ORBIT_CAPTURE_CHANGE
+  orbit_lifecycle_callback_t changed = nullptr;
+  void* context = nullptr;
+  bool embedder_discard = false;
+  uint64_t document_id;
+
+ private:
+  int32_t id_;
