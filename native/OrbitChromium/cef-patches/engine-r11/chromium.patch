+template <typename Base>
+class AutomaticCornerButton : public Base {
+ public:
+  AutomaticCornerButton(views::Button::PressedCallback cb,
+                        bool arrow,
+                        base::RepeatingCallback<bool()> automatic)
+      : Base(std::move(cb)), arrow_(arrow), automatic_(std::move(automatic)) {}
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    if (!automatic_.Run()) {
+      Base::PaintButtonContents(canvas);
+      return;
+    }
+    cc::PaintFlags f;
+    f.setAntiAlias(true);
+    f.setColor(SkColorSetA(SK_ColorWHITE, 35));
+    canvas->DrawRoundRect(gfx::RectF(this->GetLocalBounds()), 5, f);
+    f.setColor(SK_ColorWHITE);
+    f.setStyle(cc::PaintFlags::kStroke_Style);
+    f.setStrokeWidth(1.2f);
+    SkPathBuilder path;
+    if (arrow_) {
+      path.moveTo(10, 18).lineTo(10, 10).lineTo(18, 10);
+      path.moveTo(10, 10).lineTo(18, 18);
+    } else {
+      path.moveTo(10, 10).lineTo(19, 19);
+      path.moveTo(19, 10).lineTo(10, 19);
+    }
+    canvas->DrawPath(path.detach(), f);
+  }
+
+ private:
+  bool arrow_;
+  base::RepeatingCallback<bool()> automatic_;
+};
+class AutomaticProgressView : public global_media_controls::MediaProgressView {
+ public:
+  template <typename... Args>
+  AutomaticProgressView(base::RepeatingCallback<bool()> automatic,
+                        base::RepeatingCallback<double()> progress,
+                        Args&&... args)
+      : MediaProgressView(std::forward<Args>(args)...),
+        automatic_(std::move(automatic)),
+        progress_(std::move(progress)) {}
+  void OnPaint(gfx::Canvas* canvas) override {
+    if (!automatic_.Run()) {
+      MediaProgressView::OnPaint(canvas);
+      return;
+    }
+    cc::PaintFlags f;
+    f.setAntiAlias(true);
+    f.setColor(SkColorSetA(SK_ColorWHITE, 90));
+    canvas->DrawRoundRect(gfx::RectF(8, 10, width() - 16, 4), 2, f);
+    f.setColor(SK_ColorWHITE);
+    canvas->DrawRoundRect(
+        gfx::RectF(8, 10, (width() - 16) * std::clamp(progress_.Run(), 0.0, 1.0), 4),
+        2, f);
+  }
+
+ private:
+  base::RepeatingCallback<bool()> automatic_;
+  base::RepeatingCallback<double()> progress_;
+};
+class AutomaticPlaybackButton : public PlaybackImageButton {
+ public:
+  AutomaticPlaybackButton(
+      views::Button::PressedCallback cb,
+      base::RepeatingCallback<bool()> automatic,
+      base::RepeatingCallback<VideoOverlayWindowViews::PlaybackState()> state)
+      : PlaybackImageButton(std::move(cb)),
+        automatic_(std::move(automatic)),
+        state_(std::move(state)) {}
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    if (!automatic_.Run())
+      PlaybackImageButton::OnPaintBackground(canvas);
+  }
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    if (!automatic_.Run()) {
+      PlaybackImageButton::PaintButtonContents(canvas);
+      return;
+    }
+    cc::PaintFlags f;
+    f.setAntiAlias(true);
+    f.setColor(SK_ColorWHITE);
+    if (state_.Run() == VideoOverlayWindowViews::kPlaying) {
+      canvas->DrawRoundRect(gfx::RectF(12, 2, 6, 44), 3, f);
+      canvas->DrawRoundRect(gfx::RectF(30, 2, 6, 44), 3, f);
+    } else {
+      SkPathBuilder path;
+      path.moveTo(12, 2).lineTo(42, 24).lineTo(12, 46).close();
+      canvas->DrawPath(path.detach(), f);
+    }
+  }
+
+ private:
+  base::RepeatingCallback<bool()> automatic_;
+  base::RepeatingCallback<VideoOverlayWindowViews::PlaybackState()> state_;
+};
