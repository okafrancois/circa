# The approved historical SDK remains the default. A different controlled
# source identity requires both explicit pins from its paired export manifest.
set(CEF_SOURCE_COMMIT "4fa4ab516dacf6c49fc7e6e70d2b7ebce29fa35f"
  CACHE STRING "Expected CEF source commit in cef_version.h")
set(CEF_VERSION_HEADER_SHA256 ""
  CACHE STRING "Expected SHA-256 of the complete exported cef_version.h")
string(LENGTH "${CEF_SOURCE_COMMIT}" ORBIT_CEF_COMMIT_LENGTH)
if(NOT ORBIT_CEF_COMMIT_LENGTH EQUAL 40 OR NOT CEF_SOURCE_COMMIT MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "CEF_SOURCE_COMMIT must be a 40-digit lowercase Git commit")
endif()
if(NOT CEF_VERSION_HEADER_SHA256 STREQUAL "")
  string(LENGTH "${CEF_VERSION_HEADER_SHA256}" ORBIT_CEF_HEADER_HASH_LENGTH)
  if(NOT ORBIT_CEF_HEADER_HASH_LENGTH EQUAL 64 OR
      NOT CEF_VERSION_HEADER_SHA256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "CEF_VERSION_HEADER_SHA256 must be a 64-digit lowercase SHA-256")
  endif()
elseif(NOT CEF_SOURCE_COMMIT STREQUAL "4fa4ab516dacf6c49fc7e6e70d2b7ebce29fa35f")
  message(FATAL_ERROR "A different CEF source commit requires CEF_VERSION_HEADER_SHA256")
endif()

set(ORBIT_CEF_VERSION_HEADER "${CEF_ROOT}/include/cef_version.h")
if(NOT CEF_VERSION_HEADER_SHA256 STREQUAL "")
  file(SHA256 "${ORBIT_CEF_VERSION_HEADER}" ORBIT_CEF_VERSION_HEADER_HASH)
  if(NOT ORBIT_CEF_VERSION_HEADER_HASH STREQUAL CEF_VERSION_HEADER_SHA256)
    message(FATAL_ERROR "Pinned CEF version header hash mismatch")
  endif()
endif()
file(SIZE "${ORBIT_CEF_VERSION_HEADER}" ORBIT_CEF_HEADER_BYTES)
if(ORBIT_CEF_HEADER_BYTES GREATER 65536)
  message(FATAL_ERROR "Unsupported CEF version header size")
endif()
file(READ "${ORBIT_CEF_VERSION_HEADER}" ORBIT_CEF_TEXT HEX)
# The pinned generator emits an ASCII macro header. Do not let file(STRINGS)
# silently discard controls or binary data before directive validation.
if(NOT ORBIT_CEF_TEXT MATCHES "^(09|0a|0d|[2-6][0-9a-f]|7[0-9a-e])*$")
  message(FATAL_ERROR "Unsupported CEF version header characters")
endif()
string(REPLACE "0d0a" "" ORBIT_CEF_WITHOUT_CRLF "${ORBIT_CEF_TEXT}")
if(ORBIT_CEF_WITHOUT_CRLF MATCHES "0d")
  message(FATAL_ERROR "Unsupported CEF version header line ending")
endif()
file(READ "${ORBIT_CEF_VERSION_HEADER}" ORBIT_CEF_TEXT)
# C translation phase 2 precedes comment recognition, including in // comments.
string(REPLACE "\\\r\n" "" ORBIT_CEF_TEXT "${ORBIT_CEF_TEXT}")
string(REPLACE "\\\n" "" ORBIT_CEF_TEXT "${ORBIT_CEF_TEXT}")
string(REPLACE "\r\n" "\n" ORBIT_CEF_TEXT "${ORBIT_CEF_TEXT}")
string(FIND "${ORBIT_CEF_TEXT}" "\r" ORBIT_CEF_BARE_CR)
if(NOT ORBIT_CEF_BARE_CR EQUAL -1)
  message(FATAL_ERROR "Unsupported CEF version header line ending")
endif()

# Preserve literals and line boundaries while removing actual comments. A
# regexp over raw lines would mistake commented directives for live macros.
set(ORBIT_CEF_CLEAN "")
set(ORBIT_CEF_STATE "normal")
set(ORBIT_CEF_AT 0)
string(LENGTH "${ORBIT_CEF_TEXT}" ORBIT_CEF_LENGTH)
while(ORBIT_CEF_AT LESS ORBIT_CEF_LENGTH)
  string(SUBSTRING "${ORBIT_CEF_TEXT}" ${ORBIT_CEF_AT} 1 ORBIT_CEF_CHAR)
  math(EXPR ORBIT_CEF_NEXT "${ORBIT_CEF_AT} + 1")
  set(ORBIT_CEF_PAIR "")
  if(ORBIT_CEF_NEXT LESS ORBIT_CEF_LENGTH)
    string(SUBSTRING "${ORBIT_CEF_TEXT}" ${ORBIT_CEF_AT} 2 ORBIT_CEF_PAIR)
  endif()
  if(ORBIT_CEF_STATE STREQUAL "block")
    if(ORBIT_CEF_PAIR STREQUAL "*/")
      set(ORBIT_CEF_STATE "normal")
      math(EXPR ORBIT_CEF_AT "${ORBIT_CEF_AT} + 1")
    elseif(ORBIT_CEF_CHAR STREQUAL "\n")
      string(APPEND ORBIT_CEF_CLEAN "\n")
    endif()
  elseif(ORBIT_CEF_STATE STREQUAL "line")
    if(ORBIT_CEF_CHAR STREQUAL "\n")
      set(ORBIT_CEF_STATE "normal")
      string(APPEND ORBIT_CEF_CLEAN "\n")
    endif()
  elseif(ORBIT_CEF_STATE STREQUAL "literal")
    if(ORBIT_CEF_CHAR STREQUAL "\n")
      message(FATAL_ERROR "Unterminated CEF version header literal")
    endif()
    string(APPEND ORBIT_CEF_CLEAN "${ORBIT_CEF_CHAR}")
    if(ORBIT_CEF_CHAR STREQUAL "\\")
      if(NOT ORBIT_CEF_NEXT LESS ORBIT_CEF_LENGTH)
        message(FATAL_ERROR "Unterminated CEF version header literal")
      endif()
      string(SUBSTRING "${ORBIT_CEF_TEXT}" ${ORBIT_CEF_NEXT} 1 ORBIT_CEF_ESCAPED)
      string(APPEND ORBIT_CEF_CLEAN "${ORBIT_CEF_ESCAPED}")
      math(EXPR ORBIT_CEF_AT "${ORBIT_CEF_AT} + 1")
    elseif(ORBIT_CEF_CHAR STREQUAL ORBIT_CEF_QUOTE)
      set(ORBIT_CEF_STATE "normal")
    endif()
  elseif(ORBIT_CEF_PAIR STREQUAL "/*" OR ORBIT_CEF_PAIR STREQUAL "//")
    string(APPEND ORBIT_CEF_CLEAN " ")
    if(ORBIT_CEF_PAIR STREQUAL "/*")
      set(ORBIT_CEF_STATE "block")
    else()
      set(ORBIT_CEF_STATE "line")
    endif()
    math(EXPR ORBIT_CEF_AT "${ORBIT_CEF_AT} + 1")
  else()
    string(APPEND ORBIT_CEF_CLEAN "${ORBIT_CEF_CHAR}")
    if(ORBIT_CEF_CHAR STREQUAL "\"" OR ORBIT_CEF_CHAR STREQUAL "'")
      set(ORBIT_CEF_QUOTE "${ORBIT_CEF_CHAR}")
      set(ORBIT_CEF_STATE "literal")
    endif()
  endif()
  math(EXPR ORBIT_CEF_AT "${ORBIT_CEF_AT} + 1")
endwhile()
if(ORBIT_CEF_STATE STREQUAL "block" OR ORBIT_CEF_STATE STREQUAL "literal")
  message(FATAL_ERROR "Unterminated CEF version header comment or literal")
endif()

string(REPLACE ";" "\\;" ORBIT_CEF_LINES "${ORBIT_CEF_CLEAN}")
string(REPLACE "\n" ";" ORBIT_CEF_LINES "${ORBIT_CEF_LINES}")
set(ORBIT_CEF_COMMIT_LINES "")
set(ORBIT_CEF_GUARD "")
set(ORBIT_CEF_GUARD_DEFINED FALSE)
set(ORBIT_CEF_GUARD_CLOSED FALSE)
set(ORBIT_CEF_SEEN_LINE FALSE)
foreach(ORBIT_CEF_LINE IN LISTS ORBIT_CEF_LINES)
  string(STRIP "${ORBIT_CEF_LINE}" ORBIT_CEF_LINE)
  if(ORBIT_CEF_LINE STREQUAL "")
    continue()
  endif()
  if(ORBIT_CEF_GUARD_CLOSED)
    message(FATAL_ERROR "Unexpected content after CEF version header guard")
  endif()
  if(ORBIT_CEF_LINE MATCHES "^#[ \t]*ifndef[ \t]+CEF_INCLUDE_CEF_VERSION_H_[ \t]*$" AND NOT ORBIT_CEF_SEEN_LINE)
    set(ORBIT_CEF_GUARD "CEF_INCLUDE_CEF_VERSION_H_")
  elseif(NOT ORBIT_CEF_GUARD STREQUAL "" AND NOT ORBIT_CEF_GUARD_DEFINED)
    if(NOT ORBIT_CEF_LINE MATCHES "^#[ \t]*define[ \t]+${ORBIT_CEF_GUARD}[ \t]*$")
      message(FATAL_ERROR "Unsupported CEF version header guard")
    endif()
    set(ORBIT_CEF_GUARD_DEFINED TRUE)
  elseif(ORBIT_CEF_LINE MATCHES "^#[ \t]*endif[ \t]*$" AND ORBIT_CEF_GUARD_DEFINED)
    set(ORBIT_CEF_GUARD_CLOSED TRUE)
  elseif(NOT ORBIT_CEF_LINE MATCHES "^#[ \t]*define[ \t]+[A-Za-z_][A-Za-z0-9_]*")
    # Only the ordinary outer include guard is supported. Refuse conditional
    # identity, undef/include and alternate directive forms rather than guessing.
    message(FATAL_ERROR "Unsupported CEF version header directive")
  endif()
  if(ORBIT_CEF_LINE MATCHES "^#[ \t]*define[ \t]+CEF_COMMIT_HASH([^A-Za-z0-9_]|$)")
    list(APPEND ORBIT_CEF_COMMIT_LINES "${ORBIT_CEF_LINE}")
  endif()
  set(ORBIT_CEF_SEEN_LINE TRUE)
endforeach()
if(NOT ORBIT_CEF_GUARD STREQUAL "" AND NOT ORBIT_CEF_GUARD_CLOSED)
  message(FATAL_ERROR "Unterminated CEF version header guard")
endif()
list(LENGTH ORBIT_CEF_COMMIT_LINES ORBIT_CEF_COMMIT_COUNT)
if(NOT ORBIT_CEF_COMMIT_COUNT EQUAL 1)
  message(FATAL_ERROR "Expected exactly one CEF_COMMIT_HASH definition")
endif()
if(NOT ORBIT_CEF_COMMIT_LINES MATCHES
    "^[ \t]*#[ \t]*define[ \t]+CEF_COMMIT_HASH[ \t]+\"${CEF_SOURCE_COMMIT}\"[ \t]*$")
  message(FATAL_ERROR "Pinned CEF source commit mismatch")
endif()
