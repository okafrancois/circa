{
  "manifest_version": 3,
  "name": "Circa Content Blocking",
  "description": "Built-in ad and tracker blocking.",
  "version": "1.2611.1420.43",
  "key": "",
  "minimum_chrome_version": "128",
  "permissions": [
    "declarativeNetRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://content-blocking.circa.invalid/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": false,
        "path": "rulesets/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": false,
        "path": "rulesets/easyprivacy.json"
      }
    ]
  }
}
