<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Product build of Orbit on Chromium. Unsigned build output; scripts/release.py (or scripts/orbit-app.py)
     sets identity and versions, then signs. Web URL and document claims live here so that the
     released app can be chosen as the default web browser. -->
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>io.github.okatech.orbit.test.orbit.unpackaged</string>
  <key>CFBundleExecutable</key><string>@ORBIT_PRODUCT_NAME@</string>
  <key>CFBundleName</key><string>Orbit</string>
  <key>CFBundleDisplayName</key><string>Orbit</string>
  <key>CFBundleIconFile</key><string>Orbit.icns</string>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key><array><string>en</string><string>fr</string></array>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>LSFileQuarantineEnabled</key><true/>
  <key>NSCameraUsageDescription</key><string>Orbit utilise la caméra uniquement pour les sites que vous autorisez.</string>
  <key>NSMicrophoneUsageDescription</key><string>Orbit utilise le microphone uniquement pour les sites que vous autorisez.</string>
  <key>NSLocationUsageDescription</key><string>Orbit partage votre localisation uniquement avec les sites que vous autorisez.</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>Orbit partage votre localisation uniquement avec les sites que vous autorisez.</string>
  <key>NSBluetoothAlwaysUsageDescription</key><string>Orbit utilise le Bluetooth uniquement pour les sites et les appareils que vous autorisez.</string>
  <key>NSBluetoothPeripheralUsageDescription</key><string>Orbit utilise le Bluetooth uniquement pour les sites et les appareils que vous autorisez.</string>
  <key>CFBundleURLTypes</key><array><dict>
    <key>CFBundleURLName</key><string>Web URLs</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>CFBundleURLSchemes</key><array><string>http</string><string>https</string></array>
  </dict></array>
  <key>CFBundleDocumentTypes</key><array><dict>
    <key>CFBundleTypeName</key><string>Web document</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>LSHandlerRank</key><string>Alternate</string>
    <key>CFBundleTypeExtensions</key><array><string>html</string><string>htm</string><string>xhtml</string><string>webloc</string><string>url</string></array>
    <key>LSItemContentTypes</key><array><string>public.html</string><string>public.xhtml</string><string>com.apple.web-internet-location</string><string>com.microsoft.internet-shortcut</string></array>
  </dict></array>
  <key>NSPrincipalClass</key><string>ACRApplication</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key><true/>
  <key>NSSupportsAutomaticTermination</key><false/>
  <key>NSSupportsSuddenTermination</key><false/>
  <key>SUFeedURL</key><string>https://github.com/@ORBIT_RELEASE_REPOSITORY@/releases/latest/download/appcast.xml</string>
  <key>SUPublicEDKey</key><string>@SPARKLE_PUBLIC_ED_KEY@</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUAutomaticallyUpdate</key><true/>
  <key>SUScheduledCheckInterval</key><integer>3600</integer>
  <key>OrbitEngine</key><string>chromium</string>
</dict></plist>
